@using System.Security.Claims

@{
    var name = User?.Identity?.Name ?? "Usuario";
    // si tienes un claim de nombre completo, úsalo:
    var displayName = User.FindFirstValue("Nombre") ?? name;
    var initials = "TP";
    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var parts = displayName.Trim().Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        initials = parts.Length == 1
            ? parts[0].Substring(0, System.Math.Min(2, parts[0].Length)).ToUpper()
            : (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
}

<div class="tp-user">
    <div class="tp-avatar">@initials</div>

    <div class="tp-user-meta">
        <div class="tp-user-name">@displayName</div>
        <div class="tp-user-role">Tienda</div>
    </div>

    @* Logout NATIVO Identity *@
    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <form class="tp-logout"
              asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="/Identity/Account/Login"
              method="post">
            <button type="submit" class="tp-logout-btn" title="Cerrar sesión">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M10 17l5-5-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <path d="M15 12H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <path d="M21 3v18" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".6" />
                </svg>
            </button>
        </form>
    }
</div>
