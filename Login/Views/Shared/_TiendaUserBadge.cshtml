@using System.Security.Claims
@{
    var raw = User?.Identity?.Name ?? "Usuario";
    var displayName = User?.FindFirstValue("Nombre") ?? raw;
    var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length == 1
        ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper()
        : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
}
<div class="tp-ubadge">
    <div class="tp-avatar">@initials</div>
    <div class="tp-ubadge-info">
        <div class="tp-ubadge-name">@displayName</div>
        <div class="tp-ubadge-role">Tienda</div>
    </div>
</div>
