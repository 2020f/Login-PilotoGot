@{
    var title = ViewData["Title"] as string ?? "Envirapido - SuperAdmin";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>

    <link rel="stylesheet" href="~/css/superadmin.css" asp-append-version="true" />
    <partial name="_BrandHead" />
    @RenderSection("Styles", required: false)
</head>
<body class="sa-body">
    <a class="sa-skip" href="#saContent">Saltar al contenido</a><div class="sa-shell">

        <aside class="sa-sidebar" id="saSidebar" aria-label="Navegación de SuperAdmin">
            <button class="sa-menu-close" id="saMenuClose" type="button" aria-label="Cerrar menú">
                <span aria-hidden="true">×</span> Cerrar menú
            </button>
            <partial name="_SuperAdminSidebar" />

            <div class="sa-sidebar-footer" style="display:flex; align-items:center; justify-content:space-between; gap:10px;">
                <partial name="_SuperAdminUserBadge" />

                @* ✅ Cerrar sesión (Identity Logout por POST) *@
                @if (User?.Identity?.IsAuthenticated ?? false)
                {
                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/Identity/Account/Login"
                          method="post"
                          style="margin:0;">
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="sa-btn"
                                title="Cerrar sesión" aria-label="Cerrar sesión"
                                style="width:38px; height:38px; padding:0; display:grid; place-items:center; border-radius:12px;">
                            ↩
                        </button>
                    </form>
                }
            </div>
        </aside>

        <button class="sa-menu-backdrop" id="saMenuBackdrop" type="button" aria-label="Cerrar menú" tabindex="-1" hidden></button>

        <main class="sa-main" id="saMain">
            <header class="sa-topbar">
                <button class="sa-menu-toggle" id="saMenuToggle" type="button" aria-label="Abrir menú" aria-controls="saSidebar" aria-expanded="false">
                    <span aria-hidden="true">☰</span> Menú
                </button>
                <partial name="_SuperAdminTopbar" />
            </header>

            <section class="sa-content" id="saContent" tabindex="-1">
                @RenderBody()
            </section>
        </main>

    </div>

    <script src="~/js/superadmin.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
