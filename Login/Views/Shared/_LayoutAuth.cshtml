<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Envirapido</title>

    <!-- Bootstrap Icons (para los íconos del login) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS Auth -->
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <partial name="_BrandHead" />
</head>
<body>
    @if (ViewData["AuthBrandHeader"] is not false)
    {
        <header class="envi-page-brand"><a href="~/Identity/Account/Login" aria-label="Envirapido, iniciar sesión"><img class="envi-brand-logo" src="~/branding/logo-original.png" asp-append-version="true" alt="Envirapido" width="190" height="65" /></a></header>
    }
    @RenderBody()
    @RenderSection("Scripts", required: false)
</body>
</html>
