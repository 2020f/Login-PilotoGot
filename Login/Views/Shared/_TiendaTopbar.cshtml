<div class="tp-topbar-row">
    <div class="tp-topbar-title">
        @ViewData["PageTitle"]
    </div>

    <div class="tp-topbar-actions">
        <a class="tp-pill" href="#" title="Ayuda">
            <span class="tp-pill-ico">?</span>
            <span>Ayuda</span>
        </a>

        <button class="tp-icon-btn" type="button" title="Notificaciones">
            <span class="tp-dot"></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M18 8a6 6 0 10-12 0c0 7-3 7-3 7h18s-3 0-3-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                <path d="M13.7 21a2 2 0 01-3.4 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
        </button>
    </div>
</div>
