@{
    Layout = "_LayoutEnvirapido";
    ViewData["EnvirapidoLegacy"] = true;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    ViewData["Seccion"] = action.Contains("Tienda") ? "Comercios" : action.Contains("Piloto") ? "Repartidores" : action.Contains("Usuario") ? "Usuarios y permisos" : action.Contains("Estadistica") ? "Reportes" : action.Contains("Mapa") || action.Contains("Precio") ? "Configuración" : "Operaciones";
}
<div class="ev-admin-native">@RenderBody()</div>
@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}
@section Scripts {
    <script src="~/js/gestor.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
