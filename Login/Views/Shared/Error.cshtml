@model ErrorViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "No se pudo completar la solicitud";
    var home = User.IsInRole("SuperAdmin") ? "/SuperAdmin/Dashboard"
        : User.IsInRole("Gestor") ? "/Operaciones"
        : User.IsInRole("Cliente") ? "/Tienda/Ordenes"
        : User.IsInRole("Piloto") ? "/Piloto/Index" : "/Identity/Account/Login";
}
<main style="min-height:100dvh;display:grid;place-items:center;padding:24px">
    <section style="width:100%;max-width:560px;padding:36px;border-radius:22px;background:#fff;color:#14252b;box-shadow:0 18px 55px #0002" aria-labelledby="errorTitle">
        <p style="color:#007e80;font-weight:800">Envirapido</p>
        <h1 id="errorTitle" style="font-size:28px">No se pudo completar la solicitud</h1>
        <p style="line-height:1.6;color:#526874">Vuelve a tu panel e inténtalo de nuevo. Si el problema continúa, comparte esta referencia con el administrador.</p>
        @if (Model.ShowRequestId)
        {
            <p style="overflow-wrap:anywhere;font-size:13px;color:#60747e">Referencia: <code>@Model.RequestId</code></p>
        }
        <a href="@home" style="display:inline-block;margin-top:16px;padding:12px 18px;border-radius:10px;background:#007e80;color:#fff;text-decoration:none;font-weight:700">Volver a mi panel</a>
    </section>
</main>
