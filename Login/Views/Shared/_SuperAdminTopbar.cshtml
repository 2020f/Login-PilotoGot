<div class="sa-topbar-row">
    <div class="sa-page-title">
        <h1>@(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Panel")</h1>
    </div>

    <div class="sa-topbar-actions">
        <div class="sa-search">
            <span class="sa-search-ico">🔎</span>
            <input id="saGlobalSearch" type="text" placeholder="Buscar cliente, orden o ID..." />
        </div>

        <button class="sa-icon-btn" type="button" title="Notificaciones">
            🔔 <span class="sa-dot"></span>
        </button>

        <button class="sa-icon-btn" type="button" title="Configuración">
            ⚙️
        </button>
    </div>
</div>
