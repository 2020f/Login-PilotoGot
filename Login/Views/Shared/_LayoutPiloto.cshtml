<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - Envirapido</title>
    <link rel="stylesheet" href="~/css/piloto.css" asp-append-version="true" />
    <partial name="_BrandHead" />
    @RenderSection("Styles", required: false)
</head>
<body class="pg-body">

    <div class="pg-app">

        <header class="pg-topbar">
            <div class="pg-top-left envi-brand">
                <div class="envi-piloto-lockup">
                    <img class="envi-brand-logo" src="~/branding/logo-original.png" asp-append-version="true" alt="Envirapido" width="142" height="49" />
                    <div class="pg-subtitle">Repartidor</div>
                </div>
            </div>

            <div class="pg-top-right">
                <span class="pg-online"><span class="pg-online-dot"></span>En línea</span>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="pg-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pg-logout" title="Cerrar sesión" aria-label="Cerrar sesión">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </header>

        <main class="pg-main">
            @RenderBody()
        </main>

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
