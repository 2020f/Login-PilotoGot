<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@ViewData["Title"] - PilotGo</title>
    <link rel="stylesheet" href="~/css/piloto.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="pg-body">

    <div class="pg-app">

        <header class="pg-topbar">
            <div class="pg-top-left">
                <div class="pg-logo">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13" rx="2"/>
                        <path d="M16 8h4l3 5v3h-7V8z"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <div>
                    <div class="pg-title">PilotGo</div>
                    <div class="pg-subtitle">Repartidor</div>
                </div>
            </div>

            <div class="pg-top-right">
                <span class="pg-online"><span class="pg-online-dot"></span>En línea</span>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="pg-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pg-logout" title="Cerrar sesión" aria-label="Cerrar sesión">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                    </button>
                </form>
            </div>
        </header>

        <main class="pg-main">
            @RenderBody()
        </main>

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
