@{
    var action = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLowerInvariant();
    string Active(params string[] actions) => actions.Any(a => a.Equals(action, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
