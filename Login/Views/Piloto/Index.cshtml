@model Login.ViewModels.Piloto.MisOrdenesIndexVm
@{
    ViewData["Title"] = "Piloto - Mi Orden";
}

<h2>Mi Orden</h2>

@if (!string.IsNullOrWhiteSpace(Model.Ok))
{
    <div class="alert alert-success">@Model.Ok</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (Model.Ordenes.Count == 0)
{
    <div class="alert alert-info">
        No tienes órdenes asignadas ahora mismo.
    </div>
}
else
{
    var o = Model.Ordenes[0];

    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h5 class="mb-1">Orden A: <span class="badge bg-dark">@o.NumeroOrdenA</span></h5>
                    <div class="text-muted">Estado: <b>@o.Estado</b></div>
                </div>
                <div class="text-muted">@o.CreatedAt.ToLocalTime().ToString("g")</div>
            </div>

            <hr />

            @if (!o.PuedeVerDestinoFinal)
            {
                <div class="text-muted fw-bold mb-2">🔎 Buscando paquetes…</div>

                <div class="mb-2">
                    <div class="fw-bold">🏪 Ir a la tienda (Pickup)</div>
                    <div><b>@o.TiendaNombre</b> (@o.TiendaTelefono)</div>
                    <div>@o.TiendaDireccion</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(o.NotaPedido))
                {
                    <div class="mb-3">
                        <div class="fw-bold">📝 Nota del pedido</div>
                        <div>@o.NotaPedido</div>
                    </div>
                }

                <form method="post" asp-action="ConfirmarRecolecta" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input class="form-control" name="CodigoB"
                           placeholder="Escanea / pega Código B (QR de tienda)"
                           required />
                    <button class="btn btn-warning">Llegué a la tienda</button>
                </form>
            }
            else
            {
                <div class="fw-bold mb-2">📍 Destino final (Delivery)</div>
                <div><b>@o.UsuarioFinalNombre</b> (@o.UsuarioFinalTelefono)</div>
                <div class="mb-3">@o.UsuarioFinalDireccion</div>

                <div class="alert alert-secondary">
                    Para cerrar entrega: escribe el <b>Código C</b> y vuelve a escanear/pegar el <b>Código B</b>.
                </div>

                <form method="post" asp-action="ConfirmarEntrega" class="d-flex gap-2 flex-wrap">
                    @Html.AntiForgeryToken()

                    <input class="form-control" name="CodigoB"
                           placeholder="Escanea / pega Código B (QR)"
                           required />

                    <input class="form-control" name="CodigoC"
                           placeholder="Código C (cliente final)"
                           required />

                    <button class="btn btn-success">Cerrar entrega</button>
                </form>
            }
        </div>
    </div>
}
