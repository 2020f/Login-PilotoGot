@model Login.ViewModels.Piloto.MisOrdenesIndexVm
@{
    Layout = "_LayoutPiloto";
    ViewData["Title"] = "Mis órdenes";
}

@if (!string.IsNullOrWhiteSpace(Model.Ok))
{
    <div class="pg-toast pg-toast-ok">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        <span>@Model.Ok</span>
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="pg-toast pg-toast-err">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>@Model.Error</span>
    </div>
}

<div class="pg-head">
    <div class="pg-head-title">Mis órdenes</div>
    <div class="pg-head-sub">@Model.Ordenes.Count orden(es) activa(s)</div>
</div>

@if (Model.Ordenes.Count == 0)
{
    <div class="pg-empty">
        <div class="pg-empty-ico">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="2"/>
                <path d="M16 8h4l3 5v3h-7V8z"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
        </div>
        <div class="pg-empty-title">Sin órdenes asignadas</div>
        <div class="pg-empty-sub">Cuando un gestor te asigne una entrega, aparecerá aquí.</div>
    </div>
}
else
{
    foreach (var o in Model.Ordenes)
    {
        var enRuta = o.PuedeVerDestinoFinal;

        <a class="pg-ocard" asp-action="Detalle" asp-route-id="@o.OrdenId">
            <div class="pg-ocard-icon @(enRuta ? "is-route" : "")">
                @if (enRuta)
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                        <circle cx="12" cy="10" r="3"/>
                    </svg>
                }
                else
                {
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                }
            </div>

            <div class="pg-ocard-body">
                <div class="pg-ocard-top">
                    <span class="pg-ocard-id">#@o.NumeroOrdenA</span>
                    <span class="pg-pill @(enRuta ? "pg-pill-route" : "pg-pill-pick")">
                        @(enRuta ? "En ruta" : "Recolectando")
                    </span>
                </div>
                <div class="pg-ocard-title">
                    @(enRuta ? o.UsuarioFinalNombre : o.TiendaNombre)
                </div>
                <div class="pg-ocard-sub">
                    @(enRuta ? "Entregar a destino" : "Recoger en tienda")
                </div>
            </div>

            <div class="pg-ocard-chev">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </div>
        </a>
    }
}
