@model Login.ViewModels.Envirapido.PanelVm
<dialog class="ev-dialog" id="evAssignDialog"><form asp-controller="Envirapido" asp-action="Asignar" method="post" data-ev-assign-form>
    <div class="ev-dialog-head"><h2>Asignar repartidor</h2><button class="ev-icon-button" type="button" data-ev-close-dialog aria-label="Cerrar">✕</button></div>
    <div class="ev-dialog-body"><p data-ev-assign-label></p><input type="hidden" name="ordenId" /><input type="hidden" name="volver" value="@(Context.Request.Path.ToString()+Context.Request.QueryString.ToString())" />
        <div class="ev-field"><label for="evPilot">Repartidor</label><select id="evPilot" name="pilotoId" required><option value="">Seleccionar repartidor</option>
            @foreach (var p in Model.Flota.Where(p => p.Activo)) { <option value="@p.Id">@p.Nombre · @p.Estado · @p.Carga órdenes</option> }
        </select><small>Se comprobarán disponibilidad y pertenencia antes de confirmar.</small></div><div class="ev-alert neutral" data-ev-bulk-notice hidden>La asignación se valida por cada pedido seleccionado.</div><div data-ev-assign-errors role="alert"></div>
    </div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Asignar repartidor</button></div>
</form></dialog>
<dialog class="ev-dialog" id="evCancelDialog"><form data-ev-cancel-form><div class="ev-dialog-head"><h2>Cancelar pedido antes de la recogida</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="ordenId" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Motivo de cancelación</label><textarea name="motivo" maxlength="500" required></textarea></div><p class="ev-hint">Se revalida la etapa del pedido. Una orden recogida requiere gestionar reintento o devolución con el piloto custodio.</p><div data-ev-cancel-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Volver</button><button class="ev-btn danger" type="submit">Confirmar cancelación</button></div></form></dialog>
