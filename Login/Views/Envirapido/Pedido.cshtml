@model Login.ViewModels.Envirapido.PanelVm
@using Login.Application.Interfaces
@using Login.ViewModels.Envirapido
@using System.Text.Json
@inject IGoogleMapsService GoogleMaps
@{
    Layout="_LayoutEnvirapido";
    var p=Model.Pedido!;
    var parada=p.Paradas.FirstOrDefault(s=>s.Id==Model.ParadaId)??p.Paradas.FirstOrDefault();
    var piloto=Model.Flota.FirstOrDefault(x=>x.Id==p.PilotoId);
    var dato=p.Datos;
    var estimacion=Model.Seguimiento;
    var llegada=estimacion?.CalculadoAt.AddMinutes(estimacion.Minutos);
    var zona=Model.Datos?.Zonas.FirstOrDefault(z=>z.Id==dato?.ZonaId);
    ViewData["Title"]="Pedido EV-"+p.Codigo;
    var steps=new[]{("Creado",(DateTime?)p.CreadoUtc),("Asignado",p.AsignadoUtc),("Recogido",p.RecogidoUtc),("En ruta",(DateTime?)null),("Entregado",p.EntregadoUtc)};
    var pointMap=new Dictionary<string,object?>{["pickup"]=new{lat=p.RecogidaLatitud,lng=p.RecogidaLongitud,nombre=p.Comercio}};
    foreach(var stop in p.Paradas)pointMap["destino"+stop.Id]=new{lat=stop.Latitud,lng=stop.Longitud,nombre="Parada "+stop.Posicion+" · "+stop.Nombre};
    if(p.Paradas.Count==0)pointMap["destino"]=new{lat=p.DestinoLatitud,lng=p.DestinoLongitud,nombre=p.Destinatario};
}
<div class="ev-actions" style="margin-bottom:14px">@if(!p.EsTerminal){<a class="ev-btn primary" href="/Operaciones/Reasignaciones?ordenId=@p.Id&paradaId=@parada?.Id&accion=reasignar">Cambiar piloto de esta parada</a><a class="ev-btn" href="/Operaciones/Reasignaciones?ordenId=@p.Id&paradaId=@parada?.Id&accion=retiros">Retirar del piloto</a>}<a class="ev-btn" href="/Operaciones/Reasignaciones?ordenId=@p.Id">Gestionar todas las paradas y retornos</a></div>
<div class="ev-page-heading ev-detail-header">
    <div><h1><a href="/Operaciones/Pedidos" aria-label="Volver a pedidos">‹</a> Pedido EV-@p.Codigo <span class="ev-badge @p.ClaseEstado">@p.EtiquetaEstado</span>@if(p.Demorada){<span class="ev-badge red">Demorada</span>}</h1>
        <div class="ev-detail-sub"><span>@p.Comercio</span><span>@(zona?.Nombre??"Sin zona asignada")</span><span>Creado @p.CreadoUtc.AddHours(-4).ToString("dd MMM yyyy, HH:mm")</span>@if(dato!=null){<span>Prioridad @(dato.Prioridad==4?"crítica":dato.Prioridad==3?"alta":dato.Prioridad==2?"media":"baja")</span>}</div>
    </div>
    <div class="ev-actions">
        @if(!string.IsNullOrWhiteSpace(p.PilotoTelefono)){<a class="ev-btn" href="tel:@p.PilotoTelefono">Contactar repartidor</a>}
        <a class="ev-btn" href="/Operaciones/Incidencias?ordenId=@p.Id&paradaId=@parada?.Id"><svg class="ev-icon"><use href="#ev-alert"></use></svg>Reportar incidencia</a>
        <details class="ev-details-menu"><summary class="ev-btn" aria-label="Más acciones">···</summary><div><a href="/Operaciones/Exportar?ids=@p.Id">Exportar pedido</a><button type="button" data-ev-order-data="@p.Id">Editar datos del envío</button>@if(p.PuedeAsignar){<button type="button" data-ev-assign="@p.Id" data-order-label="EV-@p.Codigo">Asignar repartidor</button>}@if(p.PuedeCancelar){<button type="button" data-ev-cancel="@p.Id">Cancelar pedido</button>}<a href="/Operaciones/Devoluciones">Reintentos y devoluciones</a></div></details>
    </div>
</div>
<nav class="ev-tabs" aria-label="Detalle de pedido">@foreach(var tab in new[]{"Resumen","Seguimiento","Historial","Evidencias","Costos"}){<a class="@(Model.Tab==tab?"active":"")" href="/Operaciones/Pedido/@p.Id?tab=@tab&paradaId=@parada?.Id">@tab</a>}</nav>
@if(p.Estado is "Devuelta" or "FinalizadaConDevoluciones" or "Cancelada"){<div class="ev-alert neutral">@(p.Estado=="Cancelada"?"Entrega cancelada. La custodia y los retornos pendientes se conservan hasta registrar su recepción.":"Orden cerrada con devoluciones. Cada parada conserva su resultado; un retorno no se muestra como entrega al destinatario.")</div>}
@if(p.Paradas.Count>1){<section class="ev-card" style="margin-bottom:14px"><div class="ev-card-head"><h2>Destinatarios y escalas <span class="ev-count">@p.Paradas.Count</span></h2><span class="ev-hint">Una orden · C individual por parada</span></div><div class="ev-card-body ev-stop-selector">@foreach(var stop in p.Paradas){<a class="ev-stop-link @(parada?.Id==stop.Id?"active":"")" href="/Operaciones/Pedido/@p.Id?tab=@Model.Tab&paradaId=@stop.Id"><div><strong>Parada @stop.Posicion · @stop.Nombre</strong><small>@stop.Direccion</small></div><span class="ev-badge @(stop.Estado=="Entregada"?"green":stop.Estado is "Devuelta" or "EnRetorno"?"blue":"gray")">@(stop.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>stop.Estado})</span></a>}</div></section>}
<div class="ev-detail-grid"><div class="ev-stack">
@if(Model.Tab is "Resumen" or "Seguimiento")
{
    <section class="ev-card"><div class="ev-card-head"><h2>Estado de la orden</h2></div><div class="ev-timeline">@for(var i=0;i<steps.Length;i++){var step=steps[i];var active=i==3&&p.Estado=="Recolectada";<div class="ev-step @(step.Item2.HasValue?"done":active?"active":"")"><i>@(step.Item2.HasValue?"✓":(i+1).ToString())</i><strong>@step.Item1</strong><small>@(step.Item2?.AddHours(-4).ToString("HH:mm")??(active?"En curso":"Pendiente"))</small></div>}</div></section>
    <section class="ev-card"><div class="ev-card-head"><h2>Seguimiento en tiempo real</h2><span data-ev-gps-badge class="ev-badge @(piloto?.GpsVigente==true?"green":"amber")">@(piloto?.GpsVigente==true?"GPS actualizado":"GPS sin actualizar")</span></div><div class="ev-tracking-kpis" data-ev-order-tracking="@p.Id" data-parada-id="@parada?.Id"><div><small>Llegada estimada a esta entrega</small><strong data-ev-tracking-eta>@(p.EsTerminal?"Finalizado":llegada?.AddHours(-4).ToString("HH:mm")??"Sin estimación")</strong></div><div><small>Tiempo restante</small><strong data-ev-tracking-minutes>@(!p.EsTerminal&&estimacion!=null?estimacion.Minutos.ToString("N0")+" min":"—")</strong></div><div><small>Distancia restante a esta entrega</small><strong data-ev-tracking-km>@(p.EsTerminal?"—":estimacion?.DistanciaKm.ToString("N1")??"—") <small>km</small></strong></div></div><div class="ev-map" data-ev-map data-map-api-key="@GoogleMaps.BrowserApiKey"><div class="ev-map-content"></div><div class="ev-map-empty"><svg class="ev-icon"><use href="#ev-pin"></use></svg><strong>Cargando mapa del pedido</strong><span>Posiciones registradas y recorrido planificado cuando exista.</span></div><div class="ev-map-legend"><span><i></i>Repartidor</span><span><i class="pickup"></i>Recogida B</span><span><i class="dropoff"></i>Entrega C</span></div></div></section>
    <div class="ev-address-grid"><section class="ev-card"><div class="ev-card-body ev-address"><strong class="ev-eyebrow">RECOGIDA</strong><strong>@p.Comercio</strong><p>@p.RecogidaDireccion</p><p><a href="tel:@p.RecogidaTelefono">@p.RecogidaTelefono</a></p></div></section><section class="ev-card"><div class="ev-card-body ev-address"><strong class="ev-eyebrow">DESTINATARIO @(parada!=null?"· PARADA "+parada.Posicion:"")</strong><strong>@(parada?.Nombre??p.Destinatario)</strong><p>@(parada?.Direccion??p.Direccion)</p><p><a href="tel:@(parada?.Telefono??p.Telefono)">@(parada?.Telefono??p.Telefono)</a></p>@if(parada!=null){<span class="ev-badge @(parada.Estado=="Entregada"?"green":"gray")">@(parada.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>parada.Estado})</span><p>@parada.Instrucciones</p>@if(parada.EntregadaUtc.HasValue){<p>Confirmada con C @parada.EntregadaUtc.Value.AddHours(-4).ToString("dd/MM HH:mm")</p>}}</div></section></div>
}
@if(Model.Tab is "Resumen" or "Historial")
{
    <section class="ev-card"><div class="ev-card-head"><h2>Historial de eventos</h2>@if(Model.Tab=="Resumen"){<a href="/Operaciones/Pedido/@p.Id?tab=Historial&paradaId=@parada?.Id">Ver historial completo ›</a>}</div><ul class="ev-event-list">@foreach(var item in(Model.Tab=="Resumen"?Model.Eventos.Take(5):Model.Eventos)){<li><time datetime="@item.FechaUtc.ToString("O")">@item.FechaUtc.AddHours(-4).ToString("HH:mm")</time><div><strong>@item.Tipo</strong><p>@item.Descripcion</p><small>@item.Actor · @item.FechaUtc.AddHours(-4).ToString("dd MMM yyyy")</small></div></li>}</ul>@if(Model.Eventos.Count==0){<div class="ev-empty">Aún no hay eventos registrados.</div>}</section>
}
@if(Model.Tab=="Evidencias"){<section class="ev-card ev-evidence" aria-disabled="true"><div class="ev-card-head"><h2>Evidencias de entrega</h2><span class="ev-badge">Próximamente</span></div><div class="ev-card-body"><div class="ev-evidence-preview">Foto, firma y comprobante de entrega<br/>Función reservada para una implementación posterior.</div></div></section>}
@if(Model.Tab=="Costos"){<section class="ev-card"><div class="ev-card-head"><h2>Costos del envío</h2><button class="ev-btn small" type="button" data-ev-order-data="@p.Id">Editar datos comerciales</button></div><div class="ev-card-body"><dl class="ev-key-values"><dt>Precio comercial del envío</dt><dd>@(p.Precio.HasValue?"RD$ "+p.Precio.Value.ToString("N2"):"Sin precio registrado")</dd><dt>Distancia calculada del envío</dt><dd>@(p.DistanciaKm?.ToString("N2")??"—") km</dd></dl><p class="ev-hint">El precio del envío y las ganancias del repartidor se consultan por separado. El efectivo cobrado se entrega a la empresa.</p><a class="ev-btn" href="/Operaciones/Liquidaciones">Ver liquidaciones</a></div></section>}
@if(Model.Devoluciones.Count>0){<section class="ev-card"><div class="ev-card-head"><h2>Reintentos y devoluciones</h2></div><div class="ev-card-body">@foreach(var item in Model.Devoluciones){<p><a href="/Operaciones/Devoluciones?id=@item.Id">DV-@item.Id.ToString("D4") · Parada #@item.ParadaId · @(item.Tipo=="Devolucion"?"Devolución":item.Tipo)</a> <span class="ev-badge blue">@(item.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>item.Estado})</span></p>}</div></section>}
</div><aside class="ev-stack">
    <section class="ev-card"><div class="ev-card-head"><h2>Repartidor</h2>@if(p.PilotoId.HasValue){<a href="/Operaciones/Repartidores?buscar=@Uri.EscapeDataString(p.Piloto??"")">Ver perfil ›</a>}</div><div class="ev-card-body"><div class="ev-pilot-profile"><span class="ev-avatar"><svg class="ev-icon"><use href="#ev-user"></use></svg></span><div><strong>@(p.Piloto??"Sin asignar")</strong>@if(p.PilotoId.HasValue){<small>RP-@p.PilotoId.Value.ToString("D4")</small>}</div></div><dl class="ev-key-values"><dt>Estado</dt><dd>@(piloto?.Estado??"Sin asignación")</dd><dt>Último GPS</dt><dd>@(piloto?.GpsUtc?.AddHours(-4).ToString("dd/MM HH:mm:ss")??"Sin ubicación")</dd><dt>Órdenes activas</dt><dd>@(piloto?.Carga.ToString()??"—")</dd><dt>Recepción automática</dt><dd>@(piloto?.EnLinea==true?"Activa":"Pausada")</dd></dl>@if(!string.IsNullOrWhiteSpace(p.PilotoTelefono)){<a class="ev-btn" style="width:100%" href="tel:@p.PilotoTelefono">Contactar repartidor</a>}</div></section>
    <section class="ev-card"><div class="ev-card-head"><h2>Datos del envío</h2><button class="ev-btn ghost small" type="button" data-ev-order-data="@p.Id">Editar</button></div><div class="ev-card-body"><dl class="ev-key-values"><dt>Referencia</dt><dd>@(dato?.Referencia??"EV-"+p.Codigo)</dd><dt>Comercio</dt><dd>@p.Comercio</dd><dt>Paradas C</dt><dd>@p.Paradas.Count</dd><dt>Servicio</dt><dd>@(dato?.Servicio??"Sin registrar")</dd><dt>Paquetes</dt><dd>@(dato?.Paquetes.ToString()??"Sin registrar")</dd><dt>Peso</dt><dd>@(dato?.PesoKg.HasValue==true?dato.PesoKg.Value.ToString("N2")+" kg":"Sin registrar")</dd><dt>Programación</dt><dd>@(dato?.ProgramadaPara?.AddHours(-4).ToString("dd/MM HH:mm")??"Sin programar")</dd><dt>Compromiso</dt><dd>@(dato?.CompromisoEntrega?.AddHours(-4).ToString("dd/MM HH:mm")??"Sin compromiso")</dd></dl></div></section>
    <section class="ev-card ev-evidence" aria-disabled="true"><div class="ev-card-head"><h2>Comprobante de entrega</h2></div><div class="ev-card-body"><span class="ev-badge">Próximamente</span><div class="ev-evidence-preview">Foto de entrega · Firma del destinatario</div></div></section>
    <section class="ev-card"><div class="ev-card-head"><h2>Notas operativas</h2></div><div class="ev-card-body"><p class="ev-note">@(string.IsNullOrWhiteSpace(dato?.NotasOperativas)?string.IsNullOrWhiteSpace(p.Nota)?"Sin notas registradas.":p.Nota:dato.NotasOperativas)</p></div></section>
</aside></div>
@await Html.PartialAsync("_Asignar",Model)
@if(Model.Datos!=null){@await Html.PartialAsync("_ModuleDialogs",new OperationsPageVm{Seccion="Pedidos",Datos=Model.Datos,Operacion=Model})}
<script type="application/json" id="evMapData">@Html.Raw(JsonSerializer.Serialize(Model.Flota.Where(x=>x.Id==p.PilotoId),EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
<script type="application/json" id="evOrderMap">@Html.Raw(JsonSerializer.Serialize(pointMap,EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
<script type="application/json" id="evMapRoutes">@Html.Raw(JsonSerializer.Serialize(Model.Datos?.Rutas.Where(r=>r.OrdenIds.Contains(p.Id)),EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
<script type="application/json" id="evTrackingGeometry">@Html.Raw(JsonSerializer.Serialize(estimacion?.Geometria))</script>
<script type="application/json" id="evOperationsSnapshot">@Html.Raw(JsonSerializer.Serialize(Model.Datos,EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
<script type="application/json" id="evModuleCore">{}</script>
@section Scripts{<script src="~/js/envirapido-modulos.js" asp-append-version="true" defer></script>}

<script type="application/json" id="evTrackingState">@Html.Raw(JsonSerializer.Serialize(new{estado=p.Estado,pilotoId=p.PilotoId,paradas=p.Paradas.OrderBy(x=>x.Id).Select(x=>new{id=x.Id,estado=x.Estado})},EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
