@model Login.ViewModels.Envirapido.CrearEnvioPanelVm
@using System.Text.Json
@{Layout="_LayoutEnvirapido";ViewData["Title"]="Crear envío";}
<div class="ev-page-heading"><div><h1>Crear envío</h1><p>Una orden, uno o varios destinatarios y un mismo repartidor</p></div><a class="ev-btn" href="/Operaciones/Pedidos">Volver a pedidos</a></div>
<section class="ev-card" style="max-width:900px"><div class="ev-card-head"><h2>Datos de recogida y entregas</h2></div><form asp-action="CrearEnvio" method="post" data-ev-create-order><div class="ev-card-body"><div asp-validation-summary="All" class="ev-alert red"></div><input asp-for="OperacionId" type="hidden"/><div class="ev-field"><label asp-for="ComercioId">Comercio de recogida</label><select asp-for="ComercioId" asp-items="Model.Panel.Comercios" required data-ev-create-store><option value="">Seleccionar comercio</option></select><small>La recogida queda congelada al crear. Solo aparecen destinatarios del comercio elegido.</small></div><h3>Destinatarios y paradas C</h3><div data-ev-create-stops>@for(var i=0;i<Model.Destinatarios.Count;i++){<div class="ev-create-stop" data-ev-create-stop><div class="ev-field"><label>Parada @(i+1)</label><select asp-for="Destinatarios[i].UsuarioFinalId" required data-ev-create-person><option value="">Seleccionar destinatario</option>@foreach(var p in Model.Personas.Where(p=>p.ComercioId==Model.ComercioId)){<option value="@p.Id">@p.Nombre · @p.Direccion</option>}</select></div><div class="ev-field"><label>Instrucciones de esta parada</label><textarea asp-for="Destinatarios[i].Instrucciones" maxlength="400" rows="2" data-ev-create-instructions></textarea></div><button class="ev-btn small" type="button" data-ev-create-remove>Quitar parada</button></div>}</div><button class="ev-btn" type="button" data-ev-create-add>+ Añadir destinatario</button><div class="ev-field" style="margin-top:18px"><label asp-for="Nota">Nota del paquete</label><textarea asp-for="Nota" maxlength="400" rows="3"></textarea></div><p class="ev-hint">El servidor genera A y B por orden y un C individual por parada. Reintentar este mismo formulario conserva el identificador de operación.</p></div><div class="ev-dialog-foot"><a class="ev-btn" href="/Operaciones/Pedidos">Cancelar</a><button class="ev-btn primary" type="submit">Crear envío</button></div></form></section>
<script type="application/json" id="evRecipients">@Html.Raw(JsonSerializer.Serialize(Model.Personas,EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
@section Scripts{<script src="~/js/envirapido-crear.js" asp-append-version="true" defer></script>}
