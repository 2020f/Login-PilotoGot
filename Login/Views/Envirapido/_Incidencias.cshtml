@model Login.ViewModels.Envirapido.OperationsPageVm
@{
var d=Model.Datos;var indicators=d.Indicadores;var abiertas=d.Incidencias.Where(i=>i.Estado!="Resuelta").ToList();var hoy=DateTime.UtcNow.AddHours(-4).Date;
var casos=Model.Tab=="Escalaciones"?d.Incidencias.Where(i=>i.Estado=="Escalada"):Model.Tab=="Historial"?d.Incidencias.Where(i=>i.Estado=="Resuelta"):d.Incidencias.AsEnumerable();
var caso=d.Incidencias.FirstOrDefault(i=>i.Id==Model.Id)??casos.OrderByDescending(i=>i.FueraPlazo).ThenByDescending(i=>i.Prioridad).ThenBy(i=>i.VenceAt).FirstOrDefault();
var pedido=Model.Operacion.Pedidos.FirstOrDefault(p=>p.Id==caso?.OrdenId);var ruta=d.Rutas.FirstOrDefault(r=>r.Id==caso?.RutaId);
string Priority(int n)=>n>=4?"Crítica":n==3?"Alta":n==2?"Media":"Baja";
string PClass(int n)=>n>=4?"red":n==3?"amber":n==2?"blue":"gray";
}
<div class="ev-metrics"><article class="ev-metric amber"><svg class="ev-icon"><use href="#ev-alert"></use></svg><div><div class="ev-metric-label">Abiertas</div><strong>@(indicators?.IncidenciasAbiertas.ToString()??"—")</strong><small>Casos sin resolver</small></div></article><article class="ev-metric red"><svg class="ev-icon"><use href="#ev-alert"></use></svg><div><div class="ev-metric-label">Críticas</div><strong>@(indicators?.IncidenciasCriticas.ToString()??"—")</strong><small>Prioridad crítica · abiertas</small></div></article><article class="ev-metric amber"><svg class="ev-icon"><use href="#ev-user"></use></svg><div><div class="ev-metric-label">Sin responsable</div><strong>@(indicators?.IncidenciasSinResponsable.ToString()??"—")</strong><small>Casos abiertos sin asignar</small></div></article><article class="ev-metric red"><svg class="ev-icon"><use href="#ev-clipboard"></use></svg><div><div class="ev-metric-label">Fuera de plazo</div><strong>@(indicators?.IncidenciasFueraPlazo.ToString()??"—")</strong><small>Según SLA configurado</small></div></article><article class="ev-metric"><svg class="ev-icon"><use href="#ev-check"></use></svg><div><div class="ev-metric-label">Resueltas hoy</div><strong>@(indicators?.IncidenciasResueltasHoy.ToString()??"—")</strong><small>Por fecha de resolución · RD</small></div></article></div>
@if(Model.Tab=="Reglas de atención"){@await Html.PartialAsync("_Reglas",Model)}
else
{
<div class="ev-module-split"><section class="ev-card" data-ev-client-table data-default-state="@(Model.Tab=="Historial"?"Resuelta":Model.Tab=="Escalaciones"?"Escalada":"")"><div class="ev-toolbar"><label class="ev-search"><svg class="ev-icon"><use href="#ev-search"></use></svg><input data-ev-table-search placeholder="Buscar incidencia, pedido o ruta" value="@Model.Buscar" aria-label="Buscar incidencias" /></label><select class="ev-select" data-ev-table-filter="priority" aria-label="Prioridad"><option value="">Todas las prioridades</option><option value="4">Crítica</option><option value="3">Alta</option><option value="2">Media</option><option value="1">Baja</option></select><select class="ev-select" data-ev-table-filter="category" aria-label="Categoría"><option value="">Todas las categorías</option>@foreach(var category in d.Incidencias.Select(i=>i.Categoria).Distinct().OrderBy(x=>x)){<option value="@category">@category</option>}</select><select class="ev-select" data-ev-table-filter="zone" aria-label="Zona"><option value="">Todas las zonas</option><option value="none">Sin zona</option>@foreach(var zone in d.Zonas){<option value="@zone.Id">@zone.Nombre</option>}</select><select class="ev-select" data-ev-table-filter="owner" aria-label="Responsable"><option value="">Todos los responsables</option><option value="none">Sin responsable</option>@foreach(var p in d.Responsables){<option value="@p.Id">@p.Nombre</option>}</select></div>
<div class="ev-toolbar"><div class="ev-chips">@foreach(var state in new[]{("","Todas abiertas"),("Nueva","Nuevas"),("EnAtencion","En atención"),("Escalada","Escaladas"),("Resuelta","Resueltas")}){<button type="button" class="ev-chip @(state.Item1==(Model.Tab=="Historial"?"Resuelta":Model.Tab=="Escalaciones"?"Escalada":"")?"active":"")" data-ev-state-filter="@state.Item1">@state.Item2 <span class="ev-count">@(state.Item1==""?indicators?.IncidenciasAbiertas.ToString()??"—":indicators?.IncidenciasPorEstado.GetValueOrDefault(state.Item1).ToString()??"—")</span></button>}</div><span class="ev-hint">Más urgentes primero</span></div>
@if(abiertas.Any(i=>i.FueraPlazo)){<div class="ev-alert" style="margin:10px">@abiertas.Count(i=>i.FueraPlazo) incidencias requieren atención por vencimiento.<button class="ev-btn small" type="button" data-ev-overdue-filter>Ver urgentes</button></div>}
<div class="ev-table-scroll"><table class="ev-table ev-incidents-table"><thead><tr><th data-sort>Incidencia ↕</th><th>Pedido / ruta</th><th data-sort="number">Prioridad ↕</th><th>Responsable</th><th>Estado</th><th data-sort="date">Plazo ↕</th><th>Acción</th></tr></thead><tbody>@foreach(var i in casos.OrderByDescending(i=>i.FueraPlazo).ThenByDescending(i=>i.Prioridad).ThenBy(i=>i.VenceAt)){
var zoneId=d.DatosEnvios.FirstOrDefault(x=>x.OrdenId==i.OrdenId)?.ZonaId??d.Rutas.FirstOrDefault(x=>x.Id==i.RutaId)?.ZonaId;var zoneName=d.Zonas.FirstOrDefault(x=>x.Id==zoneId)?.Nombre;
<tr data-resource-id="@i.Id" data-resource-kind="incidencia" data-category="@i.Categoria" data-zone="@(zoneId?.ToString()??"none")" class="@(caso?.Id==i.Id?"selected":"")" data-state="@i.Estado" data-priority="@i.Prioridad" data-owner="@(i.ResponsableId??"none")" data-overdue="@(i.FueraPlazo?"true":"false")"><td><strong>@i.Codigo</strong><span class="ev-secondary" title="@i.Descripcion">@i.Categoria · @i.Descripcion</span></td><td>@(i.OrdenId.HasValue?"Pedido #"+i.OrdenId:i.RutaId.HasValue?"Ruta #"+i.RutaId:"General")@if(i.ParadaId.HasValue){<span class="ev-secondary">Parada #@i.ParadaId</span>}<span class="ev-secondary">@(zoneName??"Sin zona")</span></td><td data-sort-value="@i.Prioridad"><span class="ev-badge @PClass(i.Prioridad)">@Priority(i.Prioridad)</span></td><td>@(i.Responsable??"Sin asignar")</td><td><span class="ev-badge @(i.Estado=="Resuelta"?"green":i.Estado=="Escalada"?"red":i.Estado=="EnAtencion"?"blue":"gray")">@(i.Estado=="EnAtencion"?"En atención":i.Estado)</span></td><td data-sort-value="@i.VenceAt?.ToString("O")"><span class="@(i.FueraPlazo?"ev-text-red":"")">@(i.VenceAt?.AddHours(-4).ToString("dd/MM HH:mm")??"Sin plazo")</span></td><td><a href="/Operaciones/Incidencias?id=@i.Id&tab=@Uri.EscapeDataString(Model.Tab)&desde=@Model.Desde?.ToString("yyyy-MM-dd")&hasta=@Model.Hasta?.ToString("yyyy-MM-dd")">Ver ···</a></td></tr>
}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div><div class="ev-updated">Casos de esta empresa · categorías pueden solaparse</div></section>
<aside class="ev-card ev-case-detail">@if(caso!=null){<div class="ev-card-head"><h2>@caso.Codigo</h2><span class="ev-badge @PClass(caso.Prioridad)">@Priority(caso.Prioridad)</span></div><div class="ev-card-body"><h3>@caso.Categoria</h3><p class="ev-note" style="margin:8px 0">@caso.Descripcion</p><div class="ev-actions"><span class="ev-badge @(caso.Estado=="Resuelta"?"green":"blue")">@(caso.Estado=="EnAtencion"?"En atención":caso.Estado)</span><span class="ev-badge @(caso.FueraPlazo?"red":"gray")">@(caso.FueraPlazo?"Fuera de plazo":caso.VenceAt.HasValue?"Dentro de plazo":"Sin SLA configurado")</span></div><dl class="ev-key-values"><dt>Pedido</dt><dd>@(caso.OrdenId?.ToString()??"—")</dd><dt>Ruta</dt><dd>@(ruta?.Codigo??caso.RutaId?.ToString()??"—")</dd><dt>Comercio</dt><dd>@(pedido?.Comercio??"—")</dd><dt>Repartidor</dt><dd>@(pedido?.Piloto??ruta?.Piloto??"Sin asignar")</dd><dt>Efecto operativo</dt><dd>@(caso.Efecto switch {"Continuar"=>"Permitir continuar","PausarParada"=>"Pausar la parada afectada","PausarRuta"=>"Pausar la ruta afectada",_=>caso.Efecto})</dd><dt>Responsable</dt><dd>@(caso.Responsable??"Sin asignar") <button class="ev-link-button" type="button" data-ev-incident-action="Asignar" data-id="@caso.Id">Cambiar</button></dd><dt>Plazo de resolución</dt><dd>@(caso.VenceAt?.AddHours(-4).ToString("dd/MM HH:mm")??"Sin plazo configurado")</dd></dl><div class="ev-case-note"><strong>Última nota</strong><p>@(caso.Actividad.FirstOrDefault()?.Texto??"Sin notas registradas.")</p></div><h3>Actividad reciente</h3><ul class="ev-event-list">@foreach(var a in caso.Actividad.OrderByDescending(a=>a.CreatedAt).Take(8)){<li><time>@a.CreatedAt.AddHours(-4).ToString("HH:mm")</time><div><strong>@a.Accion · @a.Actor</strong><p>@a.Texto</p></div></li>}</ul><div class="ev-actions ev-case-actions">@if(!string.IsNullOrWhiteSpace(pedido?.PilotoTelefono)){<a class="ev-btn" href="tel:@pedido.PilotoTelefono">Contactar repartidor</a>}@if(caso.Estado!="Resuelta"){<button class="ev-btn primary" type="button" data-ev-incident-action="Resolver" data-id="@caso.Id">Registrar resolución</button><button class="ev-btn" type="button" data-ev-incident-action="Nota" data-id="@caso.Id">Añadir nota</button><button class="ev-btn small" type="button" data-ev-incident-action="Atender" data-id="@caso.Id">En atención</button><button class="ev-btn small" type="button" data-ev-incident-action="Escalar" data-id="@caso.Id">Escalar</button>}else{<button class="ev-btn" type="button" data-ev-incident-action="Reabrir" data-id="@caso.Id">Reabrir con motivo</button>}@if(caso.OrdenId.HasValue){<a class="ev-btn" href="/Operaciones/Pedido/@caso.OrdenId">Ver pedido</a>}</div>@if(caso.Resolucion!=null){<div class="ev-alert green" style="margin-top:12px">@caso.Resolucion</div>}</div>}else{<div class="ev-empty"><strong>Selecciona una incidencia</strong>Su contexto, responsable y actividad aparecerán aquí.</div>}</aside></div>
}
