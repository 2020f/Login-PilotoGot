@model Login.ViewModels.Envirapido.OperationsPageVm
@{var list=Model.Devoluciones;var selected=list.FirstOrDefault(d=>d.Id==Model.Id);}
<section class="ev-card" data-ev-client-table><div class="ev-card-head"><h2>Reintentos y devoluciones</h2><input class="ev-input" data-ev-table-search placeholder="Buscar solicitud, pedido o comercio" aria-label="Buscar devoluciones"/></div><div class="ev-card-body"><div class="ev-alert neutral">El piloto custodio solicita tras recoger. El gestor autoriza o rechaza; el retorno se recibe y audita en el comercio original. Autorizar reintento conserva C y no levanta pausas de CRM.</div></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Solicitud</th><th>Pedido / parada</th><th>Tipo y motivo</th><th>Comercio original</th><th>Estado</th><th>Estado de entrega</th><th>Acciones</th></tr></thead><tbody>@foreach(var x in list){<tr class="@(selected?.Id==x.Id?"selected":"")"><td>DV-@x.Id.ToString("D4")<span class="ev-secondary">@x.SolicitadaAt.AddHours(-4).ToString("dd/MM HH:mm")</span></td><td><a href="/Operaciones/Pedido/@x.OrdenId?paradaId=@x.ParadaId">#@x.OrdenId · Parada #@x.ParadaId</a></td><td>@(x.Tipo=="Devolucion"?"Devolución":x.Tipo)<span class="ev-secondary" title="@x.Motivo">@x.Motivo</span></td><td>@x.TiendaOrigenNombre</td><td><span class="ev-badge @(x.Estado=="Recibida"?"blue":x.Estado=="Rechazada"?"gray":"amber")">@(x.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>x.Estado})</span></td><td>@(x.EstadoParada switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>x.EstadoParada})</td><td><div class="ev-actions">@if(x.Estado=="Solicitada"){<button class="ev-btn small primary" type="button" data-ev-return-decision="Autorizar" data-id="@x.Id">Autorizar</button><button class="ev-btn small danger" type="button" data-ev-return-decision="Rechazar" data-id="@x.Id">Rechazar</button>}@if(x.Estado=="EnRetorno"){<button class="ev-btn small" type="button" data-ev-return-receive="@x.Id">Confirmar recepción</button>}<a href="/Operaciones/Devoluciones?id=@x.Id">Ver gestión</a></div></td></tr>}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div><div class="ev-updated">Últimas 1000 gestiones de la empresa · retorno no es entrega al destinatario</div></section>
@if(selected!=null){<section class="ev-card" style="margin-top:15px"><div class="ev-card-head"><h2>Gestión DV-@selected.Id.ToString("D4")</h2></div><div class="ev-card-body"><dl class="ev-key-values"><dt>Motivo</dt><dd>@selected.Motivo</dd><dt>Decisión del gestor</dt><dd>@(selected.NotaDecision??"Pendiente")</dd><dt>Autorizada</dt><dd>@(selected.AutorizadaAt?.AddHours(-4).ToString("dd/MM/yyyy HH:mm")??"—")</dd><dt>Retorno iniciado</dt><dd>@(selected.IniciadaAt?.AddHours(-4).ToString("dd/MM/yyyy HH:mm")??"—")</dd><dt>Recibida en origen</dt><dd>@(selected.RecibidaAt?.AddHours(-4).ToString("dd/MM/yyyy HH:mm")??"—")</dd><dt>Observaciones de recepción</dt><dd>@(selected.ObservacionesRecepcion??"Sin recepción registrada")</dd></dl></div></section>}
<dialog class="ev-dialog" id="evReturnDecisionDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2 data-ev-dialog-title>Decidir solicitud</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="accion" type="hidden"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Motivo de la decisión</label><textarea name="nota" maxlength="1000" required></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Confirmar decisión</button></div></form></dialog>
<dialog class="ev-dialog" id="evReturnReceiveDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2>Recibir devolución en origen</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><input name="tiendaId" type="hidden" data-type="number"/><p data-ev-return-origin></p><div class="ev-field"><label>Observaciones de recepción</label><textarea name="observaciones" maxlength="1000" required></textarea></div><p class="ev-hint">Confirma que el comercio original recibió físicamente el paquete. Esta acción cierra el retorno, no una entrega al destinatario.</p><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Confirmar recepción física</button></div></form></dialog>
