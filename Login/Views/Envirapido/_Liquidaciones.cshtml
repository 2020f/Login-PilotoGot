@model Login.ViewModels.Envirapido.OperationsPageVm
@using Login.Application.Operations
@{
var d=Model.Datos;var indicators=d.Indicadores;var sums=Model.Tab=="Repartidores"?indicators?.LiquidacionesPilotosPorEstado:Model.Tab=="Comercios"?indicators?.LiquidacionesComerciosPorEstado:indicators?.LiquidacionesPorEstado;var lista=Model.Tab=="Comercios"?d.Liquidaciones.Where(l=>l.TiendaId.HasValue):d.Liquidaciones.Where(l=>l.PilotoId.HasValue);var current=lista.FirstOrDefault(l=>l.Id==Model.Id)??lista.OrderByDescending(l=>l.Id).FirstOrDefault();
string Amount(decimal n)=>"RD$ "+n.ToString("N2");string Label(string s)=>s=="EnRevision"?"En revisión":s;
}
<div class="ev-metrics"><article class="ev-metric"><svg class="ev-icon"><use href="#ev-card"></use></svg><div><div class="ev-metric-label">Neto del período</div><strong class="ev-money-metric">@(sums!=null?Amount(sums.Values.Sum(x=>x.Neto)):"—")</strong><small>@(sums?.Values.Sum(x=>x.Cantidad).ToString()??"—") liquidaciones · @(Model.Tab is "Repartidores" or "Comercios"?Model.Tab.ToLowerInvariant():"empresa")</small></div></article>@foreach(var state in new[]{("EnRevision","En revisión","amber"),("Aprobada","Aprobado por pagar","green"),("Programada","Programado","blue"),("Pagada","Pagado","green")}){var summary=sums?.GetValueOrDefault(state.Item1,new ResumenLiquidacionesEstado(0,0m));<article class="ev-metric @state.Item3"><svg class="ev-icon"><use href="#ev-card"></use></svg><div><div class="ev-metric-label">@state.Item2</div><strong class="ev-money-metric">@(summary!=null?Amount(summary.Neto):"—")</strong><small>@(summary?.Cantidad.ToString()??"—") liquidaciones</small></div></article>}</div>
@if(Model.Tab=="Reglas de liquidación"){@await Html.PartialAsync("_Reglas",Model)}
else if(Model.Tab=="Conciliación")
{
<section class="ev-card" data-ev-client-table><div class="ev-card-head"><h2>Cobros y recepción de efectivo</h2><button class="ev-btn primary" type="button" data-ev-open="evCollectionDialog">Registrar cobro</button><input class="ev-input" data-ev-table-search placeholder="Buscar referencia o pedido" aria-label="Buscar cobros"/></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Cobro</th><th>Pedido / parada</th><th>Importe registrado</th><th>Importe verificado</th><th>Referencia</th><th>Recepción empresa</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var c in d.Cobros.OrderByDescending(c=>c.Id)){<tr data-resource-id="@c.Id" data-resource-kind="cobro"><td>CO-@c.Id.ToString("D4")</td><td><a href="/Operaciones/Pedido/@c.OrdenId">#@c.OrdenId</a><span class="ev-secondary">@(c.ParadaId.HasValue?"Parada #"+c.ParadaId:"")</span></td><td>@Amount(c.Importe)</td><td>@(c.ImporteVerificado.HasValue?Amount(c.ImporteVerificado.Value):"Sin verificar")</td><td>@c.Referencia</td><td>@(c.EntregadoEmpresaAt.HasValue?Amount(c.ImporteEntregadoEmpresa??0):"Pendiente de entrega")<span class="ev-secondary">@(c.EntregadoEmpresaAt?.AddHours(-4).ToString("dd/MM HH:mm")??"El repartidor debe entregar el efectivo")</span></td><td><span class="ev-badge @(c.ConciliadoAt.HasValue?"green":"amber")">@(c.ConciliadoAt.HasValue?"Conciliado":"Por conciliar")</span></td><td><button class="ev-btn small" type="button" data-ev-collection-reconcile="@c.Id">Conciliar</button>@if(!c.EntregadoEmpresaAt.HasValue){<button class="ev-btn small" type="button" data-ev-cash-receive="@c.Id">Recibir efectivo</button>}</td></tr>}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div></section>
}
else if(Model.Tab=="Historial")
{<section class="ev-card" data-ev-client-table><div class="ev-card-head"><h2>Movimientos de liquidación</h2><input class="ev-input" data-ev-table-search placeholder="Buscar concepto, pedido o beneficiario" aria-label="Buscar movimientos"/></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Fecha</th><th>Liquidación</th><th>Beneficiario</th><th>Concepto</th><th>Operación</th><th>Importe</th></tr></thead><tbody>@foreach(var l in d.Liquidaciones.OrderByDescending(l=>l.Id)){@foreach(var m in l.Movimientos.OrderByDescending(m=>m.CreatedAt)){<tr><td>@m.CreatedAt.AddHours(-4).ToString("dd/MM/yy HH:mm")</td><td><a href="/Operaciones/Liquidaciones?id=@l.Id&tab=@(l.TiendaId.HasValue?"Comercios":"Repartidores")&desde=@Model.Desde?.ToString("yyyy-MM-dd")&hasta=@Model.Hasta?.ToString("yyyy-MM-dd")">@l.Codigo</a></td><td>@l.Beneficiario</td><td>@m.Concepto<span class="ev-secondary">@m.Descripcion</span></td><td>@(m.OrdenId.HasValue?"Pedido #"+m.OrdenId:m.RutaId.HasValue?"Ruta #"+m.RutaId:"Ajuste")</td><td>@Amount(m.Importe)</td></tr>}}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div></section>}
else
{
<div class="ev-module-split"><section class="ev-card" data-ev-client-table><div class="ev-toolbar"><label class="ev-search"><svg class="ev-icon"><use href="#ev-search"></use></svg><input data-ev-table-search placeholder="Buscar liquidación o beneficiario" value="@Model.Buscar" aria-label="Buscar liquidaciones"/></label><select class="ev-select" data-ev-table-filter="reconciled" aria-label="Conciliación"><option value="">Conciliación</option><option value="true">Conciliada</option><option value="false">Con diferencias / por revisar</option></select><select class="ev-select" data-ev-table-filter="method" aria-label="Método"><option value="">Todos los métodos</option>@foreach(var method in lista.Select(l=>l.MetodoPago).Where(m=>m!=null).Distinct()){<option>@method</option>}</select></div><div class="ev-toolbar"><div class="ev-chips">@foreach(var state in new[]{("","Todas"),("EnRevision","En revisión"),("Aprobada","Aprobadas"),("Programada","Programadas"),("Pagada","Pagadas")}){<button type="button" class="ev-chip @(state.Item1==""?"active":"")" data-ev-state-filter="@state.Item1">@state.Item2</button>}</div></div><div class="ev-table-scroll"><table class="ev-table ev-settlement-table"><thead><tr><th><input type="checkbox" class="ev-check" data-ev-select-client-page aria-label="Seleccionar liquidaciones visibles"/></th><th data-sort>Liquidación ↕</th><th data-sort>Beneficiario ↕</th><th>Entregas C</th><th data-sort="number">Neto ↕</th><th>Conciliación</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var l in lista.OrderByDescending(l=>l.Id)){<tr data-resource-id="@l.Id" data-resource-kind="liquidacion" class="@(l.Id==current?.Id?"selected":"")" data-state="@l.Estado" data-reconciled="@(l.Conciliada?"true":"false")" data-method="@l.MetodoPago"><td><input class="ev-check" type="checkbox" value="@l.Id" data-ev-select-liquidation aria-label="Seleccionar @l.Codigo"/></td><td><strong>@l.Codigo</strong><span class="ev-secondary">@l.Desde.ToString("dd MMM")–@l.Hasta.ToString("dd MMM yyyy")</span></td><td>@l.Beneficiario<span class="ev-secondary">@(l.PilotoId.HasValue?"RP-"+l.PilotoId.Value.ToString("D4"):"Comercio #"+l.TiendaId)</span></td><td>@l.Entregas</td><td data-sort-value="@l.Neto.ToString(System.Globalization.CultureInfo.InvariantCulture)"><strong>@Amount(l.Neto)</strong></td><td><span class="ev-badge @(l.Conciliada?"green":"amber")">@(l.Conciliada?"Conciliada":"Por revisar")</span></td><td><span class="ev-badge @(l.Estado=="EnRevision"?"amber":l.Estado=="Programada"?"blue":"green")">@Label(l.Estado)</span></td><td><a href="/Operaciones/Liquidaciones?id=@l.Id&tab=@Uri.EscapeDataString(Model.Tab)&desde=@Model.Desde?.ToString("yyyy-MM-dd")&hasta=@Model.Hasta?.ToString("yyyy-MM-dd")">Ver ···</a></td></tr>}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div><div class="ev-updated">Pagos registrados fuera de Envirapido</div></section>
<aside class="ev-card">@if(current!=null){<div class="ev-card-head"><h2>Detalle de liquidación</h2><span class="ev-badge @(current.Estado=="EnRevision"?"amber":"green")">@Label(current.Estado)</span></div><div class="ev-card-body"><h3>@current.Beneficiario</h3><p class="ev-hint">@current.Codigo · @current.Desde.ToString("dd MMM")–@current.Hasta.ToString("dd MMM yyyy") · @current.Entregas entregas C</p><div class="ev-alert @(current.Conciliada?"green":"neutral")">@(current.Conciliada?"Conciliación completa":"Conciliación pendiente de revisión")</div><dl class="ev-key-values ev-breakdown"><dt>Servicios</dt><dd>@Amount(current.Servicios)</dd><dt>Incentivos</dt><dd class="ev-text-green">+ @Amount(current.Incentivos)</dd><dt>Comisiones</dt><dd>− @Amount(current.Comisiones)</dd><dt>Ajustes</dt><dd>@Amount(current.Ajustes)</dd>@if(current.TiendaId.HasValue){<dt>Efectivo recibido por la empresa</dt><dd>+ @Amount(-current.EfectivoCompensado)</dd>}else{<dt>Efectivo cobrado</dt><dd>Se entrega a la empresa</dd>}<dt><strong>Neto a pagar</strong></dt><dd><strong>@Amount(current.Neto)</strong></dd></dl><dl class="ev-key-values"><dt>Método de pago</dt><dd>@(current.MetodoPago??"Sin registrar")</dd><dt>Cuenta</dt><dd>@(current.CuentaDestino??"Sin registrar")</dd><dt>Programación</dt><dd>@(current.FechaProgramada?.ToString("dd/MM/yyyy")??"Sin programar")</dd><dt>Fecha del pago externo</dt><dd>@(current.FechaPago?.ToString("dd/MM/yyyy")??"Sin confirmar")</dd><dt>Registro en el sistema</dt><dd>@(current.PagadaAt?.AddHours(-4).ToString("dd/MM/yyyy HH:mm")??"Sin registrar")</dd><dt>Referencia externa</dt><dd>@(current.ReferenciaPago??"—")</dd></dl><div class="ev-actions ev-case-actions">@if(current.Estado=="EnRevision"){<button class="ev-btn primary" type="button" disabled="@(!current.Conciliada)" title="Concilia la liquidación antes de aprobar" data-ev-settlement-action="Aprobar" data-id="@current.Id">Aprobar liquidación</button><button class="ev-btn" type="button" data-ev-settlement-adjust="@current.Id">Registrar ajuste</button>}@if(current.Estado is "Aprobada" or "Programada"){<button class="ev-btn" type="button" data-ev-settlement-action="Programar" data-id="@current.Id">Programar pago externo</button><button class="ev-btn primary" type="button" data-ev-settlement-action="RegistrarPago" data-id="@current.Id">Confirmar pago externo</button>}@if(current.Estado=="EnRevision"){<button class="ev-btn" type="button" data-ev-settlement-action="Conciliar" data-id="@current.Id">Conciliar liquidación</button>}<button class="ev-btn" type="button" data-ev-settlement-breakdown="@current.Id">Ver desglose</button><button class="ev-btn" type="button" data-ev-settlement-download="@current.Id">Descargar resumen</button></div><p class="ev-hint">Aprobar o programar no mueve dinero. La confirmación registra un pago externo. El efectivo cobrado se entrega siempre a la empresa y no se descuenta automáticamente de ganancias.</p></div>}else{<div class="ev-empty"><strong>Selecciona una liquidación</strong>Genera una liquidación con las reglas de remuneración configuradas.</div>}</aside></div>
}
