@model Login.ViewModels.Envirapido.ImportacionVm
@{Layout="_LayoutEnvirapido";ViewData["Title"]="Importaciones";ViewData["Subtitulo"]="Importaciones";}
<div class="ev-page-heading"><div><h1>Importaciones</h1><p>Valida un archivo antes de crear órdenes en tu empresa</p></div><a class="ev-btn" href="/Operaciones/PlantillaImportacion">Descargar plantilla CSV</a></div><nav class="ev-tabs"><a href="/Operaciones/Pedidos">Listado</a><a href="/Operaciones/Programados">Programados</a><a class="active" href="/Operaciones/Importaciones">Importaciones</a><a href="/Operaciones/Devoluciones">Devoluciones</a></nav>
@if(Model.Error!=null){<div class="ev-alert red" role="alert">@Model.Error</div>}
<section class="ev-card"><div class="ev-card-head"><h2>1. Archivo y validación</h2></div><div class="ev-card-body"><form asp-action="PrevisualizarImportacion" method="post" enctype="multipart/form-data"><div class="ev-field"><label>CSV UTF-8 · máximo 100 filas y 250 KB</label><input type="file" name="archivo" accept=".csv,text/csv" required/></div><p class="ev-hint">Cabecera: ComercioId,DestinatarioIds,Nota. Para escalas, separa los IDs de destinatarios con | en una misma fila. Cada fila crea una sola orden. Los IDs se validan contra tu empresa y comercio.</p><button class="ev-btn primary" type="submit">Previsualizar y validar</button></form></div></section>
@if(Model.Filas.Count>0)
{<section class="ev-card" style="margin-top:15px"><div class="ev-card-head"><h2>@(Model.Confirmada?"2. Resultados por fila":"2. Revisión antes de crear")</h2><span class="ev-hint">@Model.Filas.Count(f=>f.Error==null) filas válidas · @Model.Filas.Count(f=>f.Error!=null) con error</span></div><form asp-action="ConfirmarImportacion" method="post"><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Fila</th><th>Comercio ID</th><th>Destinatarios</th><th>Nota</th><th>Resultado</th></tr></thead><tbody>@for(var i=0;i<Model.Filas.Count;i++){var r=Model.Filas[i];<tr><td>@r.Linea<input asp-for="Filas[i].Linea" type="hidden"/><input asp-for="Filas[i].OperacionId" type="hidden"/></td><td>@r.ComercioId<input asp-for="Filas[i].ComercioId" type="hidden"/></td><td>@r.DestinatarioIds<input asp-for="Filas[i].DestinatarioIds" type="hidden"/></td><td>@r.Nota<input asp-for="Filas[i].Nota" type="hidden"/></td><td>@if(r.Error!=null){<span class="ev-text-red">@r.Error</span>}else if(r.OrdenId.HasValue){<a href="/Operaciones/Pedido/@r.OrdenId">Creada EV-@r.Codigo</a>}else{<span class="ev-badge green">Lista para crear</span>}</td></tr>}</tbody></table></div><div class="ev-dialog-foot"><p class="ev-hint">Se procesan las filas válidas individualmente. Un reintento de esta revisión recupera la misma orden mediante su identificador.</p><button class="ev-btn primary" type="submit">@(Model.Confirmada?"Reintentar / recuperar resultados":"Confirmar filas válidas")</button></div></form></section>}
<section class="ev-card" style="margin-top:15px"><div class="ev-card-head"><h2>Órdenes importadas por tu usuario</h2><span class="ev-hint">Últimas 100 confirmaciones</span></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Pedido</th><th>Creación · RD</th><th>Acción</th></tr></thead><tbody>@foreach(var h in Model.Historial){<tr><td>EV-@h.Codigo</td><td>@h.CreadoUtc.AddHours(-4).ToString("dd/MM/yyyy HH:mm")</td><td><a href="/Operaciones/Pedido/@h.OrdenId">Ver pedido</a></td></tr>}@if(Model.Historial.Count==0){<tr><td colspan="3" class="ev-empty">Sin importaciones confirmadas por este usuario.</td></tr>}</tbody></table></div></section>
