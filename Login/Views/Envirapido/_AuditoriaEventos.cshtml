@model Login.ViewModels.Envirapido.OperationsPageVm
@{
var events=(Model.Datos.Eventos??[]).Where(e=>Model.Seccion=="Rutas y zonas"?e.Tipo.Contains("Ruta",StringComparison.OrdinalIgnoreCase)||e.Tipo.Contains("Zona",StringComparison.OrdinalIgnoreCase):Model.Seccion=="Liquidaciones"?e.Tipo.Contains("Liquidacion",StringComparison.OrdinalIgnoreCase)||e.Tipo.Contains("Cobro",StringComparison.OrdinalIgnoreCase)||e.Tipo.Contains("Efectivo",StringComparison.OrdinalIgnoreCase):e.Tipo.Contains("Incidencia",StringComparison.OrdinalIgnoreCase)||e.Tipo.Contains("Falla",StringComparison.OrdinalIgnoreCase)).OrderByDescending(e=>e.Id).ToList();
}
<section class="ev-card" data-ev-client-table style="margin-top:15px"><div class="ev-card-head"><h2>Actividad registrada</h2><input class="ev-input" data-ev-table-search placeholder="Buscar actor, acción o recurso" aria-label="Buscar eventos"/></div><div class="ev-card-body"><p class="ev-hint">Filtrada por módulo sobre los últimos 2000 eventos disponibles de esta empresa.</p></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Fecha · RD</th><th>Actor</th><th>Acción</th><th>Recurso</th><th>Descripción</th></tr></thead><tbody>@foreach(var e in events){<tr data-resource-id="@e.Id" data-resource-kind="evento"><td>@e.CreatedAt.AddHours(-4).ToString("dd/MM/yyyy HH:mm:ss")</td><td>@e.Actor</td><td>@e.Tipo</td><td>#@e.RecursoId</td><td>@e.Descripcion</td></tr>}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div></section>
