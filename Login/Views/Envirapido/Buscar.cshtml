@model Login.ViewModels.Envirapido.PanelVm
@{Layout="_LayoutEnvirapido";ViewData["Title"]="Búsqueda global";}
<div class="ev-page-heading"><div><h1>Búsqueda global</h1><p>Pedidos, repartidores y comercios de @Model.Empresa</p></div></div>
<form class="ev-filter-form" action="/Operaciones/Buscar" method="get"><label class="ev-search"><svg class="ev-icon"><use href="#ev-search"></use></svg><input name="buscar" value="@Model.Buscar" maxlength="100" placeholder="Pedido, destinatario, repartidor o comercio" required aria-label="Buscar en la empresa"/></label><button class="ev-btn primary" type="submit">Buscar</button></form>
@if(!string.IsNullOrWhiteSpace(Model.Buscar))
{
<section class="ev-card"><div class="ev-card-head"><h2>Pedidos <span class="ev-count">@Model.Total</span></h2><a href="/Operaciones/Pedidos?buscar=@Uri.EscapeDataString(Model.Buscar)">Ver todos los resultados</a></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Pedido</th><th>Comercio</th><th>Destinatarios</th><th>Repartidor</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var p in Model.Pedidos){<tr><td>EV-@p.Codigo</td><td>@p.Comercio</td><td>@p.Destinatario</td><td>@(p.Piloto??"Sin asignar")</td><td>@p.EtiquetaEstado</td><td><a href="/Operaciones/Pedido/@p.Id">Ver pedido</a></td></tr>}@if(Model.Pedidos.Count==0){<tr><td colspan="6" class="ev-empty">Sin pedidos coincidentes.</td></tr>}</tbody></table></div></section>
<div class="ev-two-col" style="margin-top:15px"><section class="ev-card"><div class="ev-card-head"><h2>Repartidores <span class="ev-count">@Model.Flota.Count</span></h2></div><div class="ev-card-body">@foreach(var p in Model.Flota.Take(50)){<p><a href="/Supervisor/EditarPiloto/@p.Id">@p.Nombre</a> <span class="ev-badge">@p.Estado</span><small>@p.Telefono</small></p>}@if(Model.Flota.Count==0){<div class="ev-empty">Sin repartidores coincidentes.</div>}</div></section><section class="ev-card"><div class="ev-card-head"><h2>Comercios <span class="ev-count">@Model.Comercios.Count</span></h2></div><div class="ev-card-body">@foreach(var p in Model.Comercios.Take(50)){<p><a href="/Supervisor/EditarTienda/@p.Value">@p.Text</a></p>}@if(Model.Comercios.Count==0){<div class="ev-empty">Sin comercios coincidentes.</div>}</div></section></div>
}
else{<div class="ev-card ev-empty">Escribe un término para consultar tu empresa.</div>}
