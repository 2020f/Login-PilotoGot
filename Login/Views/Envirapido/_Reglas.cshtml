@model Login.ViewModels.Envirapido.OperationsPageVm
@if(Model.Seccion is "Incidencias" or "Operaciones" or "Configuración")
{
<section class="ev-card"><div class="ev-card-head"><h2>Reglas de atención</h2><button class="ev-btn primary" type="button" data-ev-open="evIncidentRuleDialog">+ Crear regla</button></div><div class="ev-card-body"><div class="ev-alert neutral">Una categoría sin regla se registra sin pausa automática ni plazo de resolución. La resolución del caso no entrega la orden.</div></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Categoría</th><th>Prioridad</th><th>Plazo</th><th>Efecto operativo</th><th>Detección de demora</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in Model.Datos.ReglasIncidencia){<tr><td>@r.Categoria</td><td>@(r.Prioridad==4?"Crítica":r.Prioridad==3?"Alta":r.Prioridad==2?"Media":"Baja")</td><td>@(r.MinutosResolucion.HasValue?r.MinutosResolucion+" min":"Sin SLA")</td><td>@(r.Efecto switch {"Continuar"=>"Permitir continuar","PausarParada"=>"Pausar la parada afectada","PausarRuta"=>"Pausar la ruta afectada",_=>r.Efecto})</td><td>@(r.DetectarDemora?"Según compromiso real":"No activa")</td><td><span class="ev-badge @(r.Activa?"green":"gray")">@(r.Activa?"Activa":"Inactiva")</span></td><td><button class="ev-btn small" type="button" data-ev-incident-rule-edit="@r.Id">Editar regla</button></td></tr>}@if(Model.Datos.ReglasIncidencia.Count==0){<tr><td colspan="7" class="ev-empty">Sin reglas configuradas. Cada incidencia se podrá registrar y atender manualmente.</td></tr>}</tbody></table></div></section>
}
@if(Model.Seccion is "Liquidaciones" or "Configuración")
{
<section class="ev-card" style="margin-top:15px"><div class="ev-card-head"><h2>Reglas de liquidación</h2><button class="ev-btn primary" type="button" data-ev-open="evPayRuleDialog">+ Crear regla</button></div><div class="ev-card-body"><p class="ev-hint">Remuneración por servicio, ruta o parada. La regla se conserva con la liquidación generada; cambiarla no reescribe el historial.</p></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Regla</th><th>Unidad</th><th>Importe fijo</th><th>Tarifa %</th><th>Incentivo</th><th>Comisión %</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in Model.Datos.ReglasRemuneracion){<tr><td>@r.Nombre</td><td>@r.Unidad</td><td>RD$ @r.ImporteFijo.ToString("N2")</td><td>@r.PorcentajeTarifa.ToString("N2")%</td><td>RD$ @r.IncentivoFijo.ToString("N2")</td><td>@r.ComisionPorcentaje.ToString("N2")%</td><td><span class="ev-badge @(r.Activa?"green":"gray")">@(r.Activa?"Activa":"Inactiva")</span></td><td><button class="ev-btn small" type="button" data-ev-pay-rule-edit="@r.Id">Editar regla</button></td></tr>}@if(Model.Datos.ReglasRemuneracion.Count==0){<tr><td colspan="8" class="ev-empty">Configura una regla antes de generar remuneración de repartidores.</td></tr>}</tbody></table></div></section>
}
