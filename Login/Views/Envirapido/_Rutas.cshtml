@model Login.ViewModels.Envirapido.OperationsPageVm
@using Login.Application.Interfaces
@inject IGoogleMapsService GoogleMaps
<p><a class="ev-btn" href="/Operaciones/Reasignaciones">Planificar rutas de paradas y revisar recepciones</a></p>
@{
var d=Model.Datos;var indicators=d.Indicadores;var ruta=d.Rutas.FirstOrDefault(r=>r.Id==Model.Id);var zona=d.Zonas.FirstOrDefault(z=>z.Id==ruta?.ZonaId)??d.Zonas.FirstOrDefault();
var mutable=ruta!=null&&ruta.Estado is not ("Cancelada" or "Finalizada");
var rutas=Model.Tab=="Rutas activas"?d.Rutas.Where(r=>r.Estado is "Planificada" or "Recogiendo" or "EnRuta" or "EnRetorno"):Model.Tab=="Historial"?d.Rutas.Where(r=>r.Estado is "Finalizada" or "Cancelada"):d.Rutas.AsEnumerable();
}
<div class="ev-metrics ev-metrics-four"><article class="ev-metric"><svg class="ev-icon"><use href="#ev-pin"></use></svg><div><div class="ev-metric-label">Zonas activas</div><strong>@(indicators?.ZonasActivas.ToString()??"—")</strong><small>Áreas de cobertura</small></div></article><article class="ev-metric"><svg class="ev-icon"><use href="#ev-truck"></use></svg><div><div class="ev-metric-label">Rutas en curso</div><strong>@(indicators?.RutasEnCurso.ToString()??"—")</strong><small>Rutas en ejecución</small></div></article><article class="ev-metric"><svg class="ev-icon"><use href="#ev-box"></use></svg><div><div class="ev-metric-label">Paradas pendientes</div><strong>@(indicators?.ParadasPendientes.ToString()??"—")</strong><small>Destinatarios pendientes de C</small></div></article><article class="ev-metric amber"><svg class="ev-icon"><use href="#ev-alert"></use></svg><div><div class="ev-metric-label">Zonas con alta carga</div><strong>@(indicators?.ZonasAltaCarga.ToString()??"—")</strong><small>Según capacidad configurada</small></div></article></div>
@if(Model.Tab is "Vista general" or "Zonas de cobertura" or "Planificador" || ruta!=null)
{
<div class="ev-operations-grid"><section class="ev-card"><div class="ev-card-head"><h2>@(ruta?.Nombre??"Mapa de cobertura y rutas")</h2><div class="ev-chips"><label class="ev-chip"><input type="checkbox" checked data-ev-layer="zonas"/> Zonas</label><label class="ev-chip"><input type="checkbox" checked data-ev-layer="rutas"/> Rutas</label><label class="ev-chip"><input type="checkbox" checked data-ev-layer="pilotos"/> Repartidores</label><button class="ev-btn small" type="button" data-ev-map-center>Centrar</button></div></div><div class="ev-map ev-map-tall" data-ev-module-map data-map-api-key="@GoogleMaps.BrowserApiKey" data-route-id="@ruta?.Id"><div class="ev-map-content"></div><div class="ev-map-empty"><svg class="ev-icon"><use href="#ev-pin"></use></svg><strong>Cargando cobertura</strong><span>Polígonos, puntos y posiciones registrados.</span></div><div class="ev-map-legend"><span><i></i>Ruta seleccionada</span><span><i class="pickup"></i>Recogida B</span><span><i class="dropoff"></i>Entrega C</span></div></div></section>
<aside class="ev-card"><div class="ev-card-head"><h2>@(ruta!=null?"Detalle de ruta":"Zona seleccionada")</h2>@if(ruta!=null){<span class="ev-badge @(ruta.Estado=="Planificada"?"blue":ruta.Estado is "Cancelada" or "Finalizada"?"gray":"teal")">@(ruta.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>ruta.Estado})</span>}else if(zona!=null){<span class="ev-badge @(zona.Activa?"green":"gray")">@(zona.Activa?"Activa":"Inactiva")</span>}</div><div class="ev-card-body">
@if(ruta!=null){<h3>@ruta.Codigo · @ruta.Nombre</h3><dl class="ev-key-values"><dt>Estado</dt><dd>@(ruta.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>ruta.Estado})</dd><dt>Repartidor</dt><dd>@(ruta.Piloto??"Sin asignar")</dd><dt>Órdenes</dt><dd>@ruta.OrdenIds.Count</dd><dt>Recogidas B</dt><dd>@ruta.RecogidasCompletadas/@ruta.TotalRecogidas</dd><dt>Entregas C</dt><dd>@ruta.EntregasCompletadas/@ruta.TotalEntregas <span class="ev-secondary">@ruta.EntregasDevueltas devueltas</span></dd><dt>Distancia estimada</dt><dd>@(ruta.DistanciaKm?.ToString("N1")??"—") km</dd><dt>ETA</dt><dd>@(ruta.Estado is "Finalizada" or "Cancelada"?"Finalizado":ruta.LlegadaEstimadaAt?.AddHours(-4).ToString("HH:mm")??"Sin estimación")</dd></dl><div class="ev-actions">@if(ruta.Estado=="Planificada"){<button class="ev-btn" data-ev-route-assign="@ruta.Id" type="button">Asignar repartidor</button>}@if(ruta.Estado=="Planificada"){<button class="ev-btn primary" data-ev-route-state="Iniciar" data-id="@ruta.Id" type="button">Iniciar ruta</button>}@if(ruta.Estado is "Recogiendo" or "EnRuta" or "EnRetorno"){<button class="ev-btn primary" data-ev-route-state="Finalizar" data-id="@ruta.Id" type="button">Finalizar ruta</button>}@if(ruta.Estado=="Planificada"){<button class="ev-btn danger" data-ev-route-state="Cancelar" data-id="@ruta.Id" type="button">Cancelar ruta</button>}</div><ol class="ev-route-points" data-route-points="@ruta.Id">@foreach(var p in ruta.Puntos.OrderBy(p=>p.Posicion)){<li data-point-id="@p.Id"><span class="ev-point-index @(p.Tipo=="Devolucion"||p.ExcluidoPorRetorno?"returned":p.Completado&&!p.ExcluidoPorCancelacion?"done":"")">@(p.ExcluidoPorRetorno?"↶":p.ExcluidoPorCancelacion?"×":p.Completado?"✓":p.Posicion.ToString())</span><div><strong>@p.Nombre</strong><small>@(p.Tipo=="Devolucion"?"Devolución":p.Tipo) · @p.Direccion</small>@if(p.ExcluidoPorRetorno){<span class="ev-badge blue">Entrega excluida por retorno · @(p.EstadoEntrega switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>p.EstadoEntrega})</span>}@if(p.ExcluidoPorCancelacion){<span class="ev-badge gray">Cancelada / retirada</span>}<a href="/Operaciones/Pedido/@p.OrdenId@(p.ParadaId.HasValue?"?paradaId="+p.ParadaId:"")">Ver pedido</a></div>@if(mutable&&!p.Completado&&!p.ExcluidoPorRetorno&&!p.ExcluidoPorCancelacion){<div class="ev-point-reorder"><button type="button" data-ev-point-up aria-label="Subir punto">↑</button><button type="button" data-ev-point-down aria-label="Bajar punto">↓</button></div>}</li>}</ol>@if(mutable){<button class="ev-btn" type="button" data-ev-route-reorder="@ruta.Id">Guardar secuencia</button>}<p class="ev-hint">Cada recogida B debe preceder a sus entregas C. Ordenar la tabla no cambia esta secuencia.</p>}
else if(zona!=null){<h3>@zona.Nombre <span class="ev-badge">@zona.Codigo</span></h3><dl class="ev-key-values"><dt>Región</dt><dd>@zona.Region</dd><dt>Superficie</dt><dd>@zona.SuperficieKm2.ToString("N1") km²</dd><dt>Horario</dt><dd>@zona.HoraInicio–@zona.HoraFin</dd><dt>Capacidad simultánea</dt><dd>@zona.Carga / @zona.Capacidad</dd><dt>Unidad</dt><dd>@zona.UnidadCapacidad</dd><dt>Repartidores disponibles</dt><dd>@zona.PilotosDisponibles</dd><dt>Pedidos sin asignar</dt><dd>@zona.PedidosSinAsignar</dd></dl>@if(zona.Capacidad>0){<progress class="ev-progress" value="@zona.Carga" max="@zona.Capacidad"></progress><p class="ev-hint">@((100.0*zona.Carga/zona.Capacidad).ToString("N0"))% de capacidad</p>}<div class="ev-actions"><button class="ev-btn" data-ev-zone-edit="@zona.Id" type="button">Editar límites</button><button class="ev-btn" data-ev-zone-edit="@zona.Id" type="button">Reglas de zona</button></div>}
else{<div class="ev-empty"><strong>Configura tu cobertura</strong>Crea una zona con su polígono, horario y capacidad.</div><button class="ev-btn primary" type="button" data-ev-open="evZoneDialog">Crear zona</button>}
@if(d.Zonas.Any(z=>z.AltaCarga)){<div class="ev-alert" style="margin-top:14px"><svg class="ev-icon"><use href="#ev-alert"></use></svg>@(indicators?.ZonasAltaCarga.ToString()??"—") zonas alcanzan el umbral configurado.</div>}
</div></aside></div>
}
@if(Model.Tab=="Zonas de cobertura")
{<section class="ev-card"><div class="ev-card-head"><h2>Zonas de cobertura</h2></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th>Código</th><th>Zona / región</th><th>Horario</th><th>Carga</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var z in d.Zonas){<tr data-resource-id="@z.Id" data-resource-kind="zona"><td>@z.Codigo</td><td><strong>@z.Nombre</strong><span class="ev-secondary">@z.Region</span></td><td>@z.HoraInicio–@z.HoraFin</td><td>@z.Carga / @z.Capacidad <span class="ev-secondary">@z.UnidadCapacidad</span></td><td><span class="ev-badge @(z.Activa?"green":"gray")">@(z.Activa?"Activa":"Inactiva")</span></td><td><button class="ev-btn small" type="button" data-ev-zone-edit="@z.Id">Editar</button></td></tr>}@if(d.Zonas.Count==0){<tr><td colspan="6" class="ev-empty">Sin zonas registradas.</td></tr>}</tbody></table></div></section>}
else
{<section class="ev-card" data-ev-client-table><div class="ev-card-head"><h2>@(Model.Tab=="Historial"?"Historial de rutas":"Rutas de la operación")</h2><input class="ev-input" data-ev-table-search placeholder="Buscar ruta, zona o repartidor" aria-label="Buscar rutas" /></div><div class="ev-table-scroll"><table class="ev-table"><thead><tr><th data-sort>Ruta ↕</th><th data-sort>Zona ↕</th><th data-sort>Repartidor ↕</th><th>Paradas C</th><th>Distancia</th><th>Tiempo restante</th><th data-sort>Estado ↕</th><th>Acción</th></tr></thead><tbody>@foreach(var r in rutas.OrderByDescending(r=>r.Id)){<tr data-resource-id="@r.Id" data-resource-kind="ruta"><td><strong>@r.Codigo</strong><span class="ev-secondary">@r.Nombre · @r.Fecha.ToString("dd/MM/yyyy")</span></td><td>@(r.Zona??"Sin zona")</td><td>@(r.Piloto??"Sin asignar")</td><td>@r.EntregasCompletadas/@r.TotalEntregas · @r.EntregasDevueltas devueltas <span class="ev-secondary">@r.RecogidasCompletadas/@r.TotalRecogidas recogidas B</span></td><td>@(r.DistanciaKm?.ToString("N1")??"—") km</td><td>@(r.Estado is "Finalizada" or "Cancelada"?"—":r.MinutosRestantes.HasValue?r.MinutosRestantes.Value.ToString("N0")+" min":"Sin estimación")</td><td><span class="ev-badge @(r.Estado is "Recogiendo" or "EnRuta" or "EnRetorno"?"green":r.Estado=="Planificada"?"blue":r.Estado=="Pausada"?"amber":"gray")">@(r.Estado switch {"EnRetorno"=>"En retorno","DevolucionAutorizada"=>"Devolución autorizada","ReintentoAutorizado"=>"Reintento autorizado","EnRuta"=>"En ruta","FinalizadaConDevoluciones"=>"Cerrada con devoluciones",_=>r.Estado})</span></td><td><a href="/Operaciones/Rutas?id=@r.Id&tab=@Uri.EscapeDataString(Model.Tab)&fecha=@Model.Dia?.ToString("yyyy-MM-dd")&todos=@(!Model.Dia.HasValue?"1":null)">Ver ruta</a></td></tr>}</tbody></table></div><div class="ev-table-footer" data-ev-client-pagination></div><div class="ev-updated">Datos actualizados al abrir esta vista</div></section>}
