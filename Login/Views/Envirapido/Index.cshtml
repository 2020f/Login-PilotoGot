@model Login.ViewModels.Envirapido.PanelVm
@using Login.Application.Interfaces
@using System.Text.Json
@inject IGoogleMapsService GoogleMaps
@{ Layout = "_LayoutEnvirapido"; ViewData["Title"] = "Centro de operaciones"; }
<div class="ev-page-heading"><div><h1>Centro de operaciones</h1><p>Control de entregas y flota en tiempo real</p></div><div class="ev-actions"><a class="ev-btn" href="@("/Operaciones/Exportar"+Context.Request.QueryString.ToString())"><svg class="ev-icon"><use href="#ev-download"></use></svg>Exportar</a><a class="ev-btn primary" href="/Operaciones/CrearEnvio"><span class="ev-plus">+</span>Crear envío</a></div></div>
<nav class="ev-tabs" aria-label="Operaciones">@foreach (var tab in new[] {"Monitoreo","Despacho","Rutas","Automatización","Historial"}) { <a class="@(Model.Tab == tab ? "active" : "")" href="@(tab == "Rutas" ? "/Operaciones/Rutas" : tab == "Automatización" ? "/Operaciones/Automatizacion" : "/Operaciones?tab=" + Uri.EscapeDataString(tab))">@tab</a> }</nav>
@await Html.PartialAsync("_Filtros",Model)
@await Html.PartialAsync("_Metricas",Model)
@if (Model.Tab == "Historial")
{
    <section class="ev-card"><div class="ev-card-head"><h2>Historial operativo</h2><span class="ev-hint">Últimos 200 eventos de la empresa</span></div><ul class="ev-event-list">@foreach (var e in Model.Eventos) { <li><time datetime="@e.FechaUtc.ToString("O")" data-ev-datetime>@e.FechaUtc.AddHours(-4).ToString("dd/MM HH:mm")</time><div><strong>@e.Tipo · <a href="/Operaciones/Pedido/@e.OrdenId">Pedido #@e.OrdenId</a></strong><p>@e.Descripcion</p><small>@e.Actor</small></div></li> }</ul>@if (Model.Eventos.Count == 0) { <div class="ev-empty">Aún no hay eventos registrados.</div> }</section>
}
else
{
    <div class="ev-operations-grid"><section class="ev-card"><div class="ev-card-head"><h2>Mapa de operaciones</h2><div class="ev-segmented" data-ev-map-filters><button class="active" type="button" data-map-filter="Todos">Todos</button><button type="button" data-map-filter="Disponible">Disponibles</button><button type="button" data-map-filter="En entrega">En entrega</button><button type="button" data-map-filter="Incidencia">Con incidencia</button></div></div><div class="ev-map" data-ev-map data-map-api-key="@GoogleMaps.BrowserApiKey"><div class="ev-map-content"></div><div class="ev-map-empty"><svg class="ev-icon"><use href="#ev-pin"></use></svg><strong>Cargando ubicaciones de la flota</strong><span>Solo se muestran posiciones GPS recibidas.</span></div><div class="ev-map-legend"><span><i></i>Repartidor</span><span><i class="pickup"></i>Recogida</span><span><i class="dropoff"></i>Entrega</span><span data-ev-map-fresh>@Model.ConGpsVigente GPS vigentes</span></div></div></section>
    <section class="ev-card"><div class="ev-card-head"><h2>Cola de asignación <span class="ev-count" data-ev-queue-count>@Model.PorAsignar</span></h2></div><div class="ev-queue"><div class="ev-segmented" data-ev-queue-filter><button type="button" class="active" data-queue-mode="auto">Automática</button><button type="button" data-queue-mode="manual">Manual</button></div><p class="ev-hint">Órdenes por modalidad · la política se configura por comercio</p><div class="ev-queue-list">
        @foreach (var p in Model.Cola) { <article class="ev-queue-item" data-queue-auto="@(p.Auto ? "true" : "false")" hidden="@(!p.Auto)"><svg class="ev-icon"><use href="#ev-box"></use></svg><div class="ev-queue-info"><strong>EV-@p.Codigo</strong><p title="@p.Comercio → @p.Destinatario">@p.Comercio → @p.Destinatario</p><small>@(p.Auto ? "Ofertada a repartidores" : "Asignación manual") · <time datetime="@p.CreadoUtc.ToString("O")" data-ev-wait></time></small></div><div class="ev-queue-right"><span class="ev-badge amber">Por asignar</span><button type="button" class="ev-btn primary small" data-ev-assign="@p.Id" data-order-label="EV-@p.Codigo">Asignar</button></div></article> }
        @if (Model.Cola.Count == 0) { <div class="ev-empty"><strong>Sin pedidos por asignar</strong>Las nuevas órdenes aparecerán aquí.</div> }
    </div>@if (Model.Incidencias > 0) { <div class="ev-alert" style="margin:10px 0 0">@Model.Incidencias @(Model.Incidencias == 1 ? "incidencia requiere atención" : "incidencias requieren atención") <a href="/Operaciones/Incidencias">Revisar</a></div> }</div></section></div>
    <div data-ev-live-orders data-section="Operaciones">@await Html.PartialAsync("_PedidosTabla",Model)</div>
}
@await Html.PartialAsync("_Asignar",Model)
<script type="application/json" id="evMapData">@Html.Raw(JsonSerializer.Serialize(Model.Flota, EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>

<script type="application/json" id="evMapRoutes">@Html.Raw(JsonSerializer.Serialize(Model.Datos?.Rutas.Where(r=>r.Estado is "Recogiendo" or "EnRuta" or "EnRetorno"),EnvirapidoJsonOptions.Value.JsonSerializerOptions))</script>
