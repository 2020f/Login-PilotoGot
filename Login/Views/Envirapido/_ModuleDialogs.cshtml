@model Login.ViewModels.Envirapido.OperationsPageVm
@{var d=Model.Datos;}
@if(Model.Seccion=="Rutas y zonas")
{
<dialog class="ev-dialog ev-dialog-wide" id="evZoneDialog"><form data-ev-api="zonas"><div class="ev-dialog-head"><h2>Zona de cobertura</h2><button class="ev-icon-button" type="button" data-ev-close-dialog aria-label="Cerrar">✕</button></div><div class="ev-dialog-body"><input name="id" type="hidden" data-type="optional-number"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-two-col"><div class="ev-field"><label>Nombre</label><input name="nombre" required maxlength="100"/></div><div class="ev-field"><label>Región</label><input name="region" required maxlength="100"/></div></div><div class="ev-two-col"><div class="ev-field"><label>Color</label><input name="color" type="color" value="#008589" required/></div><div class="ev-field"><label><input name="activa" type="checkbox" data-type="bool" checked/> Zona activa</label></div></div><div class="ev-two-col"><div class="ev-field"><label>Horario de inicio</label><input name="horaInicio" type="time" required/></div><div class="ev-field"><label>Horario de fin</label><input name="horaFin" type="time" required/></div></div><div class="ev-two-col"><div class="ev-field"><label>Capacidad simultánea</label><input name="capacidad" type="number" min="1" max="100000" required data-type="number"/></div><div class="ev-field"><label>Unidad de capacidad</label><select name="unidadCapacidad" required><option value="ParadasPendientes">Paradas de entrega pendientes</option><option value="OrdenesAbiertas">Órdenes abiertas</option></select></div></div><div class="ev-field"><label>Alerta a partir de (%)</label><input name="avisoPorcentaje" type="number" min="1" max="100" required data-type="number"/></div><div class="ev-field"><label>Polígono de cobertura</label><textarea name="poligono" data-type="json" required rows="5" placeholder='[{"latitud":18.48,"longitud":-69.94}, …]'></textarea><small>Coordenadas reales, al menos tres vértices. También puedes pulsar «Dibujar zona» y marcar vértices en el mapa.</small></div><div class="ev-actions"><button class="ev-btn" type="button" data-ev-draw-zone>Dibujar zona en mapa</button><button class="ev-btn ghost" type="button" data-ev-clear-polygon>Limpiar vértices</button></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Guardar zona</button></div></form></dialog>
<dialog class="ev-dialog ev-dialog-wide" id="evRouteDialog"><form data-ev-api="rutas"><div class="ev-dialog-head"><h2>Crear ruta</h2><button class="ev-icon-button" type="button" data-ev-close-dialog aria-label="Cerrar">✕</button></div><div class="ev-dialog-body"><input type="hidden" name="operacionId"/><div class="ev-two-col"><div class="ev-field"><label>Nombre de ruta</label><input name="nombre" maxlength="120" required/></div><div class="ev-field"><label>Fecha de ejecución · RD</label><input name="fecha" type="date" required value="@DateTime.UtcNow.AddHours(-4).ToString("yyyy-MM-dd")"/></div></div><div class="ev-field"><label>Órdenes disponibles de esta empresa</label><input class="ev-input" data-ev-route-order-search placeholder="Buscar por código, comercio o destinatario" aria-label="Buscar órdenes para ruta"/><select name="ordenIds" multiple size="8" required data-type="numbers">@foreach(var p in Model.CandidatasRuta){<option value="@p.Id">EV-@p.Codigo · @p.Comercio · @p.Destinatario · @p.EtiquetaEstado</option>}</select><small>Hasta 100 coincidencias; busca para acceder a todas las órdenes disponibles. Cada recogida B precede a sus entregas C. Se revalidan asignaciones y rutas al guardar.</small></div><div class="ev-two-col"><div class="ev-field"><label>Repartidor (opcional al planificar)</label><select name="pilotoId" data-type="optional-number" data-ev-route-pilot><option value="">Sin asignar</option>@foreach(var p in Model.Operacion.Flota.Where(p=>p.Activo)){<option value="@p.Id">@p.Nombre · @p.Estado</option>}</select></div><div class="ev-field"><label>Zona</label><select name="zonaId" data-type="optional-number"><option value="">Sin zona</option>@foreach(var z in d.Zonas.Where(z=>z.Activa)){<option value="@z.Id">@z.Nombre</option>}</select></div></div><div class="ev-field"><label><input name="permitirReordenarPiloto" type="checkbox" data-type="bool"/> Permitir al repartidor reordenar los puntos pendientes respetando B → C</label></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Crear ruta</button></div></form></dialog>
<dialog class="ev-dialog" id="evRouteAssignDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2>Asignar ruta a un repartidor</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Repartidor</label><select name="pilotoId" required data-type="number"><option value="">Seleccionar</option>@foreach(var p in Model.Operacion.Flota.Where(p=>p.Activo)){<option value="@p.Id">@p.Nombre · @p.Carga órdenes</option>}</select></div><p class="ev-hint">El mismo repartidor ejecutará las recogidas y entregas de las órdenes agrupadas.</p><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Asignar ruta</button></div></form></dialog>
}
@if(Model.Seccion=="Incidencias" || Model.Seccion=="Operaciones")
{
<dialog class="ev-dialog" id="evIncidentDialog"><form data-ev-api="incidencias"><div class="ev-dialog-head"><h2>Registrar incidencia</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="operacionId" type="hidden"/><div class="ev-field"><label>Categoría</label><input name="categoria" maxlength="80" list="evCategories" required/><datalist id="evCategories">@foreach(var r in d.ReglasIncidencia.Where(r=>r.Activa)){<option value="@r.Categoria"/>}</datalist><small>Sin regla configurada, se registra sin pausa automática ni SLA.</small></div><div class="ev-field"><label>Descripción</label><textarea name="descripcion" maxlength="1000" required></textarea></div><div class="ev-two-col"><div class="ev-field"><label>Pedido (ID)</label><input name="ordenId" type="number" min="1" data-type="optional-number" value="@Model.OrdenId"/></div><div class="ev-field"><label>Parada (ID)</label><input name="paradaId" type="number" min="1" data-type="optional-number" value="@Model.ParadaId"/></div></div><div class="ev-field"><label>Ruta (ID, si corresponde)</label><input name="rutaId" type="number" min="1" data-type="optional-number" value="@Model.RutaId"/></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Registrar incidencia</button></div></form></dialog>
<dialog class="ev-dialog" id="evIncidentActionDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2 data-ev-dialog-title>Atender incidencia</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="accion" type="hidden"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field" data-ev-owner-field><label>Responsable</label><select name="responsableId"><option value="">Seleccionar responsable</option>@foreach(var r in d.Responsables){<option value="@r.Id">@r.Nombre</option>}</select></div><div class="ev-field"><label>Nota / motivo / resolución</label><textarea name="texto" maxlength="1000"></textarea><small>Resolver una incidencia no confirma una entrega ni reemplaza el código C.</small></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Confirmar</button></div></form></dialog>
}
@if(Model.Seccion is "Incidencias" or "Operaciones" or "Configuración")
{
<dialog class="ev-dialog" id="evIncidentRuleDialog"><form data-ev-api="reglas-incidencia"><div class="ev-dialog-head"><h2>Regla de atención</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="id" type="hidden" data-type="optional-number"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Categoría</label><input name="categoria" maxlength="80" required/></div><div class="ev-two-col"><div class="ev-field"><label>Prioridad</label><select name="prioridad" data-type="number"><option value="1">Baja</option><option value="2">Media</option><option value="3">Alta</option><option value="4">Crítica</option></select></div><div class="ev-field"><label>Plazo de resolución (minutos, opcional)</label><input name="minutosResolucion" type="number" min="1" max="43200" data-type="optional-number"/></div></div><div class="ev-field"><label>Efecto operativo</label><select name="efecto"><option value="Continuar">Permitir continuar</option><option value="PausarParada">Pausar la parada afectada</option><option value="PausarRuta">Pausar la ruta afectada</option></select></div><div class="ev-field"><label><input name="detectarDemora" type="checkbox" data-type="bool"/> Detectar demora respecto al compromiso configurado en el envío</label><small>La detección requiere un compromiso real. No genera tiempos de entrega ficticios.</small></div><div class="ev-field"><label><input name="activa" type="checkbox" data-type="bool" checked/> Regla activa</label></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Guardar regla</button></div></form></dialog>
}
@if(Model.Seccion is "Liquidaciones" or "Configuración")
{
<dialog class="ev-dialog" id="evPayRuleDialog"><form data-ev-api="reglas-remuneracion"><div class="ev-dialog-head"><h2>Regla de remuneración</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="id" type="hidden" data-type="optional-number"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Nombre</label><input name="nombre" maxlength="100" required/></div><div class="ev-field"><label>Unidad remunerable</label><select name="unidad"><option value="Servicio">Servicio / orden completada</option><option value="Ruta">Ruta completada</option><option value="Parada">Parada de entrega completada</option></select></div><div class="ev-two-col"><div class="ev-field"><label>Importe fijo (RD$)</label><input name="importeFijo" type="number" min="0" step="0.01" required data-type="number"/></div><div class="ev-field"><label>Porcentaje de tarifa (%)</label><input name="porcentajeTarifa" type="number" min="0" max="100" step="0.01" required data-type="number"/></div><div class="ev-field"><label>Incentivo fijo (RD$)</label><input name="incentivoFijo" type="number" min="0" step="0.01" required data-type="number"/></div><div class="ev-field"><label>Comisión (%)</label><input name="comisionPorcentaje" type="number" min="0" max="100" step="0.01" required data-type="number"/></div></div><div class="ev-field"><label><input name="activa" type="checkbox" checked data-type="bool"/> Regla activa</label></div><p class="ev-hint">No existe remuneración automática sin una regla configurada por la empresa.</p><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Guardar regla</button></div></form></dialog>
}
@if(Model.Seccion=="Liquidaciones")
{
<dialog class="ev-dialog" id="evSettlementDialog"><form data-ev-api="liquidaciones"><div class="ev-dialog-head"><h2>Generar liquidación</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="operacionId" type="hidden"/><div class="ev-two-col"><div class="ev-field"><label>Desde · RD</label><input name="desde" type="date" required/></div><div class="ev-field"><label>Hasta · RD</label><input name="hasta" type="date" required/></div></div><div class="ev-field"><label>Repartidor</label><select name="pilotoId" data-type="optional-number" data-ev-route-pilot><option value="">Seleccionar si corresponde</option>@foreach(var p in Model.Operacion.Flota){<option value="@p.Id">@p.Nombre</option>}</select></div><div class="ev-field"><label>Comercio (para liquidación de comercio)</label><select name="tiendaId" data-type="optional-number"><option value="">Ninguno</option>@foreach(var t in Model.Operacion.Comercios){<option value="@t.Value">@t.Text</option>}</select></div><div class="ev-field"><label>Regla de remuneración</label><select name="reglaId" data-type="optional-number"><option value="">Seleccionar una regla</option>@foreach(var r in d.ReglasRemuneracion.Where(r=>r.Activa)){<option value="@r.Id">@r.Nombre · @r.Unidad</option>}</select><small>La generación valida conceptos ya liquidados y el beneficiario elegido.</small></div><div class="ev-field"><label>Cobros recibidos por la empresa a incluir (IDs separados por coma, solo liquidación de comercio)</label><input name="cobroIds" data-type="csv-numbers"/><small>Si indicas IDs, se incluirán exactamente esos cobros elegibles. Si lo dejas vacío, se incluirán todos los cobros elegibles del comercio y período elegidos.</small></div><p class="ev-hint">Se generará en revisión; no se enviará dinero.</p><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn" type="button" data-ev-close-dialog>Cancelar</button><button class="ev-btn primary" type="submit">Generar en revisión</button></div></form></dialog>
<dialog class="ev-dialog" id="evSettlementActionDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2 data-ev-dialog-title>Actualizar liquidación</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="accion" type="hidden"/><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><p class="ev-hint">El pago ocurre fuera de Envirapido. Esta acción registra y audita su estado.</p><div data-ev-payment-fields><div class="ev-field"><label>Fecha externa</label><input name="fecha" type="date"/></div><div class="ev-field"><label>Método externo</label><input name="metodo" maxlength="40" placeholder="Transferencia bancaria, efectivo..."/></div><div class="ev-field"><label>Últimos cuatro dígitos de la cuenta (opcional)</label><input name="cuentaUltimos4" inputmode="numeric" pattern="[0-9]{4}" maxlength="4"/></div><div class="ev-field"><label>Referencia de pago externo</label><input name="referencia" maxlength="120"/></div></div><div class="ev-field"><label>Nota</label><textarea name="nota" maxlength="1000"></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Confirmar registro</button></div></form></dialog>
<dialog class="ev-dialog" id="evAdjustmentDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2>Registrar ajuste</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Importe firmado (RD$)</label><input name="importe" type="number" step="0.01" required data-type="number"/><small>Positivo añade al neto; negativo lo reduce.</small></div><div class="ev-field"><label>Motivo</label><textarea name="motivo" required maxlength="200"></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Registrar ajuste</button></div></form></dialog>
<dialog class="ev-dialog ev-dialog-wide" id="evBreakdownDialog"><div class="ev-dialog-head"><h2>Desglose de liquidación</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body" data-ev-breakdown-content></div></dialog>
<dialog class="ev-dialog" id="evCollectionDialog"><form data-ev-api="cobros"><div class="ev-dialog-head"><h2>Registrar cobro externo</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="operacionId" type="hidden"/><div class="ev-field"><label>Pedido (ID)</label><input name="ordenId" required min="1" type="number" data-type="number"/></div><div class="ev-field"><label>Parada (ID, si corresponde)</label><input name="paradaId" min="1" type="number" data-type="optional-number"/></div><div class="ev-field"><label>Importe cobrado (RD$)</label><input name="importe" required min="0" type="number" step="0.01" data-type="number"/></div><div class="ev-field"><label>Referencia</label><input name="referencia" required maxlength="80"/></div><div class="ev-field"><label>Nota</label><textarea name="nota" maxlength="500"></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Registrar cobro</button></div></form></dialog>
<dialog class="ev-dialog" id="evReconcileCollectionDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2>Conciliar cobro</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="version" type="hidden"/><input name="operacionId" type="hidden"/><div class="ev-field"><label>Importe verificado (RD$)</label><input name="importeVerificado" required min="0" type="number" step="0.01" data-type="number"/></div><div class="ev-field"><label>Resultado de revisión</label><textarea name="nota" required maxlength="500"></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Confirmar conciliación</button></div></form></dialog>
}
@if(Model.Seccion is "Pedidos" or "Configuración")
{
<dialog class="ev-dialog ev-dialog-wide" id="evOrderDataDialog"><form data-ev-api=""><div class="ev-dialog-head"><h2>Datos y compromiso del envío</h2><button class="ev-icon-button" type="button" data-ev-close-dialog>✕</button></div><div class="ev-dialog-body"><input name="operacionId" type="hidden"/><input name="version" type="hidden"/><div class="ev-field"><label>Pedido (ID)</label><input name="ordenId" type="number" min="1" required data-ev-order-data-id/></div><div class="ev-two-col"><div class="ev-field"><label>Referencia comercial</label><input name="referencia" maxlength="100"/></div><div class="ev-field"><label>Servicio</label><input name="servicio" required maxlength="60"/></div><div class="ev-field"><label>Paquetes</label><input name="paquetes" type="number" min="1" max="10000" required data-type="number"/></div><div class="ev-field"><label>Peso (kg, opcional)</label><input name="pesoKg" type="number" min="0" max="100000" step="0.01" data-type="optional-number"/></div><div class="ev-field"><label>Prioridad</label><select name="prioridad" data-type="number"><option value="1">Baja</option><option value="2">Media</option><option value="3">Alta</option><option value="4">Crítica</option></select></div><div class="ev-field"><label>Zona</label><select name="zonaId" data-type="optional-number"><option value="">Sin zona</option>@foreach(var z in d.Zonas){<option value="@z.Id">@z.Nombre</option>}</select></div><div class="ev-field"><label>Programado para · RD</label><input name="programadaPara" type="datetime-local" data-type="rd-datetime"/></div><div class="ev-field"><label>Compromiso de entrega · RD</label><input name="compromisoEntrega" type="datetime-local" data-type="rd-datetime"/></div></div><div class="ev-field"><label>Precio comercial del envío (RD$, opcional)</label><input name="precioComercial" type="number" min="0" step="0.01" data-type="optional-number"/></div><div class="ev-field"><label>Notas operativas</label><textarea name="notasOperativas" maxlength="1000"></textarea></div><div data-ev-form-error role="alert"></div></div><div class="ev-dialog-foot"><button class="ev-btn primary" type="submit">Guardar datos</button></div></form></dialog>
}
