@model Login.ViewModels.SuperAdmin.ClienteAppCreateVm
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Crear empresa"; var planes = (IEnumerable<Login.Domain.Entities.Plan>)ViewBag.Planes; }
<div class="sa-form-container">
<div class="sa-page-head">
<div>
<h2>Crear empresa</h2>
<p>Registra una cuenta independiente en Envirapido.</p>
</div>
<a class="sa-btn" asp-action="Clientes">← Volver a empresas</a>
</div>
<div class="sa-card sa-card-pad">
<form asp-action="CrearCliente" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All">
</div>
<section class="sa-form-section">
<h3>Datos de la empresa</h3>
<p>Identificación y contacto principal para administrar la cuenta.</p>
<div class="sa-form-grid">
<div class="sa-field sa-field-full">
<label asp-for="NombreComercial">Nombre comercial</label>
<input asp-for="NombreComercial" maxlength="120" required />
<span asp-validation-for="NombreComercial">
</span>
</div>
<div class="sa-field">
<label asp-for="Ubicacion">Ubicación</label>
<input asp-for="Ubicacion" maxlength="250" />
<span asp-validation-for="Ubicacion">
</span>
</div>
<div class="sa-field">
<label asp-for="Telefono">Teléfono</label>
<input asp-for="Telefono" type="tel" maxlength="30" />
<span asp-validation-for="Telefono">
</span>
</div>
<div class="sa-field">
<label asp-for="Email">Correo de contacto</label>
<input asp-for="Email" type="email" maxlength="150" />
<span asp-validation-for="Email">
</span>
</div>
<div class="sa-field">
<label asp-for="RNC">RNC</label>
<input asp-for="RNC" maxlength="20" />
<span asp-validation-for="RNC">
</span>
</div>
<div class="sa-field sa-field-full">
<label asp-for="ContactoResponsable">Persona responsable</label>
<input asp-for="ContactoResponsable" maxlength="120" />
<span asp-validation-for="ContactoResponsable">
</span>
</div>
</div>
</section>
<section class="sa-form-section">
<div class="sa-field">
<label asp-for="PlanId">Plan de suscripción</label>
<select asp-for="PlanId" required>
<option value="">Selecciona un plan</option>@foreach(var p in planes) { <option value="@p.Id">@p.Nombre · RD$@p.PrecioMensual.ToString("N2") / mes</option> }</select>
<span asp-validation-for="PlanId">
</span>
</div>
</section>
<section class="sa-form-section">
<h3>Suscripción y prueba</h3>
<p>Las fechas no acreditan pagos. La cobertura pagada se actualiza desde facturas y cobros confirmados.</p>
<div class="sa-form-grid">
<div class="sa-field">
<label asp-for="FechaInicioPlan">Inicio de suscripción</label>
<input asp-for="FechaInicioPlan" type="date" asp-format="{0:yyyy-MM-dd}" />
<span asp-validation-for="FechaInicioPlan">
</span>
</div>
<div class="sa-field">
<label asp-for="FechaFinPlan">Fin del período de prueba</label>
<input asp-for="FechaFinPlan" type="date" asp-format="{0:yyyy-MM-dd}" />
<span class="sa-sub">Sólo para prueba explícita de hasta 90 días. La cobertura pagada se confirma en Facturación.</span>
<span asp-validation-for="FechaFinPlan">
</span>
</div>
<label class="sa-check sa-field-full">
<input asp-for="EsTrial" /> Período de prueba</label>
</div>
</section>
<section class="sa-form-section">
<h3>Excepciones de cuota</h3>
<p>Pilotos y órdenes: vacío usa el plan; cero es ilimitado. Usuarios: vacío o cero es ilimitado e incluye gestor, pilotos y accesos activos de comercios.</p>
<div class="sa-form-grid">
<div class="sa-field">
<label asp-for="MaxPilotos">Máximo de pilotos</label>
<input asp-for="MaxPilotos" type="number" min="0" />
<span asp-validation-for="MaxPilotos">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxOrdenesMes">Órdenes por mes</label>
<input asp-for="MaxOrdenesMes" type="number" min="0" />
<span asp-validation-for="MaxOrdenesMes">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxUsuarios">Usuarios activos</label>
<input asp-for="MaxUsuarios" type="number" min="0" />
<span asp-validation-for="MaxUsuarios">
</span>
</div>
</div>
</section>
<section class="sa-form-section">
<div class="sa-field">
<label asp-for="Observaciones">Notas internas</label>
<textarea asp-for="Observaciones" rows="3" maxlength="500">
</textarea>
<span asp-validation-for="Observaciones">
</span>
</div>
</section>
<div class="sa-notice sa-section-gap">Después de crear la empresa, asigna su gestor desde su ficha. Los pagos se registran por separado en Facturación.</div>
<div class="sa-form-footer">
<a class="sa-btn" asp-action="Clientes">Cancelar</a>
<button class="sa-btn sa-btn-primary" type="submit">Crear empresa</button>
</div>
</form>
</div>
</div>
