@model Login.ViewModels.SuperAdmin.GestorCreateVm
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Asignar gestor"; }
<div class="sa-form-container">
<div class="sa-page-head">
<div>
<h2>Asignar gestor de empresa</h2>
<p>El gestor administrará únicamente los datos de esta empresa.</p>
</div>
<a class="sa-btn" asp-action="DetalleCliente" asp-route-id="@Model.ClienteAppId">← Volver a empresa</a>
</div>
<div class="sa-card sa-card-pad">
<form asp-action="CrearGestor" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="ClienteAppId" />
<div asp-validation-summary="All">
</div>
<div class="sa-form-grid">
<div class="sa-field">
<label asp-for="Email">Correo del gestor</label>
<input asp-for="Email" type="email" autocomplete="off" required />
<span asp-validation-for="Email">
</span>
</div>
<div class="sa-field">
<label asp-for="Password">Contraseña inicial</label>
<input asp-for="Password" type="password" minlength="12" maxlength="128" autocomplete="new-password" required />
<span asp-validation-for="Password">
</span>
<span class="sa-sub">Al menos 12 caracteres. Comunícala al gestor por un medio privado.</span>
</div>
</div>
<div class="sa-form-footer">
<a class="sa-btn" asp-action="DetalleCliente" asp-route-id="@Model.ClienteAppId">Cancelar</a>
<button class="sa-btn sa-btn-primary" type="submit">Crear gestor</button>
</div>
</form>
</div>
</div>
