@model Login.ViewModels.SuperAdmin.GestorCreateVm

<h2>Crear Gestor</h2>

<form method="post">
    <input type="hidden" asp-for="ClienteAppId" />

    <div>
        <label>Email del gestor</label><br />
        <input asp-for="Email" />
    </div>

    <div>
        <label>Password</label><br />
        <input asp-for="Password" type="password" />
    </div>

    <br />
    <button type="submit">Crear Gestor</button>
</form>

<p><a href="/SuperAdmin/Clientes">Volver</a></p>
