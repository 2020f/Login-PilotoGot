@model Login.ViewModels.SuperAdmin.ClienteAppEditVm
@using Login.Domain.Enums
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Editar empresa"; }
<div class="sa-form-container">
<div class="sa-page-head">
<div>
<h2>Editar empresa</h2>
<p>Actualiza contacto, condiciones de acceso y excepciones de cuota.</p>
</div>
<a class="sa-btn" asp-action="DetalleCliente" asp-route-id="@Model.Id">← Volver a empresa</a>
</div>
<div class="sa-card sa-card-pad">
<form asp-action="EditarCliente" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="PlanId" />
<div asp-validation-summary="All">
</div>
<section class="sa-form-section">
<h3>Datos de la empresa</h3>
<p>Identificación y contacto principal para administrar la cuenta.</p>
<div class="sa-form-grid">
<div class="sa-field sa-field-full">
<label asp-for="NombreComercial">Nombre comercial</label>
<input asp-for="NombreComercial" maxlength="120" required />
<span asp-validation-for="NombreComercial">
</span>
</div>
<div class="sa-field">
<label asp-for="Ubicacion">Ubicación</label>
<input asp-for="Ubicacion" maxlength="250" />
<span asp-validation-for="Ubicacion">
</span>
</div>
<div class="sa-field">
<label asp-for="Telefono">Teléfono</label>
<input asp-for="Telefono" type="tel" maxlength="30" />
<span asp-validation-for="Telefono">
</span>
</div>
<div class="sa-field">
<label asp-for="Email">Correo de contacto</label>
<input asp-for="Email" type="email" maxlength="150" />
<span asp-validation-for="Email">
</span>
</div>
<div class="sa-field">
<label asp-for="RNC">RNC</label>
<input asp-for="RNC" maxlength="20" />
<span asp-validation-for="RNC">
</span>
</div>
<div class="sa-field sa-field-full">
<label asp-for="ContactoResponsable">Persona responsable</label>
<input asp-for="ContactoResponsable" maxlength="120" />
<span asp-validation-for="ContactoResponsable">
</span>
</div>
</div>
</section>
<section class="sa-form-section">
<h3>Cuenta y plan</h3>
<p>Para cambiar de plan utiliza la ficha de empresa. El sistema validará el uso actual y registrará la decisión.</p>
<a class="sa-btn" asp-action="DetalleCliente" asp-route-id="@Model.Id" asp-fragment="cambiar-plan">Cambiar plan</a>
<div class="sa-field sa-section-gap">
<label asp-for="Estado">Estado operativo</label>
<select asp-for="Estado">
<option value="@EstadoClienteApp.Activo">Activo</option>
<option value="@EstadoClienteApp.Suspendido">Suspendido</option>@if(Model.Estado == EstadoClienteApp.Vencido) { <option value="@EstadoClienteApp.Vencido">Vencido (estado anterior)</option> }</select>
<span asp-validation-for="Estado">
</span>
</div>
</section>
<section class="sa-form-section">
<h3>Cobertura de suscripción</h3>
<dl class="sa-definition">
<dt>Inicio</dt>
<dd>@(Model.FechaInicioPlan?.ToString("dd/MM/yyyy") ?? "Sin fecha")</dd>
<dt>Fin de cobertura</dt>
<dd>@(Model.FechaFinPlan?.ToString("dd/MM/yyyy") ?? "Sin fecha establecida")</dd>
<dt>Prueba</dt>
<dd>@(Model.EsTrial ? "Sí" : "No")</dd>
</dl>
<p class="sa-sub">La cobertura se administra mediante facturas y pagos confirmados. Editar la empresa no modifica su historial de cobros.</p>
</section>
<section class="sa-form-section">
<h3>Cobros registrados</h3>
<dl class="sa-definition">
<dt>Último pago</dt>
<dd>@(Model.UltimoPago?.ToString("dd/MM/yyyy") ?? "Sin pagos registrados")</dd>
<dt>Próximo cobro</dt>
<dd>@(Model.ProximoCobro?.ToString("dd/MM/yyyy") ?? "Sin fecha establecida")</dd>
</dl>
<p class="sa-sub">Información calculada desde facturación. No se marca una factura como pagada al editar una fecha.</p>
</section>
<section class="sa-form-section">
<h3>Excepciones de cuota</h3>
<p>Pilotos y órdenes: vacío usa el plan; cero es ilimitado. Usuarios: vacío o cero es ilimitado e incluye gestor, pilotos y accesos activos de comercios.</p>
<div class="sa-form-grid">
<div class="sa-field">
<label asp-for="MaxPilotos">Máximo de pilotos</label>
<input asp-for="MaxPilotos" type="number" min="0" />
<span asp-validation-for="MaxPilotos">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxOrdenesMes">Órdenes por mes</label>
<input asp-for="MaxOrdenesMes" type="number" min="0" />
<span asp-validation-for="MaxOrdenesMes">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxUsuarios">Usuarios activos</label>
<input asp-for="MaxUsuarios" type="number" min="0" />
<span asp-validation-for="MaxUsuarios">
</span>
</div>
</div>
</section>
<section class="sa-form-section">
<div class="sa-field">
<label asp-for="Observaciones">Notas internas</label>
<textarea asp-for="Observaciones" rows="3" maxlength="500">
</textarea>
<span asp-validation-for="Observaciones">
</span>
</div>
</section>
<div class="sa-form-footer">
<a class="sa-btn" asp-action="DetalleCliente" asp-route-id="@Model.Id">Cancelar</a>
<button class="sa-btn sa-btn-primary" type="submit">Guardar cambios</button>
</div>
</form>
</div>
</div>
