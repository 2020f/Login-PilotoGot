@model Login.ViewModels.SuperAdmin.PlanCreateVm
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Crear plan"; }
<div class="sa-form-container">
<div class="sa-page-head">
<div>
<h2>Crear plan</h2>
<p>Define precio y capacidad. Cero equivale a ilimitado.</p>
</div>
<a class="sa-btn" asp-action="Planes">← Volver a planes</a>
</div>
<div class="sa-card sa-card-pad">
<form asp-action="CrearPlan" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="All">
</div>
<div class="sa-form-grid">
<div class="sa-field">
<label asp-for="Nombre">Nombre del plan</label>
<input asp-for="Nombre" maxlength="80" autocomplete="off" required />
<span asp-validation-for="Nombre">
</span>
</div>
<div class="sa-field">
<label asp-for="PrecioMensual">Precio mensual (RD$)</label>
<input asp-for="PrecioMensual" type="number" min="0" step="0.01" />
<span asp-validation-for="PrecioMensual">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxTiendas">Máximo de comercios activos</label>
<input asp-for="MaxTiendas" type="number" min="0" required />
<span asp-validation-for="MaxTiendas">
</span>
</div>
<div class="sa-field">
<label asp-for="MaxPilotos">Máximo de pilotos activos</label>
<input asp-for="MaxPilotos" type="number" min="0" required />
<span asp-validation-for="MaxPilotos">
</span>
</div>
<div class="sa-field sa-field-full">
<label asp-for="MaxOrdenesPorMes">Máximo de órdenes por mes</label>
<input asp-for="MaxOrdenesPorMes" type="number" min="0" required />
<span asp-validation-for="MaxOrdenesPorMes">
</span>
</div>
</div>
<div class="sa-form-footer">
<a class="sa-btn" asp-action="Planes">Cancelar</a>
<button class="sa-btn sa-btn-primary" type="submit">Crear plan</button>
</div>
</form>
</div>
</div>
