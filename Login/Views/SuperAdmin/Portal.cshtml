@using Envirapido.Portal.Contracts
@using Login.ViewModels.SuperAdmin
@model Login.ViewModels.SuperAdmin.PortalAdminVm
@{
    Layout = "_LayoutSuperAdmin";
    ViewData["Title"] = "Portal comercial · Envirapido";
    string Label(string value) => PortalAdminVm.Label(value);
    string Day(DateOnly value) => value.ToString("yyyy-MM-dd");
    string At(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(-4)).ToString("dd/MM/yyyy HH:mm");
    string Money(decimal value, string currency) => $"{value:N2} {currency}";
    string Limit(int value) => value == 0 ? "Sin límite" : value.ToString("N0");
    string MailStatus(bool confirmed, bool required) => confirmed ? "Confirmado" : required ? "Pendiente de confirmar" : "Correo de contacto · activación manual";
}
@section Styles { <link rel="stylesheet" href="~/css/portal-admin.css" asp-append-version="true" /> }
<div class="pc-header"><div><span class="pc-eyebrow">CUENTAS Y CONTRATACIONES WEB</span><h1>Portal comercial</h1><p>Revisa solicitudes, pagos externos y vigencias de la cuenta web.</p></div><a href="/SuperAdmin/Dashboard" class="sa-btn">Volver al resumen</a></div>
<div class="pc-note">Aprobar una cuenta web no crea una empresa ni entrega credenciales del CRM. Su operación y cobertura se administran por separado.</div>
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="pc-alert error" role="alert">@Model.Error</div> }
@if (!string.IsNullOrWhiteSpace(Model.Ok)) { <div class="pc-alert success" role="status">@Model.Ok</div> }
<nav class="pc-tabs" aria-label="Administración del portal">
@foreach(var tab in PortalAdminVm.Tabs) { <a class="@(tab == Model.Tab ? "active" : "")" href="@Url.Action("Index",new{tab})" aria-current="@(tab == Model.Tab ? "page" : null)">@tab</a> }
</nav>
@if (!Model.Configured)
{
    <section class="pc-card pc-empty"><h2>Conecta el portal para comenzar</h2><p>La sección está preparada. Configura su servicio privado y las claves de integración antes de recibir o administrar solicitudes.</p><p>La gestión habitual de empresas, planes y pedidos sigue disponible.</p></section>
}
else
{
    @if (Model.Summary is {} summary)
    {
        <div class="pc-metrics"><article><span>Compradores</span><strong>@summary.Users</strong></article><article><span>Por revisar</span><strong>@summary.PendingRequests</strong></article><article><span>Reportes por revisar</span><strong>@summary.PendingPayments</strong></article><article><span>Accesos vigentes</span><strong>@summary.ActiveAccess</strong></article><article><span>Accesos vencidos</span><strong>@summary.ExpiredAccess</strong></article></div>
    }
    @if (Model.Detail is {} detail)
    {
        var request = detail.Request;
        var grant = detail.AccessGrant;
        <div class="pc-title-row"><h2>Solicitud de @detail.Profile.BusinessName</h2><a class="sa-btn" href="@Url.Action("Index")">Volver al listado</a></div>
        <div class="pc-grid"><section class="pc-card"><h3>Datos recibidos al solicitar</h3><dl class="pc-details"><dt>Responsable</dt><dd>@detail.Profile.ResponsibleName</dd><dt>Correo</dt><dd>@detail.User.Email · @MailStatus(detail.User.EmailConfirmed, detail.User.EmailConfirmationRequired)</dd><dt>Teléfono</dt><dd>@detail.Profile.Phone</dd><dt>Ubicación</dt><dd>@detail.Profile.City, @detail.Profile.Province</dd><dt>Operación</dt><dd>@detail.Profile.OperationType</dd><dt>RNC</dt><dd>@(detail.Profile.Rnc ?? "No indicado")</dd><dt>Facturación</dt><dd>@(detail.Profile.BillingAddress ?? "No indicada")</dd><dt>Volumen previsto</dt><dd>@(detail.Profile.EstimatedStores?.ToString() ?? "—") comercios · @(detail.Profile.EstimatedPilots?.ToString() ?? "—") pilotos · @(detail.Profile.EstimatedOrdersPerMonth?.ToString() ?? "—") órdenes/mes</dd><dt>Notas</dt><dd>@(detail.Profile.Notes ?? "Sin notas")</dd></dl></section>
        <section class="pc-card"><h3>Plan solicitado</h3><p class="pc-plan">@request.Plan.Name</p><p><strong>@Money(request.Plan.MonthlyPrice,request.Plan.Currency)</strong> / mes</p><p>@Limit(request.Plan.MaxStores) comercios · @Limit(request.Plan.MaxPilots) pilotos · @Limit(request.Plan.MaxOrdersPerMonth) órdenes/mes</p><dl class="pc-details"><dt>Solicitud</dt><dd>@Label(request.Status)</dd><dt>Pago</dt><dd>@Label(request.PaymentStatus)</dd><dt>Confirmado</dt><dd>@Money(request.ConfirmedAmount,request.Plan.Currency)</dd><dt>Por confirmar</dt><dd>@Money(request.AmountDue,request.Plan.Currency)</dd><dt>Recibida</dt><dd>@At(request.CreatedAt) RD</dd></dl><p class="pc-muted">Condiciones conservadas al solicitar. Los cambios futuros del catálogo no reescriben este registro.</p></section></div>
        <div class="pc-grid"><section class="pc-card"><h3>Revisión manual</h3><form action="@Url.Action("Decision")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="version" value="@request.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" />
        <label>Decisión<select name="decision" required><option value="InReview">En revisión</option><option value="NeedsInformation">Requiere información</option><option value="Approved">Aprobar solicitud</option><option value="Rejected">Rechazar</option><option value="Cancelled">Cancelar solicitud</option></select></label><label>Mensaje para el comprador<textarea name="message" maxlength="500" required></textarea></label><button class="sa-btn sa-btn-primary" type="submit">Registrar decisión</button></form></section>
        <section class="pc-card"><h3>Vigencia de la cuenta web</h3><p class="pc-muted">Fechas inclusivas en República Dominicana. El servidor exige aprobación, pago suficiente cuando corresponda y vigencia habilitada. @(detail.User.EmailConfirmationRequired ? "Esta instalación también exige confirmar el correo." : "El correo es un dato de contacto: la activación del plan es manual y no requiere SMTP.")</p><form action="@Url.Action("Access")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="userId" value="@detail.User.Id" /><input type="hidden" name="version" value="@grant?.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" />
        <div class="pc-grid"><label>Inicio<input type="date" name="startsOn" value="@Day(grant?.StartsOn ?? Model.Today)" required /></label><label>Fin<input type="date" name="endsOn" value="@Day(grant?.EndsOn ?? Model.Today.AddMonths(1).AddDays(-1))" required /></label></div><label>Acceso<select name="status"><option value="Enabled">Habilitado según vigencia</option><option value="Suspended">Suspendido</option><option value="Revoked">Revocado</option></select></label><label>Motivo<textarea name="reason" required maxlength="500"></textarea></label><button class="sa-btn sa-btn-primary" type="submit">Guardar vigencia del portal</button></form></section></div>
        <div class="pc-grid"><section class="pc-card"><h3>Confirmar pago externo</h3><p>Registra únicamente un pago recibido y verificado. Las fechas no marcan un pago como recibido.</p>
        @if(request.PaymentStatus == "NotRequired") { <p class="pc-alert success">Este plan no requiere pago. No se crea un pago ficticio de cero.</p> }
        else if(request.AmountDue <= 0) { <p class="pc-alert success">El importe de esta solicitud ya está confirmado. No hay un saldo pendiente que registrar.</p> } else { <form action="@Url.Action("ConfirmPayment")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="version" value="@request.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><div class="pc-grid"><label>Importe (@request.Plan.Currency)<input type="number" name="amount" step="0.01" min="0.01" value="@request.AmountDue.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)" required /></label><label>Fecha real del pago<input type="date" name="paidOn" value="@Day(Model.Today)" max="@Day(Model.Today)" required /></label></div><label>Reporte que se confirma (opcional)<select name="reportId"><option value="">Pago registrado directamente</option>@foreach(var pendingReport in detail.PaymentReports.Where(p=>p.Status is "Reported" or "InReview")){<option value="@pendingReport.Id">@pendingReport.Reference · @Money(pendingReport.Amount,request.Plan.Currency)</option>}</select></label><label>Método<select name="method" required><option value="Transferencia">Transferencia</option><option value="Efectivo">Efectivo</option><option value="Tarjeta">Tarjeta</option><option value="Otro">Otro</option></select></label><label>Referencia o recibo<input name="reference" maxlength="100" required /></label><label>Verificación / motivo<textarea name="reason" maxlength="500" required></textarea></label><label class="pc-check"><input type="checkbox" name="confirmed" value="true" required /> Confirmo que el importe fue recibido y verificado fuera del sistema.</label><button class="sa-btn sa-btn-primary" type="submit">Confirmar pago recibido</button></form> }</section>
        <section class="pc-card"><h3>Reportes del comprador</h3>@if(detail.PaymentReports.Count == 0){<p class="pc-muted">No hay reportes. Un reporte no equivale a un pago confirmado.</p>}@foreach(var report in detail.PaymentReports){<article class="pc-event"><strong>@Money(report.Amount,request.Plan.Currency)</strong><span>@report.PaidOn.ToString("dd/MM/yyyy") · @report.Method</span><span>@report.Reference · @Label(report.Status)</span><p>@report.Notes</p>@if(!string.IsNullOrEmpty(report.Resolution)){<p>@report.Resolution</p>}@if(report.Status is "Reported" or "InReview"){<form action="@Url.Action("ReportDecision")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="reportId" value="@report.Id" /><input type="hidden" name="version" value="@report.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><label>Revisión del reporte<select name="decision"><option value="InReview">En revisión</option><option value="Rejected">Rechazar comprobante</option></select></label><label>Motivo<input name="reason" required maxlength="500" /></label><button class="sa-btn" type="submit">Registrar revisión</button></form>}</article>}</section></div>
        <section class="pc-card"><h3>Pagos registrados</h3>@if(detail.Payments.Count == 0){<p class="pc-muted">Todavía no hay pagos confirmados.</p>}@foreach(var payment in detail.Payments){<div class="pc-event"><div><strong>@Money(payment.Amount,request.Plan.Currency)</strong> · @payment.PaidOn.ToString("dd/MM/yyyy") · @payment.Method<p>@payment.Reference · @(payment.VoidedAt.HasValue ? "Anulado" : "Confirmado")</p></div>@if(!payment.VoidedAt.HasValue){<form action="@Url.Action("VoidPayment")" method="post" class="pc-form pc-inline">@Html.AntiForgeryToken()<input type="hidden" name="requestId" value="@request.Id" /><input type="hidden" name="paymentId" value="@payment.Id" /><input type="hidden" name="version" value="@payment.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><label>Motivo de anulación<input name="reason" required maxlength="500" /></label><button type="submit" class="sa-btn">Anular pago del portal</button></form>}</div>}</section>
        <section class="pc-card"><h3>Historial de decisiones</h3>@if(detail.Decisions.Count == 0){<p class="pc-muted">Sin decisiones registradas.</p>}@foreach(var decision in detail.Decisions){<article class="pc-event"><strong>@Label(decision.Decision)</strong><span>@At(decision.CreatedAt) RD</span><p>@decision.Message</p></article>}</section>
    }
    else if(Model.Tab == "Solicitudes" || Model.Tab == "Compradores")
    {
        <form method="get" class="pc-filters"><input type="hidden" name="tab" value="@Model.Tab" /><label>Buscar<input name="q" value="@Model.Search" maxlength="150" placeholder="Empresa o correo" /></label><label>Estado<select name="status"><option value="">Todos</option>@foreach(var state in Model.Tab == "Compradores" ? new[]{"Active","Suspended"} : new[]{"Submitted","InReview","NeedsInformation","Approved","Rejected","Cancelled"}){<option value="@state" selected="@(Model.Status == state)">@Label(state)</option>}</select></label><button class="sa-btn" type="submit">Filtrar</button></form>
        @if(Model.Requests is {} requests){<section class="pc-card"><h2>Solicitudes recibidas</h2><div class="pc-table"><table><thead><tr><th>Empresa / comprador</th><th>Plan</th><th>Solicitud</th><th>Pago</th><th>Recibida</th><th>Acción</th></tr></thead><tbody>@foreach(var item in requests.Items){<tr><td><strong>@item.BusinessName</strong><br />@item.Email</td><td>@item.Request.Plan.Name<br />@Money(item.Request.Plan.MonthlyPrice,item.Request.Plan.Currency)</td><td><span class="pc-badge">@Label(item.Request.Status)</span></td><td>@Label(item.Request.PaymentStatus)</td><td>@At(item.Request.CreatedAt)</td><td><a class="sa-btn" href="@Url.Action("Index",new{requestId=item.Request.Id})">Revisar</a></td></tr>}@if(requests.Items.Count==0){<tr><td colspan="6">No hay solicitudes con estos filtros.</td></tr>}</tbody></table></div><div class="pc-pagination"><span>@requests.Total solicitudes</span>@if(requests.Page>1){<a href="@Url.Action("Index",new{tab=Model.Tab,q=Model.Search,status=Model.Status,page=requests.Page-1})">Anterior</a>}@if(requests.Page*requests.PageSize<requests.Total){<a href="@Url.Action("Index",new{tab=Model.Tab,q=Model.Search,status=Model.Status,page=requests.Page+1})">Siguiente</a>}</div></section>}
        @if(Model.Users is {} users){<section class="pc-card"><h2>Compradores de la web</h2><div class="pc-table"><table><thead><tr><th>Empresa / correo</th><th>Correo</th><th>Estado</th><th>Registrada</th><th>Administrar</th></tr></thead><tbody>@foreach(var user in users.Items){<tr><td><strong>@user.BusinessName</strong><br />@user.Email</td><td>@MailStatus(user.EmailConfirmed, user.EmailConfirmationRequired)</td><td>@Label(user.Status)</td><td>@At(user.CreatedAt)</td><td><form action="@Url.Action("UserStatus")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@user.Id" /><input type="hidden" name="version" value="@user.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><input type="hidden" name="status" value="@(user.Status=="Suspended"?"Active":"Suspended")" /><label>Motivo<input name="reason" maxlength="500" required /></label><button class="sa-btn" type="submit">@(user.Status=="Suspended"?"Reactivar cuenta web":"Suspender cuenta web")</button></form></td></tr>}@if(users.Items.Count==0){<tr><td colspan="5">No hay compradores con estos filtros.</td></tr>}</tbody></table></div><div class="pc-pagination"><span>@users.Total compradores</span>@if(users.Page>1){<a href="@Url.Action("Index",new{tab=Model.Tab,q=Model.Search,status=Model.Status,page=users.Page-1})">Anterior</a>}@if(users.Page*users.PageSize<users.Total){<a href="@Url.Action("Index",new{tab=Model.Tab,q=Model.Search,status=Model.Status,page=users.Page+1})">Siguiente</a>}</div></section>}
    }
    else if(Model.Tab == "Catálogo web")
    {
        <section class="pc-card"><h2>Planes activos disponibles para publicar</h2><p>Precios y límites proceden de <a href="/SuperAdmin/Planes">Planes y límites</a>. Aquí decides su presentación comercial; un plan interno no se publica por estar activo.</p>@if(Model.Catalog.Count==0){<p class="pc-empty">No hay planes activos disponibles o el catálogo no se pudo consultar.</p>}<div class="pc-grid">@foreach(var entry in Model.Catalog){<form action="@Url.Action("Catalog")" method="post" class="pc-card pc-form">@Html.AntiForgeryToken()<input type="hidden" name="code" value="@entry.Plan.Code" /><input type="hidden" name="version" value="@entry.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><h3>@entry.Plan.Name</h3>@if(!entry.SourceActive){<p class="pc-alert">Plan de origen inactivo. Sólo se puede retirar su publicación; no admite nuevas solicitudes.</p>}<strong>@Money(entry.Plan.MonthlyPrice,entry.Plan.Currency) / mes</strong><p>@Limit(entry.Plan.MaxStores) comercios · @Limit(entry.Plan.MaxPilots) pilotos · @Limit(entry.Plan.MaxOrdersPerMonth) órdenes/mes</p><label class="pc-check"><input name="isPublished" value="true" type="checkbox" checked="@entry.IsPublished" disabled="@(!entry.SourceActive)" /> Publicar en la web</label><label>Descripción pública<textarea name="description" maxlength="1000" required>@entry.Plan.Description</textarea></label><label>Orden de presentación<input type="number" name="sortOrder" value="@entry.SortOrder" min="0" max="10000" /></label><label class="pc-check"><input type="checkbox" name="featured" value="true" checked="@entry.Plan.Featured" /> Destacar este plan</label><button class="sa-btn sa-btn-primary" type="submit">Guardar presentación</button></form>}</div></section>
    }
    else if(Model.Tab == "Versiones Android" && Model.Artifacts is {} artifacts)
    {
        <section class="pc-card"><h2>Subir un APK release firmado</h2><p>El archivo se almacena en privado y entra en cuarentena. Subirlo no lo publica ni cambia las apps instaladas. El APK histórico de GitHub conserva su enlace público.</p>@if(!artifacts.StorageConfigured || !artifacts.ValidationToolsConfigured){<div class="pc-alert">Configura el almacenamiento privado y las herramientas de validación antes de publicar una versión.</div>}<form action="@Url.Action("Upload")" method="post" enctype="multipart/form-data" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="operationId" value="@Guid.NewGuid()" /><label>APK firmado<input name="file" type="file" accept=".apk" required /></label><div class="pc-grid"><label>Commit del build<input name="sourceCommit" pattern="[a-fA-F0-9]{40}" maxlength="40" required /></label><label>URL pública del build<input name="publicBaseUrl" type="url" value="https://envirapido.com" required /></label></div><label>Notas de versión<textarea name="notes" maxlength="2000"></textarea></label><button class="sa-btn sa-btn-primary" type="submit">Subir a cuarentena</button></form></section>
        <section class="pc-card"><h2>Versiones y validación</h2>@if(artifacts.Items.Count==0){<p class="pc-empty">Todavía no se han subido versiones privadas.</p>}@foreach(var artifact in artifacts.Items){<article class="pc-artifact"><div class="pc-title-row"><h3>@(artifact.VersionName ?? artifact.OriginalFileName) @(artifact.VersionCode.HasValue?$"({artifact.VersionCode})":"")</h3><span class="pc-badge">@Label(artifact.State) @(artifact.IsCurrent?"· Vigente":"")</span></div><p>@((artifact.Bytes/1024d/1024d).ToString("N1")) MiB · @At(artifact.CreatedAt) RD</p><dl class="pc-details"><dt>SHA-256</dt><dd><code>@artifact.Sha256</code></dd><dt>Paquete</dt><dd>@(artifact.PackageName ?? "Pendiente de validar")</dd><dt>Certificado</dt><dd><code>@(artifact.CertificateSha256 ?? "Pendiente de validar")</code></dd><dt>Resultado</dt><dd>@(artifact.ValidationMessage ?? "Validación pendiente")</dd><dt>Notas</dt><dd>@artifact.Notes</dd></dl><div class="pc-grid">@if(artifact.State=="Quarantined"){<form action="@Url.Action("ValidateArtifact")" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@artifact.Id" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><button class="sa-btn" type="submit">Validar firma, paquete y versión</button></form>}@if(artifact.State=="Validated"){<form action="@Url.Action("PublishArtifact")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@artifact.Id" /><input type="hidden" name="expectedVersion" value="@artifact.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><label>Motivo / evidencia QA<input name="reason" required maxlength="500" /></label><label class="pc-check"><input type="checkbox" name="qaApproved" value="true" required /> Confirmo la QA funcional y la URL de este build.</label><button class="sa-btn sa-btn-primary" type="submit">Publicar esta versión</button></form>}@if(artifact.State=="Published"){<form action="@Url.Action("WithdrawArtifact")" method="post" class="pc-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@artifact.Id" /><input type="hidden" name="expectedVersion" value="@artifact.Version" /><input type="hidden" name="operationId" value="@Guid.NewGuid()" /><label>Motivo para retirar<input name="reason" required maxlength="500" /></label><button class="sa-btn" type="submit">Retirar de nuevas descargas</button></form>}</div></article>}</section>
    }
    else if(Model.Tab == "Auditoría" && Model.Audit is {} audit)
    {
        <section class="pc-card"><h2>Actividad del portal</h2><div class="pc-table"><table><thead><tr><th>Fecha RD</th><th>Operador</th><th>Acción</th><th>Registro</th><th>Detalle</th></tr></thead><tbody>@foreach(var item in audit.Items){<tr><td>@At(item.CreatedAt)</td><td>@item.Actor</td><td>@item.Action</td><td>@item.Entity · @item.EntityId</td><td>@item.Detail</td></tr>}@if(audit.Items.Count==0){<tr><td colspan="5">No hay actividad registrada.</td></tr>}</tbody></table></div><div class="pc-pagination"><span>@audit.Total eventos</span>@if(audit.Page>1){<a href="@Url.Action("Index",new{tab=Model.Tab,page=audit.Page-1})">Anterior</a>}@if(audit.Page*audit.PageSize<audit.Total){<a href="@Url.Action("Index",new{tab=Model.Tab,page=audit.Page+1})">Siguiente</a>}</div></section>
    }
}
