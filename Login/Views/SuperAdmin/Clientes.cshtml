@model Login.ViewModels.SuperAdmin.ClientesIndexVm
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Empresas"; }
<div class="sa-page-head">
<div>
<h2>Empresas</h2>
<p>Gestiona las cuentas, suscripciones y límites de cada empresa.</p>
</div>
<a class="sa-btn sa-btn-primary" asp-action="CrearCliente">+ Crear empresa</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Ok)) { <div class="sa-notice" role="status">@Model.Ok</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="sa-notice sa-notice-error" role="alert">@Model.Error</div> }
<form class="sa-toolbar" method="get" asp-action="Clientes">
<div class="sa-field sa-field-wide">
<label for="q">Buscar empresas</label>
<input name="q" id="q" type="search" value="@Model.Q" placeholder="Nombre, correo o plan" maxlength="120" />
</div>
<button class="sa-btn" type="submit">Buscar</button>
<a class="sa-btn" asp-action="Clientes">Limpiar</a>
</form>
<div class="sa-card">
<div class="sa-table-scroll" role="region" aria-label="Directorio de empresas" tabindex="0">
<table class="sa-table">
<thead>
<tr>
<th>Empresa / gestor</th>
<th>Plan</th>
<th>Comercios</th>
<th>Pilotos</th>
<th>Suscripción</th>
<th>Estado operativo</th>
<th>Acción</th>
</tr>
</thead>
<tbody>
@foreach (var c in Model.Clientes) {
    var shops = c.MaxTiendas > 0 ? Math.Clamp((int)((double)c.TiendasCount / c.MaxTiendas * 100), 0, 100) : 0;
    var pilots = c.MaxPilotos > 0 ? Math.Clamp((int)((double)c.PilotosCount / c.MaxPilotos * 100), 0, 100) : 0;
    <tr>
<td>
<a class="sa-row-title" asp-action="DetalleCliente" asp-route-id="@c.Id">@c.NombreComercial</a>
<div class="sa-sub">#@c.Id · @(c.GestorEmail ?? "Sin gestor asignado")</div>
</td>
<td>
<span class="sa-pill sa-pill-info">@c.PlanNombre</span>
</td>
    <td>
<div class="sa-sub">@c.TiendasCount / @(c.MaxTiendas == 0 ? "Ilimitado" : c.MaxTiendas.ToString())</div>
<div class="sa-progress">
<span style="width:@shops%">
</span>
</div>
</td>
    <td>
<div class="sa-sub">@c.PilotosCount / @(c.MaxPilotos == 0 ? "Ilimitado" : c.MaxPilotos.ToString())</div>
<div class="sa-progress">
<span style="width:@pilots%">
</span>
</div>
</td>
    <td>
<div>@(c.FechaFinPlan?.ToString("dd/MM/yyyy") ?? "Sin fecha establecida")</div>
<div class="sa-sub">@(c.EsTrial == true ? "Prueba" : "Suscripción")</div>
</td>
    <td>
<span class="sa-pill @(c.Activo ? "sa-pill-ok" : "sa-pill-bad")">@c.Estado</span>
</td>
<td>
<a class="sa-btn sa-btn-small" asp-action="DetalleCliente" asp-route-id="@c.Id">Ver empresa</a>
</td>
</tr>
}
@if (Model.Clientes.Count == 0) { <tr>
<td colspan="7">
<div class="sa-empty">
<strong>No hay empresas para mostrar</strong>Crea una empresa o cambia la búsqueda.</div>
</td>
</tr> }
</tbody>
</table>
</div>
<div class="sa-pagination">
<span>@Model.Total empresas · Página @Model.Pagina</span>
<div class="sa-actions">@if(Model.Pagina > 1) { <a class="sa-btn sa-btn-small" asp-action="Clientes" asp-route-q="@Model.Q" asp-route-pagina="@(Model.Pagina - 1)">← Anterior</a> }@if(Model.Pagina * 20 < Model.Total) { <a class="sa-btn sa-btn-small" asp-action="Clientes" asp-route-q="@Model.Q" asp-route-pagina="@(Model.Pagina + 1)">Siguiente →</a> }</div>
</div>
</div>
