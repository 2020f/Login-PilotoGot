@model Login.ViewModels.SuperAdmin.PlanesIndexVm
@using System.Globalization
@{ Layout = "_LayoutSuperAdmin"; ViewData["Title"] = "Planes y límites"; var money = CultureInfo.GetCultureInfo("es-DO"); }
<div class="sa-page-head">
<div>
<h2>Planes y límites</h2>
<p>Define la oferta comercial y la capacidad disponible para cada empresa.</p>
</div>
<a class="sa-btn sa-btn-primary" asp-action="CrearPlan">+ Crear plan</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Ok)) { <div class="sa-notice" role="status">@Model.Ok</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="sa-notice sa-notice-error" role="alert">@Model.Error</div> }
<div class="sa-notice">Cero significa ilimitado. Las excepciones específicas de cada empresa tienen prioridad. Los cambios se validan contra el uso actual para conservar la operación.</div>
<div class="sa-grid-3">
@foreach (var p in Model.Planes) {
    <article class="sa-card sa-plan-card">
<div class="sa-section-head">
<h3 class="sa-plan-name">@p.Nombre</h3>
<span class="sa-pill @(p.Activo ? "sa-pill-ok" : "sa-pill-bad")">@(p.Activo ? "Activo" : "Inactivo")</span>
</div>
<div class="sa-plan-price">RD$@p.PrecioMensual.ToString("N2", money) <small>/ mes</small>
</div>
<ul class="sa-plan-limits">
<li>
<span>Comercios activos</span>
<strong>@(p.MaxTiendas == 0 ? "Ilimitados" : p.MaxTiendas.ToString())</strong>
</li>
<li>
<span>Pilotos activos</span>
<strong>@(p.MaxPilotos == 0 ? "Ilimitados" : p.MaxPilotos.ToString())</strong>
</li>
<li>
<span>Órdenes por mes</span>
<strong>@(p.MaxOrdenesPorMes == 0 ? "Ilimitadas" : p.MaxOrdenesPorMes.ToString())</strong>
</li>
</ul>
<div class="sa-actions">
<a class="sa-btn sa-btn-primary" asp-action="EditarPlan" asp-route-id="@p.Id">Editar plan</a>
<form method="post" asp-action="TogglePlan">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" />
<button class="sa-btn" type="submit">@(p.Activo ? "Desactivar" : "Activar")</button>
</form>
</div>
<p class="sa-sub sa-section-gap">Desactivar un plan impide nuevas contrataciones; conserva las empresas que ya lo utilizan.</p>
</article>
}
</div>
@if(Model.Planes.Count == 0) { <div class="sa-card sa-empty">
<strong>Aún no hay planes</strong>Crea tu primer plan para registrar empresas.</div> }
