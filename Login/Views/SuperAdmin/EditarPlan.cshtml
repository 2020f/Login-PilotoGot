@model Login.ViewModels.SuperAdmin.PlanEditVm
@{
    Layout = "_LayoutSuperAdmin";
    ViewData["Title"] = "Editar Plan";
    ViewData["PageTitle"] = "Editar Plan";
}

<div class="sa-card sa-card-pad" style="max-width:900px; margin:0 auto;">
    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
        <div>
            <div class="sa-row-title" style="font-size:18px;">Editar Plan</div>
            <div class="sa-sub">Actualiza precio, límites y estado.</div>
        </div>

        <a class="sa-btn" href="/SuperAdmin/Planes">← Volver</a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="sa-card sa-card-pad" style="margin-top:14px; border-color:#fecdd3;">
            <div class="sa-pill sa-pill-bad">Revisa los campos.</div>
            <div style="margin-top:10px; color:#b91c1c;">
                @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>• @e.ErrorMessage</div>
                }
            </div>
        </div>
    }

    <form asp-action="EditarPlan" asp-controller="SuperAdmin" method="post" style="margin-top:16px;">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
            <div>
                <div class="sa-sub" style="font-weight:800; color:#334155;">Nombre</div>
                <input asp-for="Nombre"
                       style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0;" />
                <span asp-validation-for="Nombre" class="sa-sub" style="color:#e11d48;"></span>
            </div>

            <div>
                <div class="sa-sub" style="font-weight:800; color:#334155;">Precio Mensual</div>
                <input asp-for="PrecioMensual" type="number" step="0.01"
                       style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0;" />
                <span asp-validation-for="PrecioMensual" class="sa-sub" style="color:#e11d48;"></span>
            </div>

            <div>
                <div class="sa-sub" style="font-weight:800; color:#334155;">Max Tiendas</div>
                <input asp-for="MaxTiendas" type="number"
                       style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0;" />
                <span asp-validation-for="MaxTiendas" class="sa-sub" style="color:#e11d48;"></span>
            </div>

            <div>
                <div class="sa-sub" style="font-weight:800; color:#334155;">Max Pilotos</div>
                <input asp-for="MaxPilotos" type="number"
                       style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0;" />
                <span asp-validation-for="MaxPilotos" class="sa-sub" style="color:#e11d48;"></span>
            </div>

            <div style="grid-column: 1 / -1;">
                <div class="sa-sub" style="font-weight:800; color:#334155;">Max Órdenes por mes</div>
                <input asp-for="MaxOrdenesPorMes" type="number"
                       style="width:100%; padding:12px; border-radius:12px; border:1px solid #e2e8f0;" />
                <span asp-validation-for="MaxOrdenesPorMes" class="sa-sub" style="color:#e11d48;"></span>
            </div>

            <div style="grid-column: 1 / -1; display:flex; align-items:center; gap:10px; margin-top:6px;">
                <input asp-for="Activo" style="transform:scale(1.15);" />
                <div style="font-weight:800;">Activo</div>
            </div>
        </div>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:16px;">
            <a class="sa-btn" href="/SuperAdmin/Planes">Cancelar</a>
            <button class="sa-btn sa-btn-primary" type="submit">💾 Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
