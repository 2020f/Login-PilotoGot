@{
    Layout = null;
    ViewData["Title"] = "Servicio no disponible";
    var motivo = (ViewBag.Motivo as string) ?? "Suspendido";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Envirapido</title>
    <partial name="_BrandHead" />
</head>
<body>
<div style="max-width: 720px; margin: 40px auto; padding: 0 20px;">
    <img class="envi-brand-logo envi-card-brand" src="~/branding/logo-original.png" asp-append-version="true" alt="Envirapido" width="190" height="65" />
    <h2 style="margin-bottom:10px;">Servicio no disponible</h2>

    <div style="border:1px solid #dc3545; padding:15px; border-radius:8px; background:#fff5f5;">
        <b style="color:#dc3545;">Tu cuenta está: @motivo</b>
        <p style="margin-top:10px;">
            No puedes usar el sistema en este estado. Si crees que es un error, contacta al administrador.
        </p>
    </div>

    <div style="margin-top:15px;">
        @if(User.IsInRole("Gestor")){<p><a href="/Suscripcion">Consultar suscripción y solicitar cambio de plan</a></p>}
        <!-- Logout por Identity (normal en proyectos con Identity UI) -->
        <form method="post" action="/Identity/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" style="background:#dc3545; color:white; border:0; padding:10px 14px; border-radius:8px;">
                Cerrar sesión
            </button>
        </form>
    </div>
</div>
</body>
</html>
