@model Login.ViewModels.Tienda.TiendaCreateVm
@{
    ViewData["Title"] = "Nueva Tienda";
    Layout = "_LayoutGestor";
}

<div class="pg-card pg-form-card" style="max-width:640px;">
    <div class="pg-card-head-row">
        <div>
            <div class="pg-card-title">Nueva Tienda</div>
            <div class="pg-card-sub">Registra la tienda y crea su usuario de acceso (rol Cliente).</div>
        </div>
        <a asp-action="Tiendas" class="pg-btn pg-btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Volver
        </a>
    </div>

    <form asp-action="CrearTienda" method="post">
        @Html.AntiForgeryToken()

        <div style="font-size:12px;font-weight:600;color:var(--pg-muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:10px;">
            Datos de la tienda
        </div>

        <div class="pg-grid-2">
            <div class="pg-field">
                <label class="pg-label">Nombre</label>
                <input class="pg-input" asp-for="Nombre" placeholder="Ej: Pizza Hut Los Prados" />
                <span class="pg-val" asp-validation-for="Nombre"></span>
            </div>
            <div class="pg-field">
                <label class="pg-label">Teléfono</label>
                <input class="pg-input" asp-for="Telefono" placeholder="809-555-0202" />
                <span class="pg-val" asp-validation-for="Telefono"></span>
            </div>
        </div>

        <div class="pg-field" style="margin-top:12px;">
            <label class="pg-label">Dirección</label>
            <input class="pg-input" asp-for="Direccion" placeholder="Ej: Calle 5 #10" />
            <span class="pg-val" asp-validation-for="Direccion"></span>
        </div>

        <hr class="pg-section-sep" />

        <div style="font-size:12px;font-weight:600;color:var(--pg-muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:10px;">
            Usuario de acceso — Interfaz Tienda
        </div>

        <div class="pg-grid-2">
            <div class="pg-field">
                <label class="pg-label">Email</label>
                <input class="pg-input" asp-for="EmailCliente" placeholder="correo@tienda.com" />
                <span class="pg-val" asp-validation-for="EmailCliente"></span>
            </div>
            <div class="pg-field">
                <label class="pg-label">Password</label>
                <input class="pg-input" asp-for="PasswordCliente" type="password" placeholder="Mínimo 6 caracteres" />
                <span class="pg-val" asp-validation-for="PasswordCliente"></span>
            </div>
        </div>

        <div class="pg-form-actions">
            <button type="submit" class="pg-btn pg-btn-primary">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M20 6L9 17l-5-5"/>
                </svg>
                Crear tienda + usuario
            </button>
            <a asp-action="Tiendas" class="pg-btn pg-btn-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
