@model Login.ViewModels.Supervisor.PilotoEditVm
@using Login.Domain.Enums
@{
    ViewData["Title"] = "Editar Piloto";
    Layout = "_LayoutGestor";
}

<div class="pg-card pg-form-card" style="max-width:640px;">
    <div class="pg-card-head-row">
        <div>
            <div class="pg-card-title">Editar Piloto</div>
            <div class="pg-card-sub">Actualiza datos, estado y activación.</div>
        </div>
        <a asp-action="Pilotos" class="pg-btn pg-btn-outline">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Volver
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.EmailPiloto))
    {
        <div class="pg-info-block">
            <div class="pg-info-lbl">Email de acceso</div>
            <div class="pg-info-val">@Model.EmailPiloto</div>
        </div>
    }

    <form method="post" asp-action="EditarPiloto">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="pg-grid-2">
            <div class="pg-field">
                <label class="pg-label">Nombre</label>
                <input class="pg-input" asp-for="Nombre" />
                <span class="pg-val" asp-validation-for="Nombre"></span>
            </div>
            <div class="pg-field">
                <label class="pg-label">Teléfono</label>
                <input class="pg-input" asp-for="Telefono" />
                <span class="pg-val" asp-validation-for="Telefono"></span>
            </div>
        </div>

        <div class="pg-grid-2" style="margin-top:12px;">
            <div class="pg-field">
                <label class="pg-label">Estado</label>
                <select class="pg-select" asp-for="Estado">
                    <option value="@EstadoPiloto.Disponible">Disponible</option>
                    <option value="@EstadoPiloto.Ocupado">Ocupado</option>
                    <option value="@EstadoPiloto.Inactivo">Inactivo</option>
                </select>
            </div>
            <div class="pg-field" style="justify-content:flex-end;padding-bottom:2px;">
                <label class="pg-check" style="margin-top:auto;">
                    <input class="pg-check-input" type="checkbox" asp-for="Activo" />
                    <span class="pg-check-label">Activo</span>
                </label>
            </div>
        </div>

        <div class="pg-form-actions">
            <button class="pg-btn pg-btn-primary" type="submit">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                </svg>
                Guardar cambios
            </button>

            <form method="post" asp-action="EliminarPiloto" style="display:inline;margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="pg-btn pg-btn-danger" type="submit">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
                        <path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                    </svg>
                    Eliminar
                </button>
            </form>

            <a asp-action="Pilotos" class="pg-btn pg-btn-ghost">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
