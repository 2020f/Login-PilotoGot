@model Login.ViewModels.Supervisor.PilotoCreateVm
@{
    ViewData["Title"] = "Nuevo Piloto";
    Layout = "_LayoutGestor";
}

<div class="pg-card p-4">

    <div class="d-flex align-items-start justify-content-between mb-3">
        <div>
            <div class="h4 fw-bold mb-1">Nuevo Piloto</div>
            <div class="text-secondary fw-semibold">Crea el piloto y su usuario de acceso (rol Piloto).</div>
        </div>

        <a asp-action="Pilotos" class="btn btn-outline-secondary fw-bold">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>

    <form method="post" asp-action="CrearPiloto" class="row g-3">
        @Html.AntiForgeryToken()

        <div class="col-md-6">
            <label class="form-label fw-bold">Nombre</label>
            <input class="form-control" asp-for="Nombre" placeholder="Ej: Juan Perez" />
            <span class="text-danger" asp-validation-for="Nombre"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Teléfono</label>
            <input class="form-control" asp-for="Telefono" placeholder="809-000-1111" />
            <span class="text-danger" asp-validation-for="Telefono"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Email (login del piloto)</label>
            <input class="form-control" asp-for="EmailPiloto" placeholder="piloto@correo.com" />
            <span class="text-danger" asp-validation-for="EmailPiloto"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold">Password</label>
            <input class="form-control" asp-for="PasswordPiloto" type="password" placeholder="Mínimo 6 caracteres" />
            <span class="text-danger" asp-validation-for="PasswordPiloto"></span>
        </div>

        <div class="col-12 d-flex gap-2 mt-2">
            <button class="btn btn-dark fw-bold">
                <i class="bi bi-check2-circle"></i> Crear piloto
            </button>

            <a asp-action="Pilotos" class="btn btn-link fw-bold text-decoration-none text-secondary">
                Cancelar
            </a>
        </div>
    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
