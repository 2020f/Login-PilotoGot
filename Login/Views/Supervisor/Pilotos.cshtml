@model List<Login.Domain.Entities.Piloto>
@using Login.Domain.Enums
@{
    ViewData["Title"] = "Flota de Pilotos";
    Layout = "_LayoutGestor";
}

@if (!string.IsNullOrWhiteSpace(ViewBag.Ok as string))
{
    <div class="pg-alert pg-alert-ok" style="margin-bottom:12px;">
        <span class="pg-alert-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
        <div>@ViewBag.Ok</div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
{
    <div class="pg-alert pg-alert-bad" style="margin-bottom:12px;">
        <span class="pg-alert-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
        <div>@ViewBag.Error</div>
    </div>
}

<div class="pg-toolbar">
    <div class="pg-toolbar-left">
        <div class="pg-toolbar-title">Gestión de Pilotos</div>
        <div class="pg-toolbar-sub">Administra la flota y credenciales de acceso.</div>
    </div>
    <a class="pg-btn pg-btn-primary" asp-action="CrearPiloto">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14"/>
        </svg>
        Nuevo Piloto
    </a>
</div>

<div class="pg-grid">
    @foreach (var p in Model)
    {
        var statusClass = p.Estado == EstadoPiloto.Disponible ? "ok"
            : p.Estado == EstadoPiloto.Ocupado ? "busy"
            : "";

        var nombreSafe = (p?.Nombre ?? "").Trim();
        var inicial    = !string.IsNullOrEmpty(nombreSafe) ? nombreSafe.Substring(0, 1).ToUpper() : "?";

        <div class="pg-card pg-pilotbox">
            <div class="pg-pilotbox-top">
                <div class="pg-pilotbox-left">
                    <div class="pg-big-avatar">@inicial</div>
                    <div>
                        <div class="pg-pilot-label">@p.Nombre</div>
                        <div class="pg-pilot-meta">@p.Telefono</div>
                    </div>
                </div>
                <div class="pg-pill-status @statusClass">@p.Estado</div>
            </div>

            <div class="pg-pilotbox-mid">
                <div>Órdenes activas: <b>0</b></div>
                <a class="pg-link" asp-action="EditarPiloto" asp-route-id="@p.Id">
                    Editar
                </a>
            </div>
        </div>
    }
</div>
