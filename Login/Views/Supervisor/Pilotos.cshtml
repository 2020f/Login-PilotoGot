@model List<Login.Domain.Entities.Piloto>
@using Login.Domain.Enums
@{
    ViewData["Title"] = "Flota de Pilotos";
    Layout = "_LayoutGestor";
}

@if (!string.IsNullOrWhiteSpace(ViewBag.Ok))
{
    <div class="alert alert-success">@ViewBag.Ok</div>
}
@if (!string.IsNullOrWhiteSpace(ViewBag.Error))
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="d-flex align-items-start justify-content-between mb-3">
    <div>
        <div class="h4 fw-bold mb-1">Gestión de Pilotos</div>
        <div class="text-secondary fw-semibold">Administre su flota y credenciales de acceso.</div>
    </div>

    <a class="btn btn-link fw-bold text-decoration-none" asp-action="CrearPiloto">
        <i class="bi bi-plus-lg me-2"></i> Nuevo Piloto
    </a>
</div>

<div class="pg-grid">
    @foreach (var p in Model)
    {
        var statusClass = p.Estado == EstadoPiloto.Disponible ? "ok"
        : p.Estado == EstadoPiloto.Ocupado ? "busy"
        : "";

        var nombreSafe = (p?.Nombre ?? "").Trim();
        var inicial = !string.IsNullOrEmpty(nombreSafe)
        ? nombreSafe.Substring(0, 1).ToUpper()
        : "?";

        <div class="pg-card pg-pilotbox">
            <div class="pg-pilotbox-top">
                <div class="pg-pilotbox-left">
                    <div class="pg-big-avatar">@inicial</div>
                    <div>
                        <div class="fw-bold">@p.Nombre</div>
                        <div class="text-secondary fw-semibold">@p.Telefono</div>
                    </div>
                </div>

                <div class="pg-pill-status @statusClass">
                    @p.Estado
                </div>
            </div>

            <div class="pg-pilotbox-mid">
                <div>
                    Órdenes Activas:
                    <span class="fw-black">0</span>
                </div>

                <a class="pg-link" asp-action="EditarPiloto" asp-route-id="@p.Id">
                    Editar
                </a>
            </div>
        </div>
    }
</div>
