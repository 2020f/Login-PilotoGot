@model Login.ViewModels.Supervisor.OrdenesIndexVm
@{
    ViewData["Title"] = "Despacho en Vivo";
    Layout = "_LayoutGestor";
}  

<div class="pg-page">

    @if (!string.IsNullOrWhiteSpace(Model.Ok))
    {
        <div class="alert alert-success">@Model.Ok</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <!-- FILTROS FIJOS -->
    <div class="pg-filters-sticky">
        <div class="pg-card pg-filters mb-3">
            <form method="get" asp-action="Ordenes" class="d-flex align-items-center gap-3 w-100">

                <div class="pg-filter-block">
                    <select class="pg-filter-select" asp-for="TiendaId" asp-items="Model.Tiendas">
                        <option value="">Todas las Tiendas</option>
                    </select>
                    <i class="bi bi-chevron-down text-secondary"></i>
                </div>

                <div class="pg-filter-block">
                    <select class="pg-filter-select" asp-for="PilotoId" asp-items="Model.Pilotos"></select>
                    <i class="bi bi-chevron-down text-secondary"></i>
                </div>

                <div class="pg-filter-block">
                    <select class="pg-filter-select" asp-for="Estado" asp-items="Model.Estados"></select>
                    <i class="bi bi-chevron-down text-secondary"></i>
                </div>

                <!-- fecha -->
                <div class="pg-filter-block">
                    <input class="pg-filter-input"
                           asp-for="Fecha"
                           type="date" />
                    <i class="bi bi-calendar3 text-secondary"></i>
                </div>


                <div class="pg-search">
                    <i class="bi bi-search text-secondary"></i>
                    <input asp-for="NumeroOrdenA" type="number" placeholder="Buscar por #Orden ID..." />
                </div>

                <button class="d-none" type="submit"></button>
            </form>

        </div>
    </div>

    <!-- SOLO ESTO SCROLLEA -->
    <div class="pg-orders-scroll">
        <div class="d-flex flex-column gap-3">
            @foreach (var o in Model.Ordenes)
            {
                // ====== helpers seguros ======
                var pilotoSafe = (o.PilotoNombre ?? "").Trim();
                var pilotoInicial = !string.IsNullOrEmpty(pilotoSafe) ? pilotoSafe.Substring(0, 1).ToUpper() : "?";

                var pilotoTel = string.IsNullOrWhiteSpace(o.PilotoTelefono) ? "—" : o.PilotoTelefono;

                var tiendaDir = string.IsNullOrWhiteSpace(o.TiendaDireccion) ? "—" : o.TiendaDireccion;
                var tiendaTel = string.IsNullOrWhiteSpace(o.TiendaTelefono) ? "—" : o.TiendaTelefono;
                var notasTxt = string.IsNullOrWhiteSpace(o.Notas) ? "—" : o.Notas;

                <div class="pg-card pg-order">

                    <!-- LEFT -->
                    <div class="pg-order-left">
                        <div class="pg-order-label">ORDEN ID (A)</div>
                        <div class="pg-order-id">ORD-@o.NumeroOrdenA</div>

                        @{
                            var estadoTxt = o.Estado ?? "";

                            // Ajusta si tus estados son "Asignada / Recolectada / Entregada..."
                            var isRecolectando =
                            estadoTxt.Contains("Recolect", System.StringComparison.OrdinalIgnoreCase) ||
                            estadoTxt.Contains("Recolectada", System.StringComparison.OrdinalIgnoreCase);

                            // si no es recolectando, badge gris como tu UI
                            var badgeClass = isRecolectando ? "" : "gray";
                        }

                        <div class="pg-status @badgeClass">
                            <i class="bi bi-box-seam"></i>
                            <span>@(string.IsNullOrWhiteSpace(o.Estado) ? "En Proceso" : o.Estado)</span>
                        </div>

                        <div class="pg-time">
                            <i class="bi bi-clock"></i>
                            <span>@o.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                        </div>
                    </div>

                    <!-- MID -->
                    <div class="pg-order-mid">
                        <div class="pg-store">
                            <div class="pg-store-ico">
                                <i class="bi bi-shop"></i>
                            </div>

                            <div>
                                <div class="pg-store-name">@o.TiendaNombre</div>

                                <div class="pg-store-meta">
                                    <span><i class="bi bi-geo-alt"></i> <span class="ms-1">@tiendaDir</span></span>
                                    <span><i class="bi bi-telephone"></i> <span class="ms-1">@tiendaTel</span></span>
                                </div>
                            </div>
                        </div>

                        <div class="pg-note">
                            <div class="pg-note-title">NOTA DE LA TIENDA:</div>
                            <div class="pg-note-text">"@notasTxt"</div>
                        </div>
                    </div>

                    <!-- RIGHT -->
                    <div class="pg-order-right">
                        <div class="pg-right-title">PILOTO ASIGNADO</div>

                        @if (!string.IsNullOrWhiteSpace(o.PilotoNombre))
                        {
                            <div class="pg-pilot-card">
                                <div class="pg-pilot-left">
                                    <div class="pg-avatar">@pilotoInicial</div>
                                    <div>
                                        <div class="pg-pilot-name">@o.PilotoNombre</div>
                                        <div class="pg-pilot-phone">@pilotoTel</div>
                                    </div>
                                </div>

                                <a class="pg-edit-ico" asp-action="Pilotos" title="Editar piloto">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="pg-assign-btn"
                                    data-open-assign
                                    data-codigob="@o.CodigoB"
                                    data-ordena="@o.NumeroOrdenA">
                                <i class="bi bi-person-plus"></i>
                                <span>Asignar Piloto</span>
                            </button>

                            <div class="pg-attn">Requiere Atención</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<!-- MODAL -->
<div class="modal fade pg-modal" id="asignarPilotoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:540px;">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="pg-modal-title">Asignar Piloto</div>
                    <div class="pg-modal-sub">
                        Seleccione un piloto disponible para la orden <b id="modalOrdenLabel">ORD-0000</b>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="pg-modal-search">
                    <i class="bi bi-search text-secondary"></i>
                    <input id="pilotSearch" type="text" placeholder="Buscar piloto por nombre..." />
                </div>

                <form id="asignarPilotoForm" method="post" asp-action="AsignarPiloto" class="mt-3">
                    @Html.AntiForgeryToken()

                    <input id="modalCodigoB" type="hidden" name="CodigoB" value="" />
                    <input id="modalPilotoId" type="hidden" name="PilotoId" value="" />

                    <div id="pilotList">
                        @foreach (var p in Model.Pilotos)
                        {
                            var pText = (p.Text ?? "").Trim();
                            var pInicial = !string.IsNullOrEmpty(pText) ? pText.Substring(0, 1).ToUpper() : "?";

                            <div class="pg-pilot-pick"
                                 data-piloto-id="@p.Value"
                                 data-filter="@p.Text">
                                <div class="pg-pick-left">
                                    <div class="pg-pick-avatar">@pInicial</div>
                                    <div>
                                        <div class="fw-bold">@p.Text</div>
                                        <div class="text-secondary fw-semibold" style="font-size:13px;">—</div>
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right text-secondary"></i>
                            </div>
                        }
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link text-secondary fw-bold" data-bs-dismiss="modal">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
</div>
