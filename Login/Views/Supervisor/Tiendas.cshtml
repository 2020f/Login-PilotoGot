@model List<Login.Domain.Entities.Tienda>
@{
    ViewData["Title"] = "Red de Tiendas";
    Layout = "_LayoutGestor";
}

@if (ViewBag.Ok != null)
{
    <div class="pg-alert pg-alert-ok" style="margin-bottom:12px;">
        <span class="pg-alert-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
        <div>@ViewBag.Ok</div>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="pg-alert pg-alert-bad" style="margin-bottom:12px;">
        <span class="pg-alert-ico"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
        <div>@ViewBag.Error</div>
    </div>
}

<div class="pg-toolbar">
    <div class="pg-toolbar-left">
        <div class="pg-toolbar-title">Tiendas Asociadas</div>
        <div class="pg-toolbar-sub">Puntos de recolección registrados.</div>
    </div>
    <a class="pg-btn pg-btn-primary" asp-action="CrearTienda">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
            <path d="M12 5v14M5 12h14"/>
        </svg>
        Nueva Tienda
    </a>
</div>

<div class="pg-table-page">
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead>
                <tr>
                    <th style="width:90px;">ID</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th style="width:160px;">Teléfono</th>
                    <th style="width:80px;">Activo</th>
                    <th style="width:120px;text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" style="text-align:center;color:var(--pg-muted);padding:28px 14px;">
                            No hay tiendas creadas todavía.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td style="color:var(--pg-muted);font-weight:500;">#@t.Id</td>
                            <td style="font-weight:500;">@t.Nombre</td>
                            <td>@t.Direccion</td>
                            <td>@t.Telefono</td>
                            <td>
                                @if (t.Activo)
                                {
                                    <span style="color:#166534;font-weight:500;font-size:12.5px;">Activo</span>
                                }
                                else
                                {
                                    <span style="color:var(--pg-muted);font-size:12.5px;">Inactivo</span>
                                }
                            </td>
                            <td style="text-align:right;">
                                <a class="pg-action-ico" asp-action="EditarTienda" asp-route-id="@t.Id" title="Editar">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                    </svg>
                                </a>
                                @if (t.Activo)
                                {
                                    <form method="post" asp-action="DesactivarTienda" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="pg-action-ico danger" title="Desactivar">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/>
                                                <path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                                            </svg>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
