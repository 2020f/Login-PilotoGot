@model List<Login.Domain.Entities.Tienda>

@{
    ViewData["Title"] = "Tiendas";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">🏪 Tiendas</h2>

    <div class="d-flex gap-2">
        <a class="btn btn-success" asp-action="CrearTienda">
            + Crear tienda
        </a>
        <a class="btn btn-outline-secondary" asp-action="Ordenes">
            Volver a Órdenes
        </a>
    </div>
</div>

@if (ViewBag.Ok != null)
{
    <div class="alert alert-success">@ViewBag.Ok</div>
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No hay tiendas creadas todavía. Dale a <strong>“Crear tienda”</strong> para agregar la primera.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th class="text-center">Activo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.Nombre</td>
                                <td>@t.Direccion</td>
                                <td>@t.Telefono</td>
                                <td class="text-center">
                                    @if (t.Activo)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
}
