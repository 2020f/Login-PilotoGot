@model List<Login.Domain.Entities.Tienda>
@{
    ViewData["Title"] = "Red de Tiendas";
    Layout = "_LayoutGestor";
}

@if (ViewBag.Ok != null)
{
    <div class="alert alert-success">@ViewBag.Ok</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="d-flex align-items-start justify-content-between mb-3">
    <div>
        <div class="h4 fw-bold mb-1">Tiendas Asociadas</div>
        <div class="text-secondary fw-semibold">Puntos de recolección registrados.</div>
    </div>

    <a class="btn btn-link fw-bold text-decoration-none" asp-action="CrearTienda">
        <i class="bi bi-shop me-2"></i> Nueva Tienda
    </a>
</div>

<div class="pg-card p-0">
    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead>
                <tr>
                    <th style="width:120px;">ID</th>
                    <th>Nombre Tienda</th>
                    <th>Ubicación</th>
                    <th style="width:180px;">Teléfono</th>
                    <th style="width:200px;">Encargado</th>
                    <th style="width:160px; text-align:right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary fw-bold p-4">
                            No hay tiendas creadas todavía.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td class="text-secondary fw-bold">#@t.Id</td>
                            <td class="fw-bold">@t.Nombre</td>
                            <td>@t.Direccion</td>
                            <td>@t.Telefono</td>
                            <td class="text-secondary">—</td>
                            <td style="text-align:right;">
                                <a class="pg-action-ico" asp-action="EditarTienda" asp-route-id="@t.Id" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (t.Activo)
                                {
                                    <form method="post" asp-action="DesactivarTienda" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="pg-action-ico danger" title="Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
