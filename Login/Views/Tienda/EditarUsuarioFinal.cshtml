@model Login.ViewModels.Tienda.UsuarioFinalEditVm
@{
    Layout = "_LayoutTienda";
    ViewData["Title"] = "Editar Destinatario";
    ViewData["PageTitle"] = "Editar Destinatario";
}

<div class="tp-page">
    <div class="tp-scroll">
        <div class="tp-form-page">
            <div class="tp-form-center">

                @if (!string.IsNullOrWhiteSpace(ViewBag.Ok as string))
                {
                    <div class="tp-alert tp-alert-ok">
                        <span class="tp-alert-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                        <div>@ViewBag.Ok</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
                {
                    <div class="tp-alert tp-alert-bad">
                        <span class="tp-alert-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
                        <div>@ViewBag.Error</div>
                    </div>
                }

                <div class="tp-card tp-card-pad">
                    <div class="tp-card-head">
                        <div class="tp-card-title">Editar destinatario</div>
                        <div class="tp-card-sub">Actualiza los datos del cliente final.</div>
                    </div>

                    <form method="post" asp-action="EditarUsuarioFinal">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="tp-grid-2">
                            <div class="tp-field">
                                <label class="tp-label">Nombre completo</label>
                                <input class="tp-input" asp-for="Nombre" />
                                <span class="tp-val" asp-validation-for="Nombre"></span>
                            </div>
                            <div class="tp-field">
                                <label class="tp-label">Teléfono</label>
                                <input class="tp-input" asp-for="Telefono" />
                                <span class="tp-val" asp-validation-for="Telefono"></span>
                            </div>
                        </div>

                        <div class="tp-field">
                            <label class="tp-label">Dirección / Ubicación</label>
                            <input class="tp-input" asp-for="DireccionUbicacion" />
                            <span class="tp-val" asp-validation-for="DireccionUbicacion"></span>
                        </div>

                        <div class="tp-field">
                            <label class="tp-label">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:inline;vertical-align:middle;margin-right:3px;">
                                    <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v16M3 10h5M3 14h5"/>
                                </svg>
                                Ubicación exacta (Google Maps)
                            </label>
                            <input class="tp-input" asp-for="MapaLink"
                                   placeholder="https://maps.google.com/maps?q=18.4812053,-69.9743033&z=17&hl=es" />
                            <span class="tp-val" asp-validation-for="MapaLink"></span>
                        </div>

                        <div class="tp-field">
                            <label class="tp-label">Notas (opcional)</label>
                            <textarea class="tp-textarea" asp-for="Notas" rows="3"></textarea>
                        </div>

                        <div class="tp-field">
                            <label class="tp-label">Estado</label>
                            <select class="tp-select" asp-for="Activo">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>

                        <div class="tp-form-actions">
                            <button class="tp-btn tp-btn-primary" type="submit">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                                Guardar
                            </button>
                            <a class="tp-btn tp-btn-ghost" asp-action="UsuariosFinales">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
