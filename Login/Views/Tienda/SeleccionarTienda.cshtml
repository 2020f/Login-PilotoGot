@model Login.ViewModels.Tienda.SeleccionarTiendaVm
@{
    ViewData["Title"] = "Seleccionar Tienda";
    Layout = "_LayoutTienda";


}

<div class="container d-flex justify-content-center align-items-center" style="min-height:80vh;">
    <div class="card shadow-sm border-0" style="max-width:520px; width:100%;">
        <div class="card-body text-center p-4">

            <div class="mb-3">
                <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size:48px;"></i>
            </div>

            <h4 class="fw-bold mb-2">Acceso no disponible</h4>

            <p class="text-muted mb-3">
                Esta cuenta o tienda se encuentra <strong>inactiva</strong> en este momento.
            </p>

            <p class="text-muted mb-4" style="font-size:15px;">
                Para continuar utilizando la plataforma, por favor comunícate con tu proveedor
                de servicio o con el administrador responsable de tu cuenta.
            </p>

            <div class="d-grid gap-2">
                <a href="mailto:soporte@tuprovedor.com" class="btn btn-primary">
                    Contactar soporte
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-secondary">
                    Volver al inicio de sesión
                </a>
            </div>

            <hr class="my-4">

            <small class="text-muted">
                Si crees que esto es un error, verifica tu estado con el proveedor del servicio.
            </small>
        </div>
    </div>
</div>