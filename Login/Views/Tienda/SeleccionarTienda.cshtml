@model Login.ViewModels.Tienda.SeleccionarTiendaVm
@{
    ViewData["Title"] = "Seleccionar tienda";
    ViewData["PageTitle"] = "Seleccionar tienda";
    Layout = "_LayoutTienda";
}
<div class="tp-page tp-form-page">
    <section class="tp-card tp-card-pad tp-form-center">
        @if (!string.IsNullOrWhiteSpace(Model.Ok)) { <div class="tp-alert tp-alert-ok" role="status">@Model.Ok</div> }
        @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="tp-alert tp-alert-bad" role="alert">@Model.Error</div> }
        @if (Model.Tiendas.Count > 0)
        {
            <h1 class="tp-card-title">Seleccionar tienda</h1>
            <p class="tp-card-sub">Elige el comercio con el que deseas trabajar.</p>
            <form asp-action="SeleccionarTienda" method="post">
                <div class="tp-field">
                    <label for="tiendaId" class="tp-label">Tienda activa</label>
                    <select id="tiendaId" name="tiendaId" class="tp-select" required>
                        <option value="">Selecciona una tienda</option>
                        @foreach (var tienda in Model.Tiendas) { <option value="@tienda.Value">@tienda.Text</option> }
                    </select>
                </div>
                <div class="tp-form-foot"><button type="submit" class="tp-btn tp-btn-primary">Continuar</button></div>
            </form>
        }
        else
        {
            <h1 class="tp-card-title">Acceso no disponible</h1>
            <p class="tp-card-sub">No tienes tiendas activas disponibles. Comunícate con el administrador responsable de tu cuenta para revisar el acceso.</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="tp-btn tp-btn-outline">Volver al inicio de sesión</a>
        }
    </section>
</div>
