@model Login.ViewModels.Tienda.UsuarioFinalDeleteVm
@{
    Layout = "_LayoutTienda";
    ViewData["Title"] = "Eliminar Usuario";
    ViewData["PageTitle"] = "Eliminar Usuario";
}

<div class="tp-page">

    <div class="tp-card tp-card-pad tp-danger-card">
        <div class="tp-h2">¿Eliminar usuario final?</div>
        <div class="tp-sub">Esto NO se puede deshacer. Si tiene órdenes, el sistema no lo dejará borrar.</div>

        <div class="tp-divider"></div>

        <div class="tp-kv">
            <div><b>Nombre:</b> @Model.Nombre</div>
            <div><b>Teléfono:</b> @Model.Telefono</div>
            <div><b>Dirección:</b> @Model.DireccionUbicacion</div>
        </div>

        <div class="tp-form-actions">
            <form method="post" asp-action="EliminarUsuarioFinalConfirmado" style="margin:0;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="tp-btn tp-btn-danger" type="submit">Sí, eliminar</button>
            </form>

            <a class="tp-btn tp-btn-ghost" asp-action="UsuariosFinales">Cancelar</a>
        </div>
    </div>

</div>
