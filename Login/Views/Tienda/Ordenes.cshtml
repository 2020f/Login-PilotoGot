@model Login.ViewModels.Tienda.OrdenesTiendaVm
@{
    Layout = "_LayoutTienda";
    ViewData["Title"] = "Vista General";
    ViewData["PageTitle"] = "Vista General";

    var ordenes = Model?.Ordenes ?? new List<Login.ViewModels.Tienda.OrdenTiendaRowVm>();

    int total = ordenes.Count;

    int enProceso = ordenes.Count(x =>
        (x.Estado ?? "").ToLower().Contains("recolect") ||
        (x.Estado ?? "").ToLower().Contains("proceso"));

    int enRuta = ordenes.Count(x =>
        (x.Estado ?? "").ToLower().Contains("ruta"));

    int entregadosHoy = ordenes.Count(x =>
        (x.Estado ?? "").ToLower().Contains("entreg") &&
        x.CreatedAt.Date == DateTime.UtcNow.Date
    );
}

<div class="tp-page">

    <!-- ✅ ZONA FIJA (NO SCROLL) -->
    <div class="tp-sticky">

        @if (ViewBag.Ok != null)
        {
            <div class="tp-alert tp-alert-ok">
                <span class="tp-alert-icon">✅</span>
                <div>@ViewBag.Ok</div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="tp-alert tp-alert-bad">
                <span class="tp-alert-icon">⚠️</span>
                <div>@ViewBag.Error</div>
            </div>
        }

        <div class="tp-cards">
            <div class="tp-card tp-card-stat">
                <div class="tp-card-stat-head">
                    <div class="tp-card-stat-title">EN PROCESO / RECOLECTANDO</div>
                    <div class="tp-chip tp-chip-warn">⏳</div>
                </div>
                <div class="tp-card-stat-value">@enProceso</div>
            </div>

            <div class="tp-card tp-card-stat">
                <div class="tp-card-stat-head">
                    <div class="tp-card-stat-title">EN RUTA</div>
                    <div class="tp-chip tp-chip-blue">🛵</div>
                </div>
                <div class="tp-card-stat-value">@enRuta</div>
            </div>

            <div class="tp-card tp-card-stat">
                <div class="tp-card-stat-head">
                    <div class="tp-card-stat-title">ENTREGADOS HOY</div>
                    <div class="tp-chip tp-chip-ok">✔</div>
                </div>
                <div class="tp-card-stat-value">@entregadosHoy</div>
            </div>
        </div>

        <div class="tp-section-head">
            <div>
                <h2 class="tp-h2">Envíos Activos</h2>
                <div class="tp-sub">Seguimiento por orden (A) y estado: Recolectando → En ruta → Entregado.</div>
            </div>

            <div class="tp-actions">
                <a class="tp-btn tp-btn-ghost" asp-action="CrearOrden">＋ Nueva Orden</a>
                <a class="tp-link" asp-action="Ordenes">Ver todos</a>
            </div>
        </div>

    </div>

    <!-- ✅ SOLO AQUÍ SE SCROLLEA -->
    <div class="tp-scroll">
        <div class="tp-list">
            @if (!ordenes.Any())
            {
                <div class="tp-empty">
                    <div class="tp-empty-title">No hay envíos todavía.</div>
                    <div class="tp-empty-sub">Crea una orden y aquí verás el seguimiento.</div>
                    <a class="tp-btn tp-btn-primary" asp-action="CrearOrden">Crear primera orden</a>
                </div>
            }
            else
            {
                foreach (var o in ordenes)
                {
                    var estado = (o.Estado ?? "").Trim();
                    var s = estado.ToLower();

                    var pillClass = "tp-pill tp-pill-gray";
                    var leftBarClass = "tp-leftbar tp-leftbar-gray";
                    var pillText = estado;

                    if (s.Contains("recolect") || s.Contains("proceso"))
                    {
                        pillClass = "tp-pill tp-pill-warn";
                        leftBarClass = "tp-leftbar tp-leftbar-warn";
                        pillText = "Recolectando / En espera";
                    }
                    else if (s.Contains("ruta"))
                    {
                        pillClass = "tp-pill tp-pill-blue";
                        leftBarClass = "tp-leftbar tp-leftbar-blue";
                        pillText = "En ruta";
                    }
                    else if (s.Contains("entreg"))
                    {
                        pillClass = "tp-pill tp-pill-ok";
                        leftBarClass = "tp-leftbar tp-leftbar-ok";
                        pillText = "Entregado";
                    }

                    <div class="tp-card tp-card-order">
                        <div class="@leftBarClass"></div>

                        <div class="tp-order-body">
                            <div class="tp-order-top">
                                <div class="tp-order-meta">
                                    <div class="tp-order-code">#ORD-@o.NumeroOrdenA</div>
                                    <span class="@pillClass">@pillText</span>
                                </div>

                                <div class="tp-order-time">
                                    @o.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                </div>
                            </div>

                            <div class="tp-order-title">@o.UsuarioFinal</div>

                            <div class="tp-order-sub">
                                Creada: @o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy hh:mm tt")
                            </div>

                            @if (o.EstadoNum >= 2)
                            {
                                var pct = o.EstadoNum >= 4 ? 100
                                        : o.EstadoNum >= 3 ? 67
                                        : 33;

                                <div class="tp-tracking">
                                    <div class="tp-tracking-bar-wrap">
                                        <div class="tp-tracking-bar-fill" style="width:@(pct)%"></div>
                                    </div>
                                    <div class="tp-tracking-steps">
                                        <div class="tp-tracking-step @(o.EstadoNum >= 2 ? "tp-step-done" : "tp-step-pending")">
                                            <span class="tp-step-icon">🛵</span>
                                            <span class="tp-step-label">Asignado</span>
                                            <span class="tp-step-time">@(o.AssignedAt.HasValue ? o.AssignedAt.Value.ToLocalTime().ToString("hh:mm tt") : "—")</span>
                                        </div>
                                        <div class="tp-tracking-step @(o.EstadoNum >= 3 ? "tp-step-done" : "tp-step-pending")">
                                            <span class="tp-step-icon">📦</span>
                                            <span class="tp-step-label">Recogido</span>
                                            <span class="tp-step-time">@(o.RecolectadaAt.HasValue ? o.RecolectadaAt.Value.ToLocalTime().ToString("hh:mm tt") : "—")</span>
                                        </div>
                                        <div class="tp-tracking-step @(o.EstadoNum >= 4 ? "tp-step-done" : "tp-step-pending")">
                                            <span class="tp-step-icon">✅</span>
                                            <span class="tp-step-label">Entregado</span>
                                            <span class="tp-step-time">@(o.EntregadaAt.HasValue ? o.EntregadaAt.Value.ToLocalTime().ToString("hh:mm tt") : "—")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="tp-order-actions">
                            <a href="javascript:void(0)" data-open-qr data-orden-id="@o.OrdenId">
                                Ver QR y Códigos →
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .tp-tracking {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .tp-tracking-bar-wrap {
        background: #374151;
        border-radius: 4px;
        height: 5px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .tp-tracking-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        border-radius: 4px;
        transition: width .4s ease;
    }

    .tp-tracking-steps {
        display: flex;
        justify-content: space-between;
    }

    .tp-tracking-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        flex: 1;
    }

    .tp-step-icon {
        font-size: 13px;
    }

    .tp-step-label {
        font-size: 8px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .tp-step-time {
        font-size: 8px;
    }

    .tp-step-done .tp-step-label,
    .tp-step-done .tp-step-time {
        color: #60a5fa;
    }

    .tp-step-pending {
        opacity: .38;
    }

    .tp-step-pending .tp-step-label,
    .tp-step-pending .tp-step-time {
        color: #9ca3af;
    }
</style>

<div id="tpModalHost"></div>
