@model Login.ViewModels.Tienda.UsuariosFinalesIndexVm
@{
    Layout = "_LayoutTienda";
    ViewData["Title"] = "Destinatarios";
    ViewData["PageTitle"] = "Destinatarios";
}

<div class="tp-page">
    <div class="tp-sticky">

        @if (!string.IsNullOrWhiteSpace(Model.Ok))
        {
            <div class="tp-alert tp-alert-ok">
                <span class="tp-alert-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg></span>
                <div>@Model.Ok</div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="tp-alert tp-alert-bad">
                <span class="tp-alert-ico"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></span>
                <div>@Model.Error</div>
            </div>
        }

        <div class="tp-toolbar">
            <div class="tp-search">
                <span class="tp-search-ico">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </span>
                <input id="tpSearch" class="tp-input tp-input-search" placeholder="Buscar por nombre, teléfono o dirección..." />
            </div>
            <button class="tp-btn tp-btn-primary" type="button" data-tp-open="#tpModalUsuarioFinal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Nuevo
            </button>
        </div>
    </div>

    <div class="tp-scroll">
        @if (!Model.Usuarios.Any())
        {
            <div class="tp-empty">
                <div class="tp-empty-ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                        <circle cx="9" cy="7" r="4"/><path d="M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                </div>
                <div class="tp-empty-title">Sin destinatarios</div>
                <div class="tp-empty-sub">Agrega el primero para poder crear órdenes.</div>
                <button class="tp-btn tp-btn-primary" type="button" data-tp-open="#tpModalUsuarioFinal">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                    Agregar destinatario
                </button>
            </div>
        }
        else
        {
            <div class="tp-grid-3" id="tpGrid">
                @foreach (var u in Model.Usuarios)
                {
                    var parts = (u.Nombre ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                    var ini = parts.Length == 1
                        ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper()
                        : $"{parts[0][0]}{parts[^1][0]}".ToUpper();

                    <div class="tp-ucard"
                         data-search="@($"{u.Nombre} {u.Telefono} {u.DireccionUbicacion}".ToLower())">

                        <div class="tp-ucard-top">
                            <div>
                                <div class="tp-ucard-name">@u.Nombre</div>
                                <div class="tp-ucard-phone">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.27 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.6a16 16 0 0 0 6.46 6.46l.96-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                    </svg>
                                    @u.Telefono
                                </div>
                            </div>
                            <div class="tp-ucard-initials">@ini</div>
                        </div>

                        <div class="tp-ucard-loc">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                            @u.DireccionUbicacion
                        </div>

                        @if (!string.IsNullOrWhiteSpace(u.MapaLink))
                        {
                            <a class="tp-ucard-map" href="@u.MapaLink" target="_blank" rel="noopener">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                    <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 4v16M3 10h5M3 14h5"/>
                                </svg>
                                Ver en Google Maps
                            </a>
                        }

                        <div class="tp-ucard-actions">
                            <a class="tp-btn tp-btn-outline tp-btn-sm" asp-action="EditarUsuarioFinal" asp-route-id="@u.Id">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                                Editar
                            </a>
                            <a class="tp-btn tp-btn-danger tp-btn-sm" asp-action="EliminarUsuarioFinal" asp-route-id="@u.Id">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/>
                                </svg>
                                Eliminar
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_ModalUsuarioFinalCreate", new Login.ViewModels.Tienda.UsuarioFinalCreateVm())
