@model Login.ViewModels.Tienda.UsuariosFinalesIndexVm
@{
    Layout = "_LayoutTienda";
    ViewData["Title"] = "Usuarios Finales";
    ViewData["PageTitle"] = "Gestión de Usuarios Finales";
}

<div class="tp-page">

    @if (!string.IsNullOrWhiteSpace(Model.Ok))
    {
        <div class="tp-alert tp-alert-ok">
            <span class="tp-alert-icon">✅</span>
            <div>@Model.Ok</div>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="tp-alert tp-alert-bad">
            <span class="tp-alert-icon">⚠️</span>
            <div>@Model.Error</div>
        </div>
    }

    <div class="tp-toolbar">
        <div class="tp-search">
            <span class="tp-search-ico">🔎</span>
            <input id="tpUsuariosSearch" class="tp-input tp-input-search"
                   placeholder="Buscar usuario por nombre o teléfono..." />
        </div>

        <button class="tp-btn tp-btn-dark" type="button" data-tp-open="#tpModalUsuarioFinal">
            👤➕ Nuevo Usuario
        </button>
    </div>

    <div class="tp-grid tp-grid-3" id="tpUsuariosGrid">
        @foreach (var u in Model.Usuarios)
        {
            <div class="tp-card tp-card-user"
                 data-search="@($"{u.Nombre} {u.Telefono} {u.DireccionUbicacion}".ToLower())">

                <div class="tp-user-top">
                    <div>
                        <div class="tp-user-name">@u.Nombre</div>
                        <div class="tp-user-phone">📞 @u.Telefono</div>
                    </div>
                    <div class="tp-user-avatar"></div>
                </div>

                <div class="tp-user-loc">
                    📍 <span>@u.DireccionUbicacion</span>
                </div>

                <div class="tp-user-actions">
                    <a class="tp-btn tp-btn-ghost" asp-action="EditarUsuarioFinal" asp-route-id="@u.Id">Editar</a>
                    <a class="tp-btn tp-btn-danger" asp-action="EliminarUsuarioFinal" asp-route-id="@u.Id">Eliminar</a>
                </div>
            </div>
        }
    </div>

</div>

@await Html.PartialAsync("_ModalUsuarioFinalCreate", new Login.ViewModels.Tienda.UsuarioFinalCreateVm())

@section Scripts {
    <script src="~/js/tienda.js" asp-append-version="true"></script>
}
