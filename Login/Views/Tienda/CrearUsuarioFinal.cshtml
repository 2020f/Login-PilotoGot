@model Login.ViewModels.Tienda.UsuarioFinalCreateVm
@{
    ViewData["Title"] = "Crear Usuario Final";
}

<h2>Crear Usuario Final</h2>

<form method="post" asp-action="CrearUsuarioFinal" class="row g-2">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="TiendaId" />

    <div class="col-md-6">
        <label class="form-label">Nombre</label>
        <input class="form-control" asp-for="Nombre" />
        <span class="text-danger" asp-validation-for="Nombre"></span>
    </div>

    <div class="col-md-6">
        <label class="form-label">Teléfono</label>
        <input class="form-control" asp-for="Telefono" />
        <span class="text-danger" asp-validation-for="Telefono"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Dirección / Ubicación</label>
        <input class="form-control" asp-for="DireccionUbicacion" />
        <span class="text-danger" asp-validation-for="DireccionUbicacion"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Notas</label>
        <textarea class="form-control" asp-for="Notas" rows="3"></textarea>
        <span class="text-danger" asp-validation-for="Notas"></span>
    </div>

    <div class="col-12 mt-2">
        <button class="btn btn-success">Guardar</button>
        <a class="btn btn-secondary" asp-action="UsuariosFinales" asp-route-tiendaId="@Model.TiendaId">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
