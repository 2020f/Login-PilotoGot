@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
    ViewData["AuthBrandHeader"] = false;
}

<link rel="stylesheet" href="~/css/auth-login.css" asp-append-version="true" />

<div class="crm-login">
    <header class="crm-login-header">
        <a href="~/" class="crm-login-brand" aria-label="Envirapido, inicio"><img src="~/branding/logo-original.png" asp-append-version="true" alt="Envirapido" width="222" height="76" /></a>
        <a href="~/" class="crm-login-home">Volver al inicio <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
    </header>
<div class="auth-shell">
    <aside class="auth-side" aria-labelledby="crm-login-heading">
        <div class="auth-hero">
            <span class="crm-login-eyebrow">CONECTA TU OPERACIÓN</span>
            <h1 id="crm-login-heading" class="auth-hero-title">Cada entrega,<br />más simple.</h1>
            <p class="auth-hero-text">Organiza tus rutas y acompaña cada pedido hasta su destino.</p>
            <div class="crm-login-features">
                <span><i class="bi bi-signpost-split" aria-hidden="true"></i> Rutas conectadas</span>
                <span><i class="bi bi-geo-alt" aria-hidden="true"></i> Seguimiento en vivo</span>
            </div>
        </div>
        <div class="crm-login-scene">
            <img src="~/branding/ultima-milla-ciudad.png" asp-append-version="true" alt="Comercio, piloto y destinos conectados por una ruta de entrega" width="1536" height="1024" fetchpriority="high" />
        </div>
        <div class="crm-login-operation"><i class="bi bi-box-seam" aria-hidden="true"></i><span>Comercios, operación y pilotos. Un mismo camino.</span></div>
    </aside>

    <main class="auth-main">
        <section class="auth-card" aria-labelledby="crm-login-title">
            <div class="auth-card-head">
                <img class="crm-login-symbol" src="~/branding/simbolo-caja.png" asp-append-version="true" alt="" width="68" height="68" />
                <div class="auth-kicker">Bienvenido</div>
                <h2 id="crm-login-title" class="auth-title">Inicia sesión</h2>
                <p class="auth-sub">Accede a tu centro de operaciones.</p>
            </div>

            <form id="account" method="post" class="auth-form">

                <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label">Correo electrónico</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="tu@empresa.com" />
                    </div>
                    <span asp-validation-for="Input.Email" class="auth-val"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Input.Password" class="auth-label">Contraseña</label>
                    <div class="auth-input-wrap">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="••••••••" />
                        <button type="button" class="auth-eye" data-auth-toggle aria-label="Mostrar contraseña" aria-pressed="false">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Input.Password" class="auth-val"></span>
                </div>

                <div class="auth-row">
                    <label class="auth-check">
                        <input class="auth-check-input" asp-for="Input.RememberMe" />
                        <span class="auth-check-text">@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                    </label>

                    <a id="forgot-password" class="auth-link" asp-page="./ForgotPassword">
                        ¿Olvidaste tu contraseña?
                    </a>
                </div>

                <button id="login-submit" type="submit" class="auth-btn">
                    Entrar
                    <i class="bi bi-arrow-right"></i>
                </button>

            </form>
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="auth-divider"><span>o continúa con</span></div>
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="auth-ext">
                        <div class="auth-ext-title">Continuar con</div>

                        <div class="auth-ext-grid">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="auth-ext-btn"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Iniciar sesión con @provider.DisplayName">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    </form>
                }

                <div class="auth-foot">
                    <span>¿Aún no tienes una cuenta?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="auth-link">
                        Crear cuenta
                    </a>
                </div>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-link crm-login-resend">Reenviar confirmación</a>
        </section>
        <div class="crm-login-secure"><i class="bi bi-shield-check" aria-hidden="true"></i> Acceso seguro a tu operación</div>
    </main>
</div>
    <footer class="crm-login-footer"><span>© @DateTime.Now.Year Envirapido</span><span>Tu operación, siempre conectada.</span></footer>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Toggle password view (sin librerías)
        (function () {
            const btn = document.querySelector("[data-auth-toggle]");
            if (!btn) return;

            btn.addEventListener("click", function () {
                const wrap = btn.closest(".auth-input-wrap");
                const input = wrap.querySelector("input");
                const icon = btn.querySelector("i");
                if (!input) return;

                const isPass = input.type === "password";
                input.type = isPass ? "text" : "password";
                icon.className = isPass ? "bi bi-eye-slash" : "bi bi-eye";
                btn.setAttribute("aria-label", isPass ? "Ocultar contraseña" : "Mostrar contraseña");
                btn.setAttribute("aria-pressed", String(isPass));
            });
        })();
    </script>
}
