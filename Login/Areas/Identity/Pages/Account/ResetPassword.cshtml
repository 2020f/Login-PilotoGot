@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Crear nueva contraseña";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<main class="auth-main"><section class="auth-card">
    <div class="auth-card-head"><div class="auth-kicker">Envirapido</div><h1 class="auth-title">Crear nueva contraseña</h1></div>
    @if (Model.InvalidLink) { <p class="auth-alert" role="alert">@ResetPasswordModel.InvalidLinkMessage</p> }
    else
    {
        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />
            <div class="auth-field"><label asp-for="Input.Email" class="auth-label">Correo de la cuenta</label><input asp-for="Input.Email" class="auth-input" autocomplete="username" /><span asp-validation-for="Input.Email" class="auth-val"></span></div>
            <div class="auth-field"><label asp-for="Input.Password" class="auth-label">Nueva contraseña</label><input asp-for="Input.Password" class="auth-input" autocomplete="new-password" /><span asp-validation-for="Input.Password" class="auth-val"></span></div>
            <div class="auth-field"><label asp-for="Input.ConfirmPassword" class="auth-label">Repetir contraseña</label><input asp-for="Input.ConfirmPassword" class="auth-input" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="auth-val"></span></div>
            <button type="submit" class="auth-btn">Guardar contraseña</button>
        </form>
    }
    <p><a class="auth-link" asp-page="./ForgotPassword">Solicitar otro enlace</a></p>
    <a class="auth-link" asp-page="./Login">Volver a iniciar sesión</a>
</section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
