@model Login.Areas.Identity.Pages.Account.DeniedPageModel
<main class="access-denied-shell">
    <section class="access-denied-card" aria-labelledby="accessDeniedTitle">
        <span class="access-denied-brand"><img class="envi-brand-logo" src="~/branding/logo-original.png" asp-append-version="true" alt="Envirapido" width="190" height="65" /></span>
        <span class="access-denied-icon" aria-hidden="true">!</span>
        <p class="access-denied-code">Acceso restringido · 403</p>
        <h1 id="accessDeniedTitle">No tienes autorización</h1>
        <p>Tu cuenta no tiene permiso para entrar a esta sección. Puedes volver a tu panel o contactar al administrador de tu empresa.</p>
        <div class="access-denied-actions">
            <a class="access-denied-primary" href="@Model.HomePath">@(Model.SignedIn ? "Volver a mi panel" : "Iniciar sesión")</a>
            @if (Model.SignedIn)
            {
                <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                    <button type="submit">Cerrar sesión</button>
                </form>
            }
        </div>
    </section>
</main>
<style>
    .access-denied-shell{min-height:100dvh;display:grid;place-items:center;padding:24px;background:radial-gradient(ellipse at top left,#d9f4ef,#f4f7fb 65%);color:#14252b}
    .access-denied-card{background:#fff;border:1px solid #dbe5e9;border-radius:22px;padding:clamp(24px,5vw,48px);max-width:570px;box-shadow:0 18px 55px #14252b12}
    .access-denied-brand{display:block;color:#007e80;font-size:20px;font-weight:800;margin-bottom:32px}
    .access-denied-icon{display:grid;place-items:center;width:56px;height:56px;background:#fff1d6;border-radius:18px;font-size:32px;font-weight:800;color:#b96c00}
    .access-denied-code{font-size:13px;font-weight:650;color:#60747e;margin:24px 0 8px}
    .access-denied-card h1{font-size:clamp(26px,5vw,34px);line-height:1.15;margin:0 0 16px;letter-spacing:-.5px}
    .access-denied-card p:not(.access-denied-code){color:#526874;line-height:1.65;font-size:15px}
    .access-denied-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;align-items:center}
    .access-denied-actions a,.access-denied-actions button{border:1px solid #cbd9df;padding:12px 18px;border-radius:10px;font:inherit;font-size:14px;font-weight:700;text-decoration:none;cursor:pointer;background:#fff;color:#29444f}
    .access-denied-actions .access-denied-primary{background:#007e80;border-color:#007e80;color:#fff}
    .access-denied-actions form{margin:0}
    .access-denied-actions a:focus-visible,.access-denied-actions button:focus-visible{outline:3px solid #19c9c0;outline-offset:3px}
</style>
