@page
@{
    ViewData["Title"] = "Contraseña actualizada";
    Response.Headers.CacheControl = "no-store";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<main class="auth-main"><section class="auth-card">
    <div class="auth-kicker">Envirapido</div><h1 class="auth-title">Contraseña actualizada</h1>
    <p>Inicia sesión con tu nueva contraseña. Tus permisos y comercios autorizados se conservan.</p>
    <a class="auth-link" asp-page="./Login">Iniciar sesión</a>
</section></main>
