@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar contraseña";
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<main class="auth-main"><section class="auth-card">
    <div class="auth-card-head"><div class="auth-kicker">Envirapido</div><h1 class="auth-title">Recuperar contraseña</h1><p class="auth-sub">El titular del correo puede recuperar su acceso sin cambiar sus permisos ni pertenencias.</p></div>
    @if (!Model.DeliveryAvailable) { <p class="auth-alert" role="status">@ForgotPasswordModel.UnavailableMessage</p> }
    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-alert" role="alert"></div>
        <div class="auth-field"><label asp-for="Input.Email" class="auth-label">Correo de la cuenta</label><input asp-for="Input.Email" class="auth-input" autocomplete="username" /><span asp-validation-for="Input.Email" class="auth-val"></span></div>
        <button class="auth-btn" type="submit" disabled="@(!Model.DeliveryAvailable)">Solicitar enlace</button>
    </form>
    <p><a class="auth-link" asp-page="./Login">Volver a iniciar sesión</a></p>
</section></main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
