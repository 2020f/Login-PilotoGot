# Server-side service origin; never expose internal keys as NEXT_PUBLIC values.
PORTAL_API_ORIGIN=http://127.0.0.1:5031

# Leave empty for local QA. Production links use these separate public origins.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_PORTAL_ORIGIN=
# Production examples:
# NEXT_PUBLIC_SITE_ORIGIN=https://envirapido.com
# NEXT_PUBLIC_PORTAL_ORIGIN=https://portal.envirapido.com
