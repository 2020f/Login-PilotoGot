# Añadir al entorno PRIVADO del CRM existente; conservar todo lo demás.
PortalIntegration__Enabled=true
PortalIntegration__AdminBaseUrl=http://127.0.0.1:5031
PortalIntegration__AdminKey=MISMO_SECRETO_ADMIN_DEL_SERVICIO_PORTAL
PortalIntegration__CatalogReadKey=MISMO_SECRETO_CATALOGO_DEL_SERVICIO_PORTAL
PortalIntegration__CatalogCurrency=DOP
PortalIntegration__MaxUploadBytes=125829120
# Conservar TODOS los hosts públicos e internos existentes; añadir loopback para
# la lectura privada del catálogo. Esta lista corresponde a los dominios conocidos.
AllowedHosts=envirapido.com;www.envirapido.com;pilotogoapp.zapflow77.dpdns.org;127.0.0.1;localhost
# Loopback privado es válido para la comunicación administrativa de servidor.
# No agregar claves al frontend, HTML, JSON público o NEXT_PUBLIC_*.
