# Plantilla privada para Envirapido.Portal.Api; NO ejecutar con source.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5031
AllowedHosts=portal.envirapido.com;localhost;127.0.0.1
ConnectionStrings__PortalConnection=Server=SQL_PRIVADO;Database=EnvirapidoPortal;User Id=PRINCIPAL_PORTAL;Password=SECRETO_SQL;Encrypt=True;TrustServerCertificate=False
Portal__AdminKey=REEMPLAZAR_CON_SECRETO_ALEATORIO_ADMIN
Portal__CatalogKey=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO_CATALOGO
Portal__CatalogUrl=http://127.0.0.1:5000/api/internal/portal/catalog
# HTTP sólo loopback privado; si CRM está en otro equipo, usar HTTPS validado.
Portal__PublicBaseUrl=https://portal.envirapido.com
Portal__DataProtectionDirectory=/var/lib/envirapido-portal/keys
Portal__Mail__Enabled=true
Portal__Mail__Host=SMTP_PRIVADO
Portal__Mail__Port=587
Portal__Mail__UseSsl=true
Portal__Mail__UserName=CUENTA_SMTP
Portal__Mail__Password=SECRETO_SMTP
Portal__Mail__FromAddress=REMITENTE_VERIFICADO
Portal__Mail__FromName=Envirapido
PortalArtifacts__StoragePath=/var/lib/envirapido-portal/apk
PortalArtifacts__MinimumVersionCode=9
PortalArtifacts__JavaPath=/usr/bin/java
PortalArtifacts__ApkSignerJarPath=/opt/android/build-tools/lib/apksigner.jar
PortalArtifacts__Aapt2Path=/opt/android/build-tools/aapt2
# Proxy inmediato exacto; adaptar sólo si la topología lo requiere.
ReverseProxy__KnownProxies__0=127.0.0.1
